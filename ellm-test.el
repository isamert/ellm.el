(ert-deftest ellm-test-llm-tool-turns-preserve-provider-call-ids ()
  "Persist provider IDs and pair out-of-order tool results by their IDs."
  (let* ((use-a (make-llm-provider-utils-tool-use
                 :id "toolu_provider_a" :name "First"
                 :args '((value . "a"))))
         (use-b (make-llm-provider-utils-tool-use
                 :id "toolu_provider_b" :name "Second"
                 :args '((value . "b"))))
         (result-b (make-llm-chat-prompt-tool-result
                    :call-id "toolu_provider_b" :tool-name "Second"
                    :result "result-b"))
         (result-a (make-llm-chat-prompt-tool-result
                    :call-id "toolu_provider_a" :tool-name "First"
                    :result "result-a"))
         (prompt
          (make-llm-chat-prompt
           :interactions
           (list (make-llm-chat-prompt-interaction
                  :role 'user :content "Run both."))))
         (previous-interaction
          (car (llm-chat-prompt-interactions prompt))))
    ;; Some provider serializers prepend a system interaction while preparing
    ;; the request; the previous tail object remains the stable boundary.
    (push (make-llm-chat-prompt-interaction
           :role 'system :content "Provider-added system prompt.")
          (llm-chat-prompt-interactions prompt))
    (llm-provider-utils-append-to-prompt
     prompt (list use-a use-b) nil nil 'assistant)
    (llm-provider-utils-append-to-prompt
     prompt nil (list result-b result-a))
    (let ((ids (ellm-llm--new-prompt-tool-call-ids
                prompt previous-interaction))
          (ellm-fold-tool-calls nil))
      (should (equal ids
                     '(("toolu_provider_a" "toolu_provider_b")
                       "toolu_provider_b" "toolu_provider_a")))
      (with-temp-buffer
        (ellm-mode)
        (ellm-llm--render-tool-uses
         '((:name "First" :args ((value . "a")))
           (:name "Second" :args ((value . "b"))))
         '(("Second" . "result-b") ("First" . "result-a"))
         ids)
        (let* ((turns (ellm--parse-turns))
               (attrs (mapcar #'ellm-turn-attrs turns)))
          (should (equal (mapcar #'ellm-turn-role turns)
                         '("tool-call" "tool-param" "tool-call" "tool-param"
                           "tool-result" "tool-result")))
          (should (equal (mapcar (lambda (index)
                                   (alist-get "id" (nth index attrs)
                                              nil nil #'equal))
                                 '(0 2 4 5))
                         '("toolu_provider_a" "toolu_provider_b"
                           "toolu_provider_b" "toolu_provider_a")))
          (should (equal (mapcar #'ellm-turn-content
                                 (mapcar (lambda (index) (nth index turns))
                                         '(4 5)))
                         '("result-b" "result-a"))))))))


(ert-deftest ellm-test-llm-partial-tool-failures-use-prompt-results ()
  "Partial llm.el tool failures retain one correctly paired result per call."
  (let* ((use-a (make-llm-provider-utils-tool-use
                 :id "call_a" :name "First" :args nil))
         (use-b (make-llm-provider-utils-tool-use
                 :id "call_b" :name "Second" :args nil))
         (result-a (make-llm-chat-prompt-tool-result
                    :call-id "call_a" :tool-name "First" :result "success"))
         (result-b (make-llm-chat-prompt-tool-result
                    :call-id "call_b" :tool-name "Second"
                    :result "Error llm-tool-unknown-tool calling tool"))
         (prompt (make-llm-chat-prompt
                  :interactions
                  (list (make-llm-chat-prompt-interaction
                         :role 'user :content "Run both."))))
         (previous-interaction (car (llm-chat-prompt-interactions prompt))))
    ;; This is the state llm.el 0.32.0 leaves before its callback: successes
    ;; are returned in multi-output, while every call's result is in PROMPT.
    (llm-provider-utils-append-to-prompt
     prompt (list use-a use-b) nil nil 'assistant)
    ;; Tool callbacks may finish out of call order.  This exact order must be
    ;; preserved in the transcript so a later replay has the same cache key.
    (llm-provider-utils-append-to-prompt
     prompt nil (list result-b result-a))
    (let* ((recovery (ellm-llm--recover-tool-call-error
                      nil prompt previous-interaction
                      'llm-tool-unknown-tool "Unknown tool"))
           (results (nth 1 recovery))
           (turn-count (length (llm-chat-prompt-interactions prompt))))
      (should (= turn-count 3))
      (should (equal results
                     '(("Second" . "Error llm-tool-unknown-tool calling tool")
                       ("First" . "success"))))
      (with-temp-buffer
        (ellm-mode)
        (ellm-llm--render-tool-uses (nth 0 recovery) results (nth 2 recovery))
        (let ((turns (ellm--parse-turns)))
          (should (equal (mapcar #'ellm-turn-role turns)
                         '("tool-call" "tool-call" "tool-result" "tool-result")))
          (should (equal (mapcar #'ellm-turn-content (nthcdr 2 turns))
                         '("Error llm-tool-unknown-tool calling tool" "success")))
          (should (equal (mapcar (lambda (turn)
                                   (alist-get "id" (ellm-turn-attrs turn)
                                              nil nil #'equal))
                                 (nthcdr 2 turns))
                         '("call_b" "call_a"))))))))

