(ert-deftest ellm-test-raw-turn-bodies-disable-markdown-outline-headings ()
  "Markdown headings in raw turn bodies should not be outline headings."
  (let ((ellm-fold-tool-calls nil)
        (ellm-fold-reasoning-blocks nil))
    (with-temp-buffer
      (insert ">-| assistant\n"
              "# Assistant heading\n"
              ">>-| tool-result | Shell :id call_1\n"
              "# Raw tool heading\n"
              ">>-| reasoning\n"
              "# Raw reasoning heading\n"
              ">-| user\n"
              "# User heading\n")
      (ellm-mode)
      (let (headings)
        (goto-char (point-min))
        (while (ellm--outline-search-function nil nil nil)
          (push (buffer-substring-no-properties
                 (line-beginning-position) (line-end-position))
                headings)
          (forward-line 1))
        (setq headings (nreverse headings))
        (should (member "# Assistant heading" headings))
        (should (member "# User heading" headings))
        (should (member ">>-| tool-result | Shell :id call_1" headings))
        (should (member ">>-| reasoning" headings))
        (should-not (member "# Raw tool heading" headings))
        (should-not (member "# Raw reasoning heading" headings))))))

