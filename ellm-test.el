(ert-deftest ellm-test-turn-rule-overlays-survive-editing-and-narrowing ()
  "Rule overlays should stay unique around edits and narrowed fontification."
  (let ((ellm-pretty-separators nil))
    (with-temp-buffer
      (insert "Intro.\n"
              ">-| user\n"
              "Hello.\n"
              ">-| assistant\n"
              "Hi.\n")
      (ellm-mode)
      (font-lock-ensure)
      (should (= (length (ellm-test--rule-overlays)) 2))
      (goto-char (point-min))
      (search-forward "Hello")
      (insert "!")
      (font-lock-ensure)
      (should (= (length (ellm-test--rule-overlays)) 2))
      (should (ellm-test--rule-overlay-before-text ">-| assistant"))
      (save-restriction
        (goto-char (point-min))
        (search-forward ">-| assistant")
        (narrow-to-region (line-beginning-position) (point-max))
        (font-lock-ensure)
        (font-lock-ensure)
        ;; The rule belongs to the delimiter, so narrowing away the previous
        ;; turn does not take the rule with it.
        (should (ellm-test--rule-overlay-before-text ">-| assistant")))
      (font-lock-ensure)
      (should (= (length (ellm-test--rule-overlays)) 2))
      (should (ellm-test--rule-overlay-before-text ">-| user"))
      (should (ellm-test--rule-overlay-before-text ">-| assistant")))))

