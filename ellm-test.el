          (let* ((entries (ellm-acp--config-frontmatter-entries
                           (current-buffer)))
                 (ids (mapcar #'car entries))
                 (settings (ellm--config-settings provider (current-buffer)))
                 (auto (seq-find
                        (lambda (setting)
                          (equal (plist-get setting :path)
                                 '(acp config auto)))
                        settings)))
            (should-not (member "style" ids))
            (should-not (member "model" ids))
            (should (string-match-p
                     "current: false"
                     (ellm--config-choice-label
                      provider auto (ellm--parse-frontmatter))))))
