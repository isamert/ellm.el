(ert-deftest ellm-test-acp-delete-marked-turn-removes-children ()
  "Deleting a marked turn should remove nested child turns too."
  (with-temp-buffer
    (ellm-mode)
    (ellm--insert-turn "tool-call" :pipe-arg "Edit" :id "call_1")
    (ellm--insert-turn "tool-param" :pipe-arg "filePath")
    (insert "old.el\n")
    (ellm--insert-turn "assistant" :continuation t)
    (insert "keep me\n")
    (ellm-acp--delete-marked-turn "tool-call" "id" "call_1")
    (let ((contents (buffer-string)))
      (should-not (string-match-p "tool-call" contents))
      (should-not (string-match-p "tool-param" contents))
      (should-not (string-match-p "old.el" contents))
      (should (string-match-p "assistant" contents))
      (should (string-match-p "keep me" contents)))))

(ert-deftest ellm-test-user-prompt-header-status-shows-queue-count ()
  "The header status advertises queued user prompts and its answer action."
  (let ((ellm-user-prompt-activation 'when-selected))
    (with-temp-buffer
      (ellm-mode)
      (dotimes (_ 2)
        (ellm--request-user-prompt
         nil '(:kind question :title "Question") #'ignore))
      (let ((status (alist-get ?q (ellm--header-line-fields))))
        (should (equal (substring-no-properties status) "Input required (2) "))
        (should (eq (get-text-property 0 'keymap status)
                    ellm--user-prompt-header-map))))))

(ert-deftest ellm-test-user-prompt-custom-controls-completion-matching ()
  "Custom prompts allow arbitrary completion input; fixed prompts require options."
  (dolist (case '((t "custom" submitted nil)
                  (nil "main" selected t)))
    (pcase-let ((`(,custom ,answer ,status ,require-match) case))
      (let ((noninteractive nil)
            observed result)
        (with-temp-buffer
          (ellm-mode)
          (let ((ellm--inhibit-user-prompt-activation t))
            (ellm--request-user-prompt
             nil (list :kind 'question :title "Question"
                       :options '((:id "main" :label "main")) :custom custom)
             (lambda (outcome) (setq result outcome))))
          (setq ellm--active-user-prompt (car ellm--user-prompt-queue))
          (cl-letf (((symbol-function 'completing-read)
                     (lambda (_prompt _collection _predicate required &rest _)
                       (setq observed required)
                       answer)))
            (ellm--activate-user-prompt ellm--active-user-prompt))
          (should (eq observed require-match))
          (should (eq (plist-get result :status) status))
          (should (equal (plist-get result :value) answer)))))))

(ert-deftest ellm-test-user-prompt-option-candidates-are-unique ()
  "Completion labels remain unambiguous after disambiguation."
  (let ((candidates
         (ellm--user-prompt-option-candidates
          '((:id "first" :label "Foo")
            (:id "second" :label "Foo")
            (:id "third" :label "Foo [second]")))))
    (should (equal (mapcar #'car candidates)
                   '("Foo" "Foo [second]" "Foo [second] [third]")))
    (should (equal (mapcar #'cdr candidates)
                   '("first" "second" "third")))))

(ert-deftest ellm-test-user-prompt-queues-until-resolved ()
  "Deferred user prompts do not invoke a reader before activation."
  (let ((ellm-user-prompt-activation 'when-selected)
        result)
    (with-temp-buffer
      (ellm-mode)
      (ellm--request-user-prompt
       nil '(:kind question :title "Question" :options ((:id "one" :label "One")))
       (lambda (outcome) (setq result outcome)))
      (should ellm--active-user-prompt)
      (should-not result)
      (ellm--resolve-user-prompt ellm--active-user-prompt
                                  '(:status selected :value "one"))
      (should (equal result '(:status selected :value "one"))))))

(ert-deftest ellm-test-user-prompt-lazy-activation-uses-active-head ()
  "Selecting a buffer activates its queued head without replacing it."
  (let ((ellm-user-prompt-activation 'when-selected)
        activated)
    (save-window-excursion
      (with-temp-buffer
        (ellm-mode)
        (ellm--request-user-prompt
         nil '(:kind question :title "Question") #'ignore)
        (let ((prompt ellm--active-user-prompt))
          (switch-to-buffer (current-buffer))
          (cl-letf (((symbol-function 'ellm--activate-user-prompt)
                     (lambda (value) (setq activated value))))
            (ellm--maybe-activate-user-prompt))
          (should (eq activated prompt))
          (should (eq ellm--active-user-prompt prompt)))))))

(ert-deftest ellm-test-user-prompt-immediate-cancels-in-batch ()
  "Immediate prompts resolve without attempting minibuffer input in batch mode."
  (let ((ellm-user-prompt-activation 'immediate)
        result)
    (with-temp-buffer
      (ellm-mode)
      (ellm--request-user-prompt
       nil '(:kind question :title "Question")
       (lambda (outcome) (setq result outcome)))
      (should (equal result '(:status cancelled)))
      (should-not ellm--active-user-prompt))))

(ert-deftest ellm-test-user-prompt-queue-preserves-order-and-callbacks ()
  "Queued prompts resolve one at a time through their own callbacks."
  (let ((ellm-user-prompt-activation 'when-selected)
        results)
    (with-temp-buffer
      (ellm-mode)
      (dolist (id '("first" "second" "third"))
        (ellm--request-user-prompt
         nil (list :kind 'question :title id)
         (lambda (outcome) (push (cons id outcome) results))))
      (should (equal (mapcar #'ellm-user-prompt-title ellm--user-prompt-queue)
                     '("first" "second" "third")))
      (dolist (id '("first" "second" "third"))
        (should (equal (ellm-user-prompt-title ellm--active-user-prompt) id))
        (ellm--resolve-user-prompt ellm--active-user-prompt
                                    (list :status 'submitted :value id)))
      (should-not ellm--active-user-prompt)
      (should-not ellm--user-prompt-queue)
      (should (equal (mapcar (lambda (entry) (car entry)) (nreverse results))
                     '("first" "second" "third"))))))

(ert-deftest ellm-test-user-prompt-cancel-drains-queue ()
  "Cancelling a prompt cancels every queued continuation."
  (let ((ellm-user-prompt-activation 'when-selected)
        results)
    (with-temp-buffer
      (ellm-mode)
      (dotimes (index 2)
        (ellm--request-user-prompt
         nil (list :kind 'question :title (number-to-string index))
         (lambda (outcome) (push outcome results))))
      (ellm--cancel-pending-user-prompt)
      (should-not ellm--active-user-prompt)
      (should-not ellm--user-prompt-queue)
      (should (equal results '((:status cancelled) (:status cancelled)))))))

(ert-deftest ellm-test-ask-tool-advertises-structured-questions ()
  "The ask tool exposes a nested schema for its question records."
  (let* ((argument (car (plist-get ellm-tools/ask-tool :args)))
         (items (plist-get argument :items))
         (properties (plist-get items :properties)))
    (should (eq (plist-get argument :type) 'array))
    (should (eq (plist-get items :type) 'object))
    (should (equal (plist-get items :required) ["question"]))
    (should (eq (plist-get (plist-get properties :question) :type) 'string))
    (should (eq (plist-get (plist-get properties :options) :type) 'array))
    (should (eq (plist-get (plist-get (plist-get properties :options) :items)
                           :type)
                'string))))

(ert-deftest ellm-test-ask-tool-queues-question-batch ()
  "The ask tool aggregates queued single, multiple, and custom answers."
  (let ((ellm-user-prompt-activation 'when-selected)
        result)
    (with-temp-buffer
      (ellm-mode)
      (let ((request (ellm--make-request :buffer (current-buffer))))
        (ellm--set-active-request request)
        (unwind-protect
            (progn
              (ellm-tools/ask-tool
               (lambda (value) (setq result value))
               '((:question "Which branch should I use?"
                  :options ["main" "release"] :custom :json-false)
                 (:question "Which areas should be updated?"
                  :options ["Implementation" "Tests"] :multiple t)
                 (:question "What should the commit be called?")))
              (should (= (length ellm--user-prompt-queue) 3))
              (ellm--resolve-user-prompt ellm--active-user-prompt
                                          '(:status selected :value "main"))
              (ellm--resolve-user-prompt ellm--active-user-prompt
                                          '(:status selected
                                            :value ("Implementation" "Tests")))
              (ellm--resolve-user-prompt ellm--active-user-prompt
                                          '(:status submitted :value "Add parser"))
              (should (equal result
                             "Question: Which branch should I use?\nAnswer: main\n\nQuestion: Which areas should be updated?\nAnswer: Implementation, Tests\n\nQuestion: What should the commit be called?\nAnswer: Add parser")))
          (ellm--set-active-request nil))))))

(provide 'ellm-test)
(ert-deftest ellm-test-list-groups-and-prioritizes-sessions ()
  "The session list groups by project/directory and puts streams first."
  (let* ((project (make-temp-file "ellm-list-project-" t))
         (outside (make-temp-file "ellm-list-outside-" t))
         (streaming (generate-new-buffer "ellm list streaming"))
         (ready (generate-new-buffer "ellm list ready"))
         (ellm-current-project-function
          (lambda ()
            (when (string-prefix-p project default-directory) project))))
    (unwind-protect
        (progn
          (with-current-buffer streaming
            (setq default-directory project)
            (ellm-mode)
            (setq ellm--last-activity-time 1)
            (ellm--set-active-request
             (ellm--make-request :buffer streaming :state 'streaming))
            (setf (ellm-buffer-state-context-usage ellm-buffer-state) 25
                  (ellm-buffer-state-context-size ellm-buffer-state) 100))
          (with-current-buffer ready
            (setq default-directory outside)
            (ellm-mode)
            (setq ellm--last-activity-time 100))
          (let ((records (ellm-list--records))
                (groups (ellm-list--groups)))
            (should (eq (plist-get (car records) :buffer) streaming))
            (should (equal (plist-get (car records) :context) "25/100 (25.0%%)"))
            (should (string-prefix-p "Project: " (plist-get (car groups) :label)))
            (ellm-list)
            (with-current-buffer "*ellm sessions*"
              (ellm-list--goto-buffer streaming)
              (ellm-list-refresh)
              (should (eq (ellm-list--buffer-at-point) streaming))
              (ellm-list-toggle-group)
              (should (equal (ellm-list--group-at-point)
                             (plist-get (car groups) :key))))))
      (dolist (buffer (list streaming ready (get-buffer "*ellm sessions*")))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            (when (derived-mode-p 'ellm-mode)
              (ellm--set-active-request nil)))
          (kill-buffer buffer)))
      (delete-directory project t)
      (delete-directory outside t))))

(ert-deftest ellm-test-list-answer-prompt-keeps-list-selected ()
  "Answer prompts from the session list without visiting the conversation."
  (let ((conversation (generate-new-buffer "ellm list prompt"))
        answered-buffer)
    (unwind-protect
        (save-window-excursion
          (with-current-buffer conversation
            (ellm-mode))
          (ellm-list)
          (with-current-buffer "*ellm sessions*"
            (ellm-list--goto-buffer conversation)
            (cl-letf (((symbol-function 'ellm-answer-prompt)
                       (lambda () (setq answered-buffer (current-buffer)))))
              (ellm-list-answer-prompt))
            (should (eq answered-buffer conversation))
            (should (eq (window-buffer (selected-window)) (current-buffer)))))
      (dolist (buffer (list conversation (get-buffer "*ellm sessions*")))
        (when (buffer-live-p buffer)
          (kill-buffer buffer))))))

(ert-deftest ellm-test-request-events-refresh-their-conversation-list-row ()
  "Backend callbacks refresh the owning conversation, not their current buffer."
  (let ((conversation (generate-new-buffer " *ellm list conversation*"))
        (callback (generate-new-buffer " *ellm backend callback*"))
        scheduled)
    (unwind-protect
        (let ((ellm-request-timeout nil))
          (with-current-buffer conversation
            (ellm-mode)
            (let ((request (ellm--make-request :buffer conversation)))
              (ellm--set-active-request request)
              (cl-letf (((symbol-function 'ellm-list--schedule-refresh)
                         (lambda (buffer) (setq scheduled buffer))))
                (with-current-buffer callback
                  (ellm--request-handle-event request 0 '(:type activity))))
              (should (eq scheduled conversation))
              (ellm--set-active-request nil))))
      (dolist (buffer (list conversation callback))
        (when (buffer-live-p buffer) (kill-buffer buffer))))))

(ert-deftest ellm-test-list-formats-semantic-statuses ()
  "Session-list statuses and secondary columns use their semantic faces."
  (let ((record '(:status "Streaming" :model "model" :context "12%"
                  :todos "1/2" :title "Conversation")))
    (let ((row (ellm-list--format-row record)))
      (should (eq (get-text-property 0 'face row) 'ellm-list-status-active))
      (should (eq (get-text-property 14 'face row) 'ellm-list-secondary))
      (should (string-match "1/2 +Conversation +12% +model" row))
      (should (string-match "Conversation" row))
      (should (eq (get-text-property (match-beginning 0) 'face row)
                  'ellm-list-title)))))

(ert-deftest ellm-test-list-pulses-terminal-status-transitions ()
  "Only terminal list-status transitions request a semantic pulse."
  (should (eq (ellm-list--transition-pulse-face "Working" "Ready")
              'ellm-list-pulse-success))
  (should (eq (ellm-list--transition-pulse-face "Ready" "Input required")
              'ellm-list-pulse-warning))
  (should-not (ellm-list--transition-pulse-face "Streaming" "Working")))

(ert-deftest ellm-test-list-batches-row-refresh-ui-work ()
  "Refreshing several rows preserves UI state and redisplays only once."
  (with-temp-buffer
    (let ((point-restores 0)
          (window-restores 0)
          (redisplays 0))
      (cl-letf (((symbol-function 'ellm-list--refresh-buffer-row)
                 (lambda (_buffer) t))
                ((symbol-function 'ellm-list--point-location)
                 (lambda (_position) 'location))
                ((symbol-function 'ellm-list--window-locations)
                 (lambda () 'windows))
                ((symbol-function 'ellm-list--restore-point-location)
                 (lambda (_location) (cl-incf point-restores)))
                ((symbol-function 'ellm-list--restore-window-locations)
                 (lambda (_locations) (cl-incf window-restores)))
                ((symbol-function 'ellm-list--redisplay)
                 (lambda (_buffer) (cl-incf redisplays))))
        (should-not (ellm-list--refresh-buffers '(one two)))
        (should (= point-restores 1))
        (should (= window-restores 1))
        (should (= redisplays 1))))))

(ert-deftest ellm-test-list-does-not-schedule-refresh-while-hidden ()
  "Automatic session-list updates do no work while the list is hidden."
  (let ((list-buffer (get-buffer-create "*ellm sessions*"))
        (ellm-list--refresh-timer nil)
        (ellm-list--pending-refreshes nil)
        (ellm-list--hidden-dirty nil))
    (unwind-protect
        (with-current-buffer list-buffer
          (ellm-list-mode)
          (cl-letf (((symbol-function 'run-at-time)
                     (lambda (&rest _) (ert-fail "should not schedule a timer"))))
            (ellm-list--schedule-refresh 'conversation)
            (should-not ellm-list--pending-refreshes)
            (should-not ellm-list--refresh-timer)
            (should ellm-list--hidden-dirty)
            (should (= ellm-list--refresh-delay 0.5))))
      (when (timerp ellm-list--refresh-timer)
        (cancel-timer ellm-list--refresh-timer))
      (when (buffer-live-p list-buffer)
        (kill-buffer list-buffer)))))

(ert-deftest ellm-test-list-refreshes-when-displayed-if-dirty ()
  "Displaying a hidden session list rebuilds only skipped updates."
  (let ((list-buffer (generate-new-buffer " *ellm sessions test*"))
        (other-buffer (generate-new-buffer " *ellm non-list test*"))
        (ellm-list--hidden-dirty nil)
        (refreshes 0) refreshed-buffer)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer list-buffer)
          (with-current-buffer list-buffer
            (ellm-list-mode)
            (should (memq #'ellm-list--refresh-on-display
                          window-buffer-change-functions)))
          (cl-letf (((symbol-function 'ellm-list-refresh)
                     (lambda ()
                       (cl-incf refreshes)
                       (setq refreshed-buffer (current-buffer)))))
            (with-current-buffer other-buffer
              (ellm-list--refresh-on-display (selected-window)))
            (should (= refreshes 0))
            (setq ellm-list--hidden-dirty t)
            (with-current-buffer other-buffer
              (ellm-list--refresh-on-display (selected-window)))
            (should (= refreshes 1))
            (should (eq refreshed-buffer list-buffer))))
      (dolist (buffer (list list-buffer other-buffer))
        (when (buffer-live-p buffer)
          (kill-buffer buffer))))))

(ert-deftest ellm-test-list-nests-and-toggles-subagents ()
  "Live subagents are nested below their known parent conversation."
  (let ((parent (generate-new-buffer "ellm list parent"))
        (child (generate-new-buffer "ellm list child")))
    (unwind-protect
        (progn
          (with-current-buffer parent (ellm-mode))
          (with-current-buffer child
            (ellm-mode)
            (setq ellm-subagent-parent-buffer (buffer-name parent)))
          (ellm-list)
          (with-current-buffer "*ellm sessions*"
            (ellm-list--goto-buffer parent)
            (should (= (current-indentation) 1))
            (should (= (length (get-text-property
                                (point) 'ellm-list-subagent-children))
                       1))
            ;; The list's rendered parent has its child record attached.
            (should (ellm-list--goto-buffer child))
            (should (= (current-indentation) 5))
            ;; Streaming updates retain both the selected row and its column.
            (move-to-column 8)
            (let ((column (current-column)))
              (ellm-list-refresh-buffer child)
              (should (eq (ellm-list--buffer-at-point) child))
              (should (= (current-column) column)))
            (ellm-list--goto-buffer parent)
            (ellm-list-toggle-subagents)
            (should-not (ellm-list--goto-buffer child))
            (should (ellm-list--buffer-hidden-p child))
            (ellm-list--goto-buffer parent)
            (ellm-list-toggle-subagents)
            (should (ellm-list--goto-buffer child))))
      (dolist (buffer (list parent child (get-buffer "*ellm sessions*")))
        (when (buffer-live-p buffer) (kill-buffer buffer))))))

(ert-deftest ellm-test-prompt-tags-fontify-and-fold-within-turn ()
  "Complete line prompt tags are fontified and fold only in their turn."
  (with-temp-buffer
    (insert ">-| user\n<tag>\nlong prompt\n</tag>\n"
            ">-| assistant\n<open>\nother turn\n</open>\n")
    (ellm-mode)
    (font-lock-ensure)
    (goto-char (point-min))
    (search-forward "<tag>")
    (should (ellm-test--face-includes-p
             (get-text-property (1- (point)) 'face) 'ellm-tag))
    (beginning-of-line)
    (ellm-toggle-tag)
    (should (invisible-p (line-end-position)))
    (search-forward "</tag>")
    (should-not (invisible-p (match-beginning 0)))
    (search-backward "<tag>")
    (beginning-of-line)
    (ellm-toggle-tag)
    (should-not (invisible-p (line-end-position)))))

(ert-deftest ellm-test-prompt-tag-requires-turn-local-closing-line ()
  "Inline, indented, and cross-turn tags are not foldable."
  (with-temp-buffer
    (insert ">-| user\n<tag>\nbody\n"
            ">-| assistant\n</tag>\n inline <x>\n <y>\n</y>\n")
    (ellm-mode)
    (font-lock-ensure)
    (goto-char (point-min))
    (search-forward "<tag>")
    (beginning-of-line)
    (should-not (ellm--tag-fold-bounds-at-point))
    (search-forward "<x>")
    (should-not (ellm-test--face-includes-p
                 (get-text-property (1- (point)) 'face) 'ellm-tag))
    (search-forward "<y>")
    (beginning-of-line)
    (should-not (ellm--tag-fold-bounds-at-point))))

(ert-deftest ellm-test-persisted-sessions-show-metadata-and-sort-by-recency ()
  (let* ((root (make-temp-file "ellm-sessions-" t))
         (older-directory (expand-file-name "older/" root))
         (newer-directory (expand-file-name "newer/" root))
         (older-main (expand-file-name "main.ellm" older-directory))
         (newer-main (expand-file-name "main.ellm" newer-directory)))
    (unwind-protect
        (progn
          (make-directory (expand-file-name ".git/" root) t)
          (make-directory older-directory t)
          (make-directory (expand-file-name "subagents/" newer-directory) t)
          (with-temp-file older-main
            (insert (format "---\ncwd: %s\n---\n\n>-| user\nOlder prompt\n"
                            older-directory)))
          (with-temp-file newer-main
            (insert (format "---\ncwd: %s\ntitle: Newer title\n---\n\n>-| user\nNewer prompt\n"
                            newer-directory)))
          (with-temp-file (expand-file-name "worker.ellm"
                                             (expand-file-name "subagents/" newer-directory))
            (insert ">-| assistant\nWorking\n"))
          (set-file-times older-main (time-subtract (current-time) 60))
          (let* ((sessions (ellm--persisted-sessions root))
                 (newer (car sessions))
                 (choice (ellm--persisted-session-choice newer)))
            (should (= (length sessions) 2))
            (should (equal (ellm--persisted-session-main-file newer) newer-main))
            (should (equal (ellm--persisted-session-cwd newer) newer-directory))
            (should (equal (ellm--persisted-session-project newer)
                           (file-name-nondirectory (directory-file-name root))))
            (should (equal (ellm--persisted-session-title newer) "Newer title"))
            (should (equal (ellm--persisted-session-summary newer) "Newer prompt"))
            (should (= (ellm--persisted-session-subagent-count newer) 1))
            (should (string-match-p "Newer title" choice))
            (should-not (string-match-p "Newer prompt" choice))
            (should (string-match-p "1 subagent" choice))))
      (delete-directory root t))))

(ert-deftest ellm-test-open-session-reuses-an-existing-main-buffer ()
  (let* ((root (make-temp-file "ellm-sessions-" t))
         (main (expand-file-name "session/main.ellm" root))
         buffer)
    (unwind-protect
        (progn
          (make-directory (file-name-directory main) t)
          (with-temp-file main (insert ">-| user\nResume\n"))
          (setq buffer (find-file-noselect main))
          (with-current-buffer buffer
            (insert "Unsaved edit\n"))
          (cl-letf (((symbol-function 'ellm--persistence-root) (lambda () root))
                    ((symbol-function 'completing-read)
                     (lambda (_prompt choices &rest _) (caar choices))))
            (ellm-open-session))
          (should (eq (current-buffer) buffer))
          (with-current-buffer buffer
            (should (buffer-modified-p))
            (should (string-match-p "Unsaved edit" (buffer-string)))))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer
          (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (delete-directory root t))))

(ert-deftest ellm-test-fold-and-unfold-all-prompt-tags ()
  "Explicit tag commands affect complete tags in every turn."
  (with-temp-buffer
    (insert ">-| user\n<a>\nFIRST-TAG-BODY\n</a>\n"
            ">-| assistant\n<b>\nSECOND-TAG-BODY\n</b>\n")
    (ellm-mode)
    (ellm-fold-all-tags)
    (should (ellm-test--invisible-at-text "FIRST-TAG-BODY"))
    (should (ellm-test--invisible-at-text "SECOND-TAG-BODY"))
    (ellm-unfold-all-tags)
    (should-not (ellm-test--invisible-at-text "FIRST-TAG-BODY"))
    (should-not (ellm-test--invisible-at-text "SECOND-TAG-BODY"))))

