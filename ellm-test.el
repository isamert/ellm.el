(ert-deftest ellm-test-acp-final-prompt-reply-finishes-request ()
  "ACP final prompt replies should finish even without callback dispatch."
  (let ((connection (ellm-acp-connection
                     :name "test"
                     :process (start-process "ellm-acp-test-sleep" nil "sleep" "10")
                     :buffer (current-buffer))))
    (unwind-protect
        (with-temp-buffer
          (ellm-mode)
          (setf (ellm-acp--connection-buffer connection) (current-buffer))
          (setf (ellm-acp--connection-prompt-request-id connection) 5)
          (ellm--insert-turn "assistant")
          (insert "VIDIA.\n")
          (let* ((driver
                  (ellm-acp--make-request
                   :connection connection))
                 (request
                  (ellm--make-request
                   :buffer (current-buffer) :backend driver
                   :generation ellm--request-generation :attempt 1))
                 (emit
                  (lambda (event)
                    (ellm--request-handle-event request 1 event))))
            (setf (ellm-acp--connection-current-request connection) driver
                  (ellm-acp-request-emit driver) emit)
            (ellm--set-active-request request)
            (ellm-acp--maybe-finish-prompt-reply
             connection '(:id 5 :result (:stopReason "end_turn")))
            (should-not ellm--active-request)
            (should-not buffer-read-only)
            (should (equal
                     (ellm-turn-role (car (last (ellm--parse-turns))))
                     "user"))
            (funcall emit '(:type complete))
            (should (= 1 (cl-count-if
                          (lambda (turn)
                            (equal (ellm-turn-role turn) "user"))
                          (ellm--parse-turns))))))
      (when (jsonrpc-running-p connection)
        (jsonrpc-shutdown connection)))))

(ert-deftest ellm-test-acp-session-list-load ()
  "ACP session loading should select a listed session and open a buffer."
  (let ((agent-file (make-temp-file "ellm-fake-acp-session-" nil ".py"))
        loaded-buffer)
    (unwind-protect
        (progn
          (with-temp-file agent-file
            (insert "import json, sys\n"
                    "for line in sys.stdin:\n"
                    "    msg = json.loads(line)\n"
                    "    mid = msg.get('id')\n"
                    "    method = msg.get('method')\n"
                    "    if method == 'initialize':\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'protocolVersion':1,'agentCapabilities':{'loadSession':True,'sessionCapabilities':{'list':{}}}}}\n"
                    "    elif method == 'session/list':\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'sessions':[{'sessionId':'sess_load','cwd':'/tmp','title':'Loaded Session','updatedAt':'2026-01-01T00:00:00Z'}]}}\n"
                    "    elif method == 'session/load':\n"
                    "        sid = msg['params']['sessionId']\n"
                    "        print(json.dumps({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':sid,'update':{'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':'loaded history'}}}}), flush=True)\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{}}\n"
                    "    else:\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32601,'message':'unknown'}}\n"
                    "    print(json.dumps(out), flush=True)\n"))
           (let ((ellm-provider-alist
                  `((fake . ,(ellm-make-acp-provider
                              :command "python3"
                              :args (list agent-file)))))
                 (ellm-buffer-name-function #'ellm-default-buffer-name)
                 (ellm-current-project-function (lambda () nil))
                 (default-directory "/tmp/"))
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt collection &rest _)
                         (caar collection)))
                      ((symbol-function 'switch-to-buffer)
                       (lambda (buffer-or-name &rest _)
                         (setq loaded-buffer (get-buffer buffer-or-name)))))
              (setq loaded-buffer (ellm-load-session)))
             (with-current-buffer loaded-buffer
               (let ((contents (buffer-string))
                     (turns (ellm--parse-turns)))
                 (should (equal (buffer-name) "*ellm: Loaded Session*"))
                 (should (string-match-p "session-id: sess_load" contents))
                 (should (string-match-p "loaded history" contents))
                 (should (equal (ellm-turn-role (car (last turns))) "user"))))))
      (when (buffer-live-p loaded-buffer)
        (when ellm-acp--connection
          (delete-process (ellm-acp--connection-process ellm-acp--connection)))
        (kill-buffer loaded-buffer))
      (delete-file agent-file))))

(ert-deftest ellm-test-mcp-tool-schema-normalization ()
  "MCP JSON Schema types should work with llm.el tool serialization."
  (let* ((args '((:name "files" :type "array"
                   :items (:type "object"
                           :properties (:file_path (:type "string"))))))
         (tool (ellm-mcp--make-tool
                (list :name "push_files" :description "Push files"
                      :args args :async t :function #'ignore)))
         (normalized (ellm-tool-args tool)))
    (should (eq (plist-get (car normalized) :type) 'array))
    (should (eq (plist-get (plist-get (car normalized) :items) :type)
                'object))
    (should (eq (plist-get (plist-get
                            (plist-get (plist-get (car normalized) :items)
                                       :properties)
                            :file_path)
                           :type)
                'string))
    ;; This raised `wrong-type-argument: symbolp, "string"' for MCP tools.
    (should (llm-provider-utils-openai-arguments normalized))
    ;; Registration must not mutate mcp.el's cached tool schema.
    (should (equal (plist-get (car args) :type) "array"))))


(ert-deftest ellm-test-mcp-resolution ()
  "Frontmatter `mcp:' should resolve all, named, category, and inline servers."
  (let ((ellm-mcp-servers
         '(("fs" . (:command "mcp-fs" :args ("--stdio") :category "local"))
           ("web" . (:url "https://example.test/mcp" :category "remote")))))
