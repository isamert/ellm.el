(ert-deftest ellm-test-core-request-drops-events-after-terminal-transition ()
  "The core reducer should accept one terminal event and reject later events."
  (let ((ellm-provider (make-ellm-test-pending-provider))
        (finished 0))
    (with-temp-buffer
      (ellm-mode)
      (setq-local ellm-request-finished-hook
                  (list (lambda (_request _outcome) (cl-incf finished))))
      (ellm--insert-turn "user")
      (insert "hi\n")
      (ellm-send)
      (let* ((request ellm--active-request)
             (driver (ellm-request-backend request))
             (emit (ellm-test-pending-request-emit driver)))
        (funcall emit
                 '(:type stream :mode append :channel assistant
                   :text "accepted\n"))
        (funcall emit '(:type complete))
        (let ((terminal-buffer (buffer-string)))
          (funcall emit
                   '(:type stream :mode append :channel assistant
                     :text "late\n"))
          (funcall emit
                   '(:type failure :message "late failure"))
          (should (equal (buffer-string) terminal-buffer)))
        (should (eq (ellm-request-state request) 'completed))
        (should-not ellm--active-request)
        (should (= finished 1))))))

(ert-deftest ellm-test-request-lifecycle-hooks-have-logical-request-contract ()
  "Request lifecycle hooks run once with normalized request context."
  (let ((ellm-provider (make-ellm-test-pending-provider))
        started finished)
    (with-temp-buffer
      (ellm-mode)
      (add-hook 'ellm-request-started-hook
                (lambda (request event) (setq started (list request event))) nil t)
      (add-hook 'ellm-request-finished-hook
                (lambda (request outcome) (setq finished (list request outcome))) nil t)
      (ellm--insert-turn "user")
      (insert "hi\n")
      (ellm-send)
      (let* ((request ellm--active-request)
             (emit (ellm-test-pending-request-emit
                    (ellm-request-backend request))))
        (should (eq (car started) request))
        (should (eq (plist-get (cadr started) :type) 'request-started))
        (funcall emit '(:type complete))
        (should (eq (car finished) request))
        (should (eq (plist-get (cadr finished) :state) 'completed))))))

(ert-deftest ellm-test-before-request-hook-vetoes-without-transcript-mutation ()
