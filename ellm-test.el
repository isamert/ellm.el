                   "unknown subagent"
                   (ellm-tools/send-subagent-tool (buffer-name foreign) nil))))
      (when (buffer-live-p foreign)
        (kill-buffer foreign)))))

(ert-deftest ellm-test-wait-subagent-returns-completed-result ()
