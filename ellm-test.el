(defvar ellm-test--prompt-interpolation-count 0
  "Evaluation counter for prompt interpolation tests.")

(ert-deftest ellm-test-with-ellm-buffers-skips-hidden-buffers ()
  (let ((visible (generate-new-buffer "ellm visible"))
        (hidden (generate-new-buffer " *ellm hidden*"))
        seen)
    (unwind-protect
        (progn
          (with-current-buffer visible (ellm-mode))
          (with-current-buffer hidden (ellm-mode))
          (ellm--with-ellm-buffers buffer
            (when (memq buffer (list visible hidden))
              (push (cons buffer (current-buffer)) seen)))
          (should (equal seen (list (cons visible visible)))))
      (dolist (buffer (list visible hidden))
        (when (buffer-live-p buffer)
          (kill-buffer buffer))))))

(ert-deftest ellm-test-comment-quotes-current-line-and-omits-empty-comment ()
  (with-temp-buffer
    (ellm-mode)
    (insert "First line\nSecond line")
    (goto-char (point-min))
    (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "")))
      (ellm-comment))
    (should (equal (buffer-string) "First line\nSecond line\n\n> First line\n"))))

(ert-deftest ellm-test-jump-to-tool-pair-toggles-between-call-and-result ()
  (with-temp-buffer
    (ellm-mode)
    (ellm--insert-turn "assistant")
    (ellm--insert-turn "tool-call" :pipe-arg "Shell" :id "call_1")
    (insert "ls\n")
    (ellm--insert-turn "tool-result" :pipe-arg "Shell" :id "call_1")
    (insert "file\n")
    (let* ((turns (ellm--parse-turns))
           (call (nth 1 turns))
           (result (nth 2 turns)))
      (goto-char (ellm--turn-delimiter-beg call))
      (ellm-jump-to-tool-pair)
      (should (= (point) (ellm--turn-delimiter-beg result)))
      (ellm-jump-to-tool-pair)
      (should (= (point) (ellm--turn-delimiter-beg call))))))



(ert-deftest ellm-test-comment-quotes-region-and-appends-comment ()
