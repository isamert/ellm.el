    (unwind-protect
        (progn
          (with-current-buffer parent
            (ellm-mode)
            (setq-local ellm-subagent-history
                        (list (list :id "child_1"
                                    :buffer-name (buffer-name child)))))
          (with-current-buffer child
            (ellm-mode)
            (setq-local ellm-subagent-parent-buffer (buffer-name parent)))
          (with-current-buffer parent
            (ellm-tools/wait-subagent-tool
             (lambda (value) (setq result value)) "child_1"))
          (should (equal result
                         "Subagent child_1 has no assistant response available.")))
      (dolist (buffer (list parent child))
        (when (buffer-live-p buffer)
          (kill-buffer buffer))))))

(ert-deftest ellm-test-subagent-title-does-not-rename-buffer ()
  "Subagent titles must not invalidate their recorded buffer names."
  (let* ((provider (make-ellm-test-sync-provider))
         (ellm-provider-alist
          `((parent . (:provider ,provider :models ("m"))))))
    (with-temp-buffer
      (insert "---\nprovider: parent\nmodel: m\n---\n\n")
      (ellm-mode)
      (unwind-protect
          (progn
            (ellm-tools/launch-subagent-tool
             "Initial prompt." nil "worker" nil)
            (let* ((entry (car ellm-subagent-history))
                   (id (plist-get entry :id))
                   (name (plist-get entry :buffer-name))
                   (buffer (get-buffer name))
                   result)
              (with-current-buffer buffer
                (should-not ellm--session-titling-p)
                (ellm-set-session-title "A generated title")
                (ellm-update-session-title "A direct title")
                (should (equal (buffer-name) name))
                (should-not ellm--session-title))
              (ellm-tools/wait-subagent-tool
               (lambda (value) (setq result value)) id)
              (should (equal result "done"))))
        (dolist (entry ellm-subagent-history)
          (when-let* ((buffer (get-buffer (plist-get entry :buffer-name))))
            (kill-buffer buffer)))))))

(ert-deftest ellm-test-wait-subagent-finishes-from-request-hook ()
  "`wait_subagent' should finish when the child signals request completion."
  (let* ((provider (make-ellm-test-pending-provider))
         (ellm-provider-alist
          `((parent . (:provider ,provider :models ("m"))))))
    (with-temp-buffer
      (insert "---\nprovider: parent\nmodel: m\n---\n\n")
      (ellm-mode)
      (unwind-protect
          (progn
            (ellm-tools/launch-subagent-tool
             "Finish later." nil "worker" nil)
            (let* ((entry (car ellm-subagent-history))
                   (id (plist-get entry :id))
                   (buffer (get-buffer (plist-get entry :buffer-name)))
                   result)
              (ellm-tools/wait-subagent-tool
               (lambda (value) (setq result value)) id)
              (should-not result)
              (with-current-buffer buffer
                (let ((request ellm--active-request))
                  (ellm--set-active-request nil)
                  (ellm--notify-request-finished request '(:state completed))))
              (should (equal result ""))))
        (dolist (entry ellm-subagent-history)
          (when-let* ((buffer (get-buffer (plist-get entry :buffer-name))))
            (with-current-buffer buffer
              (when ellm--active-request
                (ellm-cancel t)))
            (kill-buffer buffer)))))))

(defvar ellm-test--close-session-called nil)

(cl-defstruct ellm-test-close-provider)

(cl-defmethod ellm-provider-close-session ((_provider ellm-test-close-provider)
                                           _frontmatter _buffer)
  "Record close-session calls for `ellm-close-session' tests."
  (setq ellm-test--close-session-called t))

(ert-deftest ellm-test-close-session-can-clear-buffer ()
  "Interactive session close can clear conversation while keeping frontmatter."
  (let ((ellm-provider (make-ellm-test-close-provider))
        (ellm-test--close-session-called nil)
        (close-hook-called nil))
    (with-temp-buffer
      (insert "---\nprovider: null\nfoo: bar\n---\n\n"
              ">-| user\nhi\n>-| assistant\nhello\n")
      (ellm-mode)
      (add-hook 'ellm-session-close-hook
                (lambda () (setq close-hook-called t)) nil t)
      (cl-letf (((symbol-function 'y-or-n-p)
                  (lambda (prompt)
                    (should (string-match-p "Clear buffer" prompt))
                    t)))
        (call-interactively #'ellm-close-session))
      (should ellm-test--close-session-called)
      (should close-hook-called)
      (should (equal (buffer-string)
                     "---\nprovider: null\nfoo: bar\n---\n\n>-| user\n")))))

(ert-deftest ellm-test-close-session-kills-named-elisp-sessions ()
  "Closing a backend session should kill buffer-owned Elisp children."
  (let ((ellm-provider (make-ellm-test-close-provider)))
    (with-temp-buffer
      (ellm-mode)
      (ellm-test--elisp-eval "t" "worker")
      (let ((process
             (ellm-tools--elisp-session-process
              (gethash "worker" ellm-tools--elisp-sessions))))
        (should (process-live-p process))
        (ellm-close-session)
        (should-not (process-live-p process))))))

(ert-deftest ellm-test-frontmatter-edit-scalar-values ()
  "Frontmatter scalar values can be added, changed, and deleted."
  (with-temp-buffer
    (insert "---\nprovider: opencode\n---\n\n>-| user\nhi\n")
    (setq buffer-read-only t)
    (ellm--set-frontmatter-value '(acp session-id) "sess_1")
    (should buffer-read-only)
    (should (equal (ellm--frontmatter-value '(acp session-id)) "sess_1"))
    (ellm--set-frontmatter-value '("acp" "session-id") "sess_2")
    (should (equal (ellm--frontmatter-value '(acp session-id)) "sess_2"))
    (ellm--set-frontmatter-value '(acp session-id) nil)
    (should-not (ellm--frontmatter-value '(acp session-id)))))

(ert-deftest ellm-test-frontmatter-edit-preserves-quoted-category-keys ()
  "Re-encoding frontmatter keeps category selector keys valid YAML."
  (with-temp-buffer
    (insert "---\ntool-permissions:\n  \"@files\": ask\n  \"@emacs\": ask\n---\n\n>-| user\nhi\n")
    (ellm-mode)
    ;; Any persisted setting rewrites the complete frontmatter map.
    (ellm--set-frontmatter-value 'model "test-model")
    (should (string-match-p
             "  \\\"@files\\\": ask\n  \\\"@emacs\\\": ask"
             (buffer-string)))
    (should (equal (alist-get 'tool-permissions (ellm--parse-frontmatter))
                   '((@files . "ask") (@emacs . "ask"))))))

(ert-deftest ellm-test-frontmatter-edit-creates-frontmatter ()
  "Setting a frontmatter value creates frontmatter when absent."
  (with-temp-buffer
    (insert ">-| user\nhi\n")
    (ellm--set-frontmatter-value '(acp session-id) "sess_1")
    (goto-char (point-min))
    (should (looking-at-p "---\nacp: ?\n  session-id: sess_1\n---\n\n"))
    (should (equal (ellm--frontmatter-value '(acp session-id)) "sess_1"))))

(ert-deftest ellm-test-frontmatter-cache-reuses-unchanged-body ()
  "Frontmatter parsing should be cached until the YAML body text changes."
  (let ((parse-count 0)
        (orig-parse (symbol-function 'yaml-parse-string)))
    (with-temp-buffer
      (insert "---\nprovider: fake\n---\n\n>-| user\nhi\n")
      (cl-letf (((symbol-function 'yaml-parse-string)
                 (lambda (&rest args)
                   (cl-incf parse-count)
                   (apply orig-parse args))))
        (should (equal (alist-get 'provider (ellm--parse-frontmatter))
                       "fake"))
        (should (= parse-count 1))
        (goto-char (point-max))
        (insert "body edit\n")
        (should (equal (alist-get 'provider (ellm--parse-frontmatter))
                       "fake"))
        (should (= parse-count 1))
        (goto-char (point-min))
        (search-forward "fake")
        (replace-match "other")
        (should (equal (alist-get 'provider (ellm--parse-frontmatter))
                       "other"))
        (should (= parse-count 2))))))

(ert-deftest ellm-test-frontmatter-cache-protects-cached-alist ()
  "Mutating a returned frontmatter alist should not mutate the cache."
  (with-temp-buffer
    (insert "---\nprovider: fake\n---\n\n")
    (let ((fm (ellm--parse-frontmatter)))
      (setf (alist-get 'provider fm) "mutated"))
    (should (equal (alist-get 'provider (ellm--parse-frontmatter))
                   "fake"))))

(ert-deftest ellm-test-frontmatter-cache-caches-parse-errors ()
  "Invalid frontmatter should cache the parse failure for unchanged text."
  (let ((parse-count 0)
        (warn-count 0)
        (orig-parse (symbol-function 'yaml-parse-string)))
    (with-temp-buffer
      (insert "---\nprovider: [unterminated\n---\n\n")
      (cl-letf (((symbol-function 'yaml-parse-string)
                 (lambda (&rest args)
                   (cl-incf parse-count)
                   (apply orig-parse args)))
                ((symbol-function 'ellm--warn-frontmatter-parse-error)
                 (lambda (_err)
                   (cl-incf warn-count))))
        (should-not (ellm--parse-frontmatter t))
        (should (= parse-count 1))
        (should (= warn-count 0))
        (should-not (ellm--parse-frontmatter))
        (should (= parse-count 1))
        (should (= warn-count 1))
        (erase-buffer)
        (insert "---\nprovider: fixed\n---\n\n")
        (should (equal (alist-get 'provider (ellm--parse-frontmatter))
                       "fixed"))
        (should (= parse-count 2))))))

(ert-deftest ellm-test-llm-backend-reuses-send-frontmatter-parse ()
  "The llm.el backend should not reparse frontmatter while building prompt."
  (let ((ellm-provider (make-llm-fake :chat-action-func (lambda () "ok")))
        (ellm-llm-generate-title nil)
        (parse-count 0)
        (orig-parse (symbol-function 'ellm--parse-frontmatter)))
    (with-temp-buffer
      (insert "---\ntemperature: 0.1\n---\n\n")
      (ellm-mode)
      (ellm--insert-turn "user")
      (insert "hi\n")
      (cl-letf (((symbol-function 'ellm--parse-frontmatter)
                 (lambda (&rest args)
                   (cl-incf parse-count)
                   (apply orig-parse args))))
        (ellm-send))
      (should (= parse-count 1))
      (should (string-match-p "ok" (buffer-string))))))

(ert-deftest ellm-test-header-line-title-combinations ()
  "Header line should combine optional title, todos, and right status."
  (with-temp-buffer
    (ellm-mode)
    (setq ellm--session-title "Implement 100% coverage\nnow")
    (should (equal (ellm--header-line-status)
                   "Implement 100%% coverage now"))
    (ellm-update-todos '((:content "Inspect" :status "in_progress")))
    (should (equal (ellm--header-line-status)
                   "Implement 100%% coverage now — [0/1] Inspect"))
    (setq ellm--session-title nil)
    (should (equal (ellm--header-line-status) "[0/1] Inspect"))
    (setf (ellm-buffer-state-todos ellm-buffer-state) nil
          (ellm-buffer-state-context-usage ellm-buffer-state) 10
          (ellm-buffer-state-context-size ellm-buffer-state) 100)
    (should (string-match-p "10/100 (10.0%%)"
                            (ellm--header-line-status)))))

(ert-deftest ellm-test-header-line-status-formatting ()
  "Header-line status should be nil-safe and compact."
  (with-temp-buffer
    (ellm-mode)
    (should-not (ellm--header-line-status))
    (setf (ellm-buffer-state-context-usage ellm-buffer-state) 3500)
    (setf (ellm-buffer-state-context-size ellm-buffer-state) 200000)
    (setf (ellm-buffer-state-cost-amount ellm-buffer-state) 0.2)
    (setf (ellm-buffer-state-cost-currency ellm-buffer-state) "USD")
    (ellm-update-todos
     '((:content "Inspect" :status "completed")
       (:content "Implement" :status "in_progress")))
    (let ((status (ellm--header-line-status)))
      (should (string-prefix-p "[1/2] Implement" status))
      (should (string-match-p "3.5K/200K (1.8%%)" status))
      (should (string-match-p "\\$0.20" status)))))

(ert-deftest ellm-test-header-line-template-fields ()
  "Header-line templates should expand individual and composed fields."
  (let ((ellm-header-line-template "%t | %a | %p | %u | %c"))
    (with-temp-buffer
      (ellm-mode)
      (setq ellm--session-title "Implement")
      (ellm-update-todos '((:content "Test" :status "in_progress")))
      (setf (ellm-buffer-state-context-usage ellm-buffer-state) 10
            (ellm-buffer-state-context-size ellm-buffer-state) 100
            (ellm-buffer-state-cost-amount ellm-buffer-state) 0.2
            (ellm-buffer-state-cost-currency ellm-buffer-state) "USD")
      (should (equal (ellm--header-line-status)
                     "Implement | Test | [0/1] | 10/100 (10.0%%) | $0.20")))))

(ert-deftest ellm-test-header-line-template-right-alignment ()
