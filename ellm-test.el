                            (plist-get failure :message)))))

(ert-deftest ellm-test-acp-cancel-closes-transport-and-drops-late-update ()
  "ACP cancellation should make late session updates unable to edit the buffer."
  (let* ((process (start-process "ellm-acp-cancel-test" nil "sleep" "10"))
         (connection
          (ellm-acp-connection
           :name "test" :process process :buffer (current-buffer))))
    (unwind-protect
        (with-temp-buffer
          (ellm-mode)
          (setf (ellm-acp--connection-buffer connection) (current-buffer)
                (ellm-acp--connection-session-id connection) "session-1")
          (let* ((driver
                  (ellm-acp--make-request
                   :connection connection))
                 (request
                   (ellm--make-request
                    :buffer (current-buffer) :backend driver
                    :generation ellm--request-generation)))
            (setf (ellm-acp--connection-current-request connection) driver)
            (ellm--insert-turn "assistant")
            (ellm--set-active-request request)
            (ellm-cancel t)
            (should-not (jsonrpc-running-p connection))
            (let ((cancelled-buffer (buffer-string)))
              (ellm-acp--dispatch-notification
               connection 'session/update
               '(:sessionId "session-1"
                 :update
                 (:sessionUpdate "agent_message_chunk"
                  :content (:type "text" :text "late"))))
              (should (equal (buffer-string) cancelled-buffer)))
            (should (equal
                     (ellm-turn-role (car (last (ellm--parse-turns))))
                     "user"))))
      (when (process-live-p process)
        (delete-process process)))))

(ert-deftest ellm-test-switch-to-subagent-buffer ()
  "Subagent switching should offer direct children or all descendants."
  (let ((root (generate-new-buffer " *ellm-test-root*"))
        (child (generate-new-buffer " *ellm-test-child*"))
        (sibling (generate-new-buffer " *ellm-test-sibling*"))
        (grandchild (generate-new-buffer " *ellm-test-grandchild*"))
        (unrelated (generate-new-buffer " *ellm-test-unrelated*"))
        offered
        switched)
    (unwind-protect
        (progn
          (with-current-buffer child
            (setq-local ellm-subagent-parent-buffer (buffer-name root)))
          (with-current-buffer sibling
            (setq-local ellm-subagent-parent-buffer (buffer-name root)))
          (with-current-buffer grandchild
            (setq-local ellm-subagent-parent-buffer (buffer-name child)))
          (with-current-buffer root
            (cl-letf (((symbol-function 'read-buffer)
                       (lambda (_prompt _default require-match predicate)
                         (should require-match)
                         (setq offered
                               (cl-remove-if-not predicate
                                                 (mapcar #'buffer-name
                                                         (buffer-list))))
                         (buffer-name child)))
                      ((symbol-function 'switch-to-buffer)
                       (lambda (buffer-or-name &rest _)
                         (setq switched (get-buffer buffer-or-name)))))
              (ellm-switch-to-subagent-buffer)
              (should (equal (sort (copy-sequence offered) #'string<)
                             (sort (list (buffer-name child)
                                         (buffer-name sibling))
                                   #'string<)))
              (should (eq switched child)))
            (cl-letf (((symbol-function 'read-buffer)
                       (lambda (_prompt _default require-match predicate)
                         (should require-match)
                         (setq offered
                               (cl-remove-if-not predicate
                                                 (mapcar #'buffer-name
                                                         (buffer-list))))
                         (buffer-name grandchild)))
                      ((symbol-function 'switch-to-buffer)
                       (lambda (buffer-or-name &rest _)
                         (setq switched (get-buffer buffer-or-name)))))
              (ellm-switch-to-subagent-buffer t)
              (should (member (buffer-name grandchild) offered))
              (should-not (member (buffer-name unrelated) offered))
              (should (eq switched grandchild)))))
      (mapc (lambda (buffer)
              (when (buffer-live-p buffer)
                (kill-buffer buffer)))
            (list root child sibling grandchild unrelated)))))

(ert-deftest ellm-test-cancelling-request-cancels-descendant-subagents ()
  "Cancelling a request also stops requests owned by descendant subagents."
  (let ((ellm-provider (make-ellm-test-pending-provider))
        (root (generate-new-buffer " *ellm-cancel-root*"))
        (child (generate-new-buffer " *ellm-cancel-child*"))
        (grandchild (generate-new-buffer " *ellm-cancel-grandchild*")))
    (unwind-protect
        (progn
          (dolist (buffer (list root child grandchild))
            (with-current-buffer buffer
              (ellm-mode)
              (ellm--insert-turn "user")
              (insert "Work.\n")
              (ellm-send)))
          (with-current-buffer child
            (setq-local ellm-subagent-parent-buffer (buffer-name root)))
          (with-current-buffer grandchild
            (setq-local ellm-subagent-parent-buffer (buffer-name child)))
          (with-current-buffer root
            (ellm-cancel t))
          (dolist (buffer (list root child grandchild))
            (with-current-buffer buffer
              (should-not ellm--active-request))))
      (dolist (buffer (list root child grandchild))
        (when (buffer-live-p buffer)
          (kill-buffer buffer))))))

(defun ellm-test--frontmatter-capf-at-marker (text)
  "Return the frontmatter CAPF result at the `|' marker in TEXT."
  (with-temp-buffer
    (insert text)
    (goto-char (point-min))
    (search-forward "|")
    (delete-char -1)
    (ellm-mode)
    (ellm--frontmatter-capf)))

(ert-deftest ellm-test-frontmatter-profile-definition-completion ()
  "Local profile definitions should complete ordinary profile settings."
  (let ((candidates
         (nth 2 (ellm-test--frontmatter-capf-at-marker
                 "---\nprofiles:\n  reviewer:\n    |\n---\n"))))
    (should (member "system" candidates))
    (should (member "tools" candidates))
    (should (member "acp" candidates))))

(ert-deftest ellm-test-frontmatter-inline-mcp-completion ()
  "Inline MCP maps should complete server keys and transport values."
  (should (member "command"
                  (nth 2 (ellm-test--frontmatter-capf-at-marker
                          "---\nmcp:\n  - |\n---\n"))))
  (should (equal '("http" "sse")
                 (nth 2 (ellm-test--frontmatter-capf-at-marker
                         "---\nmcp:\n  - type: |\n---\n")))))

(ert-deftest ellm-test-frontmatter-directory-completion ()
  "Directory-valued fields should delegate to file-name completion."
  (dolist (text '("---\ncwd: /tm|\n---\n"
                  "---\nacp:\n  additional-directories:\n    - /tm|\n---\n"))
    (should (eq #'completion-file-name-table
                (nth 2 (ellm-test--frontmatter-capf-at-marker text))))))

(ert-deftest ellm-test-frontmatter-tools-and-mcp-scalar-completion ()
  "Frontmatter completion should offer the supported scalar resource modes."
  (dolist (case '(("tools" . "true") ("mcp" . "false")))
    (with-temp-buffer
      (insert (format "---\n%s: |\n---\n" (car case)))
      (goto-char (point-min))
      (search-forward "|")
      (delete-char -1)
      (ellm-mode)
      (should (member (cdr case) (nth 2 (ellm--frontmatter-capf)))))))

(ert-deftest ellm-test-frontmatter-tool-selector-completion ()
  "`tools+' and `tools-' should complete tool names and categories."
  (let ((ellm-tools-list
         (list (ellm-make-tool :name "edit" :category "files"))))
    (dolist (text '("---\ntools+: [ed|]\n---\n"
                    "---\ntools-:\n  - ed|\n---\n"))
      (let ((candidates
             (nth 2 (ellm-test--frontmatter-capf-at-marker text))))
        (should (member "edit" candidates))
        (should (member "@files" candidates))))))

(ert-deftest ellm-test-frontmatter-tool-permission-completion ()
  "Tool permission maps should complete tool and quoted category keys."
  (let ((ellm-tools-list
         (list (ellm-make-tool :name "edit" :category "files")
               (ellm-make-tool :name "grep" :category "files"))))
    (let ((keys (nth 2 (ellm-test--frontmatter-capf-at-marker
                        "---\ntool-permissions:\n  |\n---\n"))))
      (should (member "default" keys))
      (should (member "edit" keys))
      (should (member "\"@files\"" keys))
      (should (member "\"@acp/execute\"" keys))
      (should (member "\"@files\""
                      (nth 2 (ellm-test--frontmatter-capf-at-marker
                              "---\ntool-permissions:\n  \"@fi|\n---\n")))))
    (should (equal
             (nth 2 (ellm-test--frontmatter-capf-at-marker
                     "---\ntool-permissions:\n  \"@files\": |\n---\n"))
             '("allow" "ask" "deny")))))

(ert-deftest ellm-test-frontmatter-profile-completion ()
  "`profile:' completion should include names from `ellm-profiles'."
  (let ((ellm-profiles
         '((reviewer . ((description . "Reviews changes.")
                         (model . "review-model")
                         (system . "Review the current change.")
                         (tools . ("read" "grep"))))
           (writer . ((model . "write-model"))))))
    (with-temp-buffer
      (insert "---\nprofile: |\n---\n")
      (goto-char (point-min))
      (search-forward "|")
      (delete-char -1)
      (ellm-mode)
      (let* ((capf (ellm--frontmatter-capf))
             (candidates (nth 2 capf))
             (doc-fn (plist-get (nthcdr 3 capf) :company-doc-buffer))
             (documentation
              (with-current-buffer (funcall doc-fn "reviewer")
                (buffer-string))))
        (should (member "reviewer" candidates))
        (should (member "writer" candidates))
        (should (string-match-p "Description:\nReviews changes" documentation))
        (should (string-match-p "Enabled tools: read, grep" documentation))
        (should (string-match-p
                 "System prompt:\nReview the current change" documentation))))))

(ert-deftest ellm-test-profiles-local-entries-overlay-global ()
  "Local profile entries should recursively overlay `ellm-profiles'."
  (let ((ellm-profiles
         '((reviewer . ((model . "global-model")
                         (tools . ("@files"))
                         (acp . ((config . ((effort . "low")))))
                         (system . "Global child"))))))
    (with-temp-buffer
      (insert "---\nprofile: reviewer\nprofiles:\n  reviewer:\n    system: Local child\n    acp:\n      config:\n        effort: high\n---\n")
      (ellm-mode)
      (let ((fm (ellm--effective-frontmatter)))
        (should (equal (alist-get 'model fm) "global-model"))
        (should (equal (alist-get 'tools fm) '("@files")))
        (should (equal (alist-get 'system fm) "Local child"))
        (should (equal (ellm--alist-get-nested fm '(acp config effort)) "high"))
        (should-not (alist-get 'profile fm))
        (should-not (alist-get 'profiles fm))))))

(ert-deftest ellm-test-profile-selector-overlays-extend-and-exclude-resources ()
  "Selector overlays extend profiles and exclude resolved category members."
  (let* ((read (ellm-make-tool :name "read" :category "files"))
         (write (ellm-make-tool :name "write" :category "files"))
         (extra (ellm-make-tool :name "extra"))
         (ellm-tools-list (list read write extra))
         (ellm-mcp-servers
          '((one . (:command "one" :category "local"))
            (two . (:command "two" :category "local"))
            (remote . (:command "remote" :category "remote"))))
         (ellm-profiles
          '((reviewer . ((tools . ("@files"))
                         (mcp . ("@local")))))))
    (with-temp-buffer
      (insert "---\nprofile: reviewer\ntools-: [read]\nmcp-: [one]\nprofiles:\n  reviewer:\n    tools+: [extra]\n    mcp+: [remote]\n---\n")
      (ellm-mode)
      (let ((frontmatter (ellm--effective-frontmatter)))
        (should (equal (alist-get 'tools frontmatter) '("@files" "extra")))
        (should (equal (alist-get 'tools- frontmatter) '("read")))
        (should (equal (mapcar #'ellm-tool-name
                               (ellm--resolve-tools frontmatter))
                       '("extra" "write")))
        (should (equal (mapcar #'car (ellm--resolve-mcp-servers frontmatter))
                       '(two remote)))))))

(ert-deftest ellm-test-selector-replacement-resets-earlier-overlays ()
  "An ordinary selector value resets inherited additions and exclusions."
  (let ((ellm-profiles '((reviewer . ((tools . ("one"))
                                      (tools+ . ("two"))
                                      (tools- . ("one")))))))
    (with-temp-buffer
      (insert "---\nprofile: reviewer\ntools: [three]\ntools+: [four]\ntools-: [three]\n---\n")
      (ellm-mode)
      (let ((frontmatter (ellm--effective-frontmatter)))
        (should (equal (alist-get 'tools frontmatter) '("three" "four")))
        (should (equal (alist-get 'tools- frontmatter) '("three")))))))

(ert-deftest ellm-test-subagent-profile-is-child-baseline ()
  "A selected child profile should not inherit parent configuration overrides."
  (let* ((parent-provider (make-ellm-test-sync-provider))
         (explore-provider (make-ellm-test-sync-provider))
         (ellm-provider-alist
          `((parent . (:provider ,parent-provider
                       :models ("parent-model")))
            (explore . (:provider ,explore-provider
                        :models ("explore-model")))))
         (ellm-profiles
          '((explore . ((provider . "explore")
                         (model . "explore-model")
                         (tools . ("read_buffer"))
                         (system . "Explore child")))))
         child-buffer)
    (with-temp-buffer
      (insert "---\nprovider: parent\nmodel: parent-model\ntools: [\"@agents\", read_buffer]\nprofiles:\n  explore:\n    system: Local explore child\n---\n\n")
      (ellm-mode)
      (unwind-protect
          (progn
            (ellm-tools/launch-subagent-tool "Explore." "explore" "worker" nil)
            (setq child-buffer
                  (get-buffer (plist-get (car ellm-subagent-history) :buffer-name)))
            (with-current-buffer child-buffer
              (let ((fm (ellm--parse-frontmatter))
                    (effective (ellm--effective-frontmatter)))
                (should (equal (alist-get 'profile fm) "explore"))
                (should-not (alist-get 'provider fm))
                (should-not (alist-get 'tools fm))
                (should-not (alist-get 'mcp fm))
                (should-not (alist-get 'tool-permissions fm))
                (should (equal (alist-get 'provider effective) "explore"))
                (should (equal (alist-get 'model effective) "explore-model"))
                (should (equal (alist-get 'system effective) "Local explore child"))
                (should (equal (alist-get 'tools effective)
                               '("read_buffer"))))))
        (when (buffer-live-p child-buffer)
          (kill-buffer child-buffer))))))

(ert-deftest ellm-test-subagent-sanitization-removes-session-state ()
  "A child must not inherit provider-specific session state."
  (let ((frontmatter
         (ellm-tools--sanitize-subagent-frontmatter
          '((ellm . ((session-id . "ellm-session") (role . "main")))
            (codex . ((prompt-cache-key . "cache-key") (cache . t)))
            (acp . ((session-id . "acp-session") (title . "Title")))
            (provider . "codex")))))
    ;; The ellm session id identifies this child as part of its persisted
    ;; session tree; unlike provider session state, it must be inherited.
    (should (equal (ellm--alist-get-nested frontmatter '(ellm session-id))
                   "ellm-session"))
    (should-not (ellm--alist-get-nested frontmatter '(ellm role)))
    (should-not (ellm--alist-get-nested frontmatter '(codex prompt-cache-key)))
    (should (eq (ellm--alist-get-nested frontmatter '(codex cache)) t))
    (should-not (ellm--alist-get-nested frontmatter '(acp session-id)))
    (should (equal (alist-get 'provider frontmatter) "codex"))))

(ert-deftest ellm-test-subagent-capabilities-do-not-exceed-parent ()
  "A selected child profile receives only restrictions beyond its parent."
  (let* ((provider (make-ellm-test-sync-provider))
         (ellm-provider provider)
         (ellm-subagent-max-depth nil)
         (ellm-mcp-servers
          '((parent . (:command "parent"))
            (extra . (:command "extra"))))
         child)
    (with-temp-buffer
      (insert (concat
               "---\n"
               "tools: [read, launch_subagent]\n"
               "mcp: [parent]\n"
               "tool-permissions:\n  read: ask\n"
               "profiles:\n  child:\n    tools: [read, edit, launch_subagent]\n"
               "    mcp: [parent, extra]\n"
               "    tool-permissions:\n      read: allow\n"
               "---\n\n"))
      (ellm-mode)
      (unwind-protect
          (progn
            (ellm-tools--launch-subagent "Work." "child" nil nil)
            (setq child
                  (get-buffer (plist-get (car ellm-subagent-history) :buffer-name)))
            (with-current-buffer child
              (let ((raw (ellm--parse-frontmatter))
                    (frontmatter (ellm--effective-frontmatter)))
                ;; Keep the selected profile intact; persist only its deltas
                ;; from the parent's capabilities.
                (should (equal (alist-get 'profile raw) "child"))
                (should-not (alist-get 'tools raw))
                (should-not (alist-get 'mcp raw))
                (should (equal (alist-get 'tools- raw) '("edit")))
                (should (equal (alist-get 'mcp- raw) '("extra")))
                (should (equal (alist-get 'tool-permissions raw)
                               '((read . "ask"))))
                (should (equal (sort (mapcar #'ellm-tool-name
                                      (ellm--resolve-tools frontmatter))
                                     #'string<)
                               '("launch_subagent" "read")))
                (should (eq (ellm--tool-permission-policy
                             frontmatter
                             (cl-find "read"
                                      (ellm--resolve-tools frontmatter)
                                      :key #'ellm-tool-name :test #'equal))
                            'ask))
                (should (equal (mapcar #'car (ellm--resolve-mcp-servers frontmatter))
                               '(parent))))))
        (when (buffer-live-p child) (kill-buffer child))))))

(ert-deftest ellm-test-subagent-max-depth-removes-launch-tool ()
  "A child at the depth limit cannot receive `launch_subagent'."
  (let* ((provider (make-ellm-test-sync-provider))
         (ellm-provider provider)
         (ellm-subagent-max-depth 2)
         child grandchild)
    (with-temp-buffer
      (insert "---\ntools: [launch_subagent]\n---\n\n")
      (ellm-mode)
      (unwind-protect
          (progn
            (ellm-tools--launch-subagent "Delegate." nil nil nil)
            (setq child
                  (get-buffer (plist-get (car ellm-subagent-history) :buffer-name)))
            (with-current-buffer child
              (should (ellm-tool-enabled-p "launch_subagent"
                                           (ellm--effective-frontmatter)))
              (ellm-tools--launch-subagent "Delegate again." nil nil nil)
              (setq grandchild
                    (get-buffer (plist-get (car ellm-subagent-history) :buffer-name))))
            (with-current-buffer grandchild
              (let ((frontmatter (ellm--parse-frontmatter)))
                (should (= (ellm--alist-get-nested frontmatter '(subagent depth)) 2))
                (should-not (ellm-tool-enabled-p
                             "launch_subagent"
                             (ellm--effective-frontmatter)))
                (should (member "@agents"
                                (alist-get 'tools- frontmatter))))))
        (dolist (buffer (list grandchild child))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest ellm-test-subagent-depth-limit-exclusion-without-agent-tools ()
  "An agent exclusion is harmless when no agent tool is enabled."
  (let* ((frontmatter '((tools . ("read"))))
         (disabled (ellm-tools--disable-subagent-tools frontmatter)))
    (should (equal (alist-get 'tools- disabled) '("@agents")))
    (should (equal (mapcar #'ellm-tool-name (ellm--resolve-tools disabled))
                   '("read")))))

(ert-deftest ellm-test-subagent-profile-provider-overrides-parent-fallback ()
  "A selected profile's provider should win over the parent provider.
The parent provider remains buffer-local fallback only when the profile omits one."
  (let* ((parent-provider (make-ellm-test-sync-provider))
         (child-provider (make-ellm-test-sync-provider))
         (ellm-provider-alist
          `((parent . (:provider ,parent-provider :models ("parent-model")))
            (child . (:provider ,child-provider :models ("child-model")))))
         (ellm-profiles
          '((worker . ((provider . "child")
                        (model . "child-model")))))
         child-buffer)
    (with-temp-buffer
      (insert "---\nprovider: parent\nmodel: parent-model\n---\n\n")
      (ellm-mode)
      (unwind-protect
          (progn
            (ellm-tools/launch-subagent-tool "Work." "worker" nil nil)
            (setq child-buffer
                  (get-buffer (plist-get (car ellm-subagent-history) :buffer-name)))
            (with-current-buffer child-buffer
              (let ((effective (ellm--effective-frontmatter)))
                (should (equal (alist-get 'provider effective) "child"))
                (should (eq (ellm--resolve-provider effective) child-provider)))))
        (when (buffer-live-p child-buffer) (kill-buffer child-buffer))))))

(ert-deftest ellm-test-subagent-profile-inherits-parent-provider-fallback ()
  "A profile without a provider should use its parent's resolved provider."
  (let* ((parent-provider (make-ellm-test-sync-provider))
         (ellm-provider nil)
         (ellm-provider-alist
          `((parent . (:provider ,parent-provider :models ("parent-model")))))
         (ellm-profiles
          '((explore . ((system . "Explore independently")))))
