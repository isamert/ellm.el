(ert-deftest ellm-test-set-config-resolves-profile-provider ()
  "`ellm-set-config' should resolve a provider supplied by the active profile."
  (let* ((provider (make-ellm-test-sync-provider))
         (ellm-provider-alist `((profiled . (:provider ,provider))))
         (ellm-profiles '((default . ((provider . "profiled"))))))
    (with-temp-buffer
      (insert "---\nprofile: default\n---\n\n")
      (ellm-mode)
      (cl-letf (((symbol-function 'ellm--config-settings)
                 (lambda (_provider _buffer _remove)
                   (list (list :path '(temperature) :spec '(:type number)
                               :effect 'next-send))))
                ((symbol-function 'completing-read)
                 (lambda (_prompt collection &rest _)
                   (caar collection)))
                ((symbol-function 'y-or-n-p)
                 (lambda (&rest _) nil))
                ((symbol-function 'read-number)
                 (lambda (&rest _) 0.25)))
        (ellm-set-config)
        (should (= (ellm--frontmatter-value 'temperature) 0.25))))))

(ert-deftest ellm-test-command-frontmatter-resolves-profile ()
