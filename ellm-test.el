    (unwind-protect
        (let ((default-directory root))
          (setq first (ellm-dwim))
          (setq second (ellm-dwim t))
          (should (buffer-live-p first))
          (should (buffer-live-p second))
          (should-not (eq first second)))
      (dolist (buffer (list first second))
        (when (buffer-live-p buffer)
          (set-buffer-modified-p nil)
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest ellm-test-toggle-side-window-switches-from-focused-ellm-buffer ()
  "A focused ellm buffer should offer other project conversations."
  (let* ((root (file-name-as-directory (make-temp-file "ellm-side-" t)))
         (ellm-current-project-function (lambda () root))
         (ellm-provider-alist `((test . ,(make-ellm-test-sync-provider))))
         first second prompt result)
    (unwind-protect
        (let ((default-directory root))
          (setq first (ellm-new-buffer))
          (setq second (ellm-new-buffer))
          (switch-to-buffer first)
          (cl-letf (((symbol-function 'read-buffer)
                     (lambda (asked-prompt initial-input require-match predicate)
                       (setq prompt asked-prompt)
                       (should-not initial-input)
                       (should require-match)
                       (should (funcall predicate (buffer-name second)))
                       (should-not (funcall predicate (buffer-name first)))
                       (buffer-name second))))
            (setq result (ellm-toggle-side-window)))
          (should (equal prompt "Switch to project ellm buffer: "))
          (should (eq result second))
          (should (eq (current-buffer) second)))
      (dolist (buffer (list first second))
        (when (buffer-live-p buffer)
          (set-buffer-modified-p nil)
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest ellm-test-toggle-side-window-focuses-visible-without-prompt ()
  "An unfocused visible project side window should be selected without prompting."
  (let* ((root (file-name-as-directory (make-temp-file "ellm-side-" t)))
         (ellm-current-project-function (lambda () root))
         (ellm-provider-alist `((test . ,(make-ellm-test-sync-provider))))
