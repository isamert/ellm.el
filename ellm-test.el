(ert-deftest ellm-test-acp-resumes-saved-session-with-mcp ()
  "Fresh ACP connections should prefer session/resume for saved sessions."
  (let ((agent-file
         (ellm-test--make-python-agent
          "import json, sys\n"
          "restored = 'none'\n"
          "for line in sys.stdin:\n"
          "    msg = json.loads(line)\n"
          "    mid = msg.get('id')\n"
          "    method = msg.get('method')\n"
          "    if method == 'initialize':\n"
          "        out = {'jsonrpc':'2.0','id':mid,'result':{'protocolVersion':1,'agentCapabilities':{'loadSession':True,'sessionCapabilities':{'resume':{},'additionalDirectories':{}},'mcpCapabilities':{'http':True}}}}\n"
          "    elif method == 'session/resume':\n"
          "        params = msg['params']\n"
          "        mcp = params.get('mcpServers', [{}])[0]\n"
          "        env = mcp.get('env', [{}])[0]\n"
          "        ok = params.get('sessionId') == 'saved' and params.get('additionalDirectories') == ['/tmp/ellm-extra'] and mcp.get('name') == 'fs' and env.get('name') == 'FOO' and env.get('value') == 'bar'\n"
          "        restored = 'resume ok' if ok else 'resume bad ' + json.dumps(params, sort_keys=True)\n"
          "        out = {'jsonrpc':'2.0','id':mid,'result':{}}\n"
          "    elif method == 'session/load':\n"
          "        restored = 'load called'\n"
          "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32000,'message':'session/load should not be called'}}\n"
          "    elif method == 'session/prompt':\n"
          "        text = msg['params']['prompt'][0]['text']\n"
          "        print(json.dumps({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':'saved','update':{'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':restored + ': ' + text}}}}), flush=True)\n"
          "        out = {'jsonrpc':'2.0','id':mid,'result':{'stopReason':'end_turn'}}\n"
          "    else:\n"
          "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32601,'message':'unknown'}}\n"
          "    print(json.dumps(out), flush=True)\n")))
    (unwind-protect
        (let ((ellm-provider (ellm-make-acp-provider
                              :command "python3"
                              :args (list agent-file)))
              (ellm-mcp-servers
               '(("fs" . (:command "python3" :args ("-m" "fake")
                           :env (:FOO "bar"))))))
          (with-temp-buffer
            (insert "---\nacp:\n  session-id: saved\n  additional-directories:\n    - /tmp/ellm-extra\nmcp: [fs]\n---\n\n")
            (ellm-mode)
            (ellm--insert-turn "user")
            (insert "new prompt\n")
            (ellm-send)
            (ellm-test--wait-for-request)
            (when ellm-acp--connection
              (delete-process (ellm-acp--connection-process ellm-acp--connection)))
            (should (string-match-p "resume ok: new prompt" (buffer-string)))))
      (delete-file agent-file))))

(ert-deftest ellm-test-acp-load-fallback-replays-user-and-preserves-prompt ()
