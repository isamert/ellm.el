(ert-deftest ellm-test-system-prompt-interpolation-memoizes-templates ()
  "Distinct initial and mid-conversation templates should cache separately."
  (let ((provider (make-llm-fake))
        (ellm-prompt-interpolation-policy 'allow)
        (ellm-test--prompt-interpolation-count 0))
    (with-temp-buffer
      (insert
       ">-| system\n"
       "Initial #{(cl-incf ellm-test--prompt-interpolation-count)}\n"
       ">-| user\nQuestion\n"
       ">-| assistant\nAnswer\n"
       ">-| system\n"
       "Later #{(cl-incf ellm-test--prompt-interpolation-count)}\n"
       ">-| user\nContinue\n")
      (ellm-mode)
      (let ((prompt (ellm-llm--parse-buffer-as-chat provider nil)))
        (should (equal (llm-chat-prompt-context prompt) "Initial 1"))
        (should
         (equal
          (mapcar #'llm-chat-prompt-interaction-role
                  (llm-chat-prompt-interactions prompt))
          '(user assistant system user)))
        (should
         (equal
          (mapcar #'llm-chat-prompt-interaction-content
                  (llm-chat-prompt-interactions prompt))
          '("Question" "Answer" "Later 2" "Continue"))))
      (ellm-llm--parse-buffer-as-chat provider nil)
      (should (= ellm-test--prompt-interpolation-count 2))
      (goto-char (point-min))
      (search-forward
       "Later #{(cl-incf ellm-test--prompt-interpolation-count)}")
      (insert " changed")
      (let ((prompt (ellm-llm--parse-buffer-as-chat provider nil)))
        (should (equal (llm-chat-prompt-context prompt) "Initial 1"))
        (should
         (equal
          (mapcar #'llm-chat-prompt-interaction-content
                  (llm-chat-prompt-interactions prompt))
          '("Question" "Answer" "Later 3 changed" "Continue"))))
      (should (= ellm-test--prompt-interpolation-count 3))
      (ellm-refresh-system-prompts)
      (let ((prompt (ellm-llm--parse-buffer-as-chat provider nil)))
        (should (equal (llm-chat-prompt-context prompt) "Initial 4"))
        (should
         (equal
          (mapcar #'llm-chat-prompt-interaction-content
                  (llm-chat-prompt-interactions prompt))
          '("Question" "Answer" "Later 5 changed" "Continue"))))
      (should (= ellm-test--prompt-interpolation-count 5)))))

