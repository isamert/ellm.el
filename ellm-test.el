      (should-error (insert "accidental edit") :type 'buffer-read-only)
      (ellm-cancel t)
      (should-not ellm--active-request)
      (should-not buffer-read-only)
      (should (equal (ellm-turn-role (car (last (ellm--parse-turns))))
                     "user")))))

(ert-deftest ellm-test-cancelled-llm-request-ignores-late-callbacks ()
  "Cancellation should make every callback from the old request inert."
  (let ((ellm-provider (make-llm-claude :key "test" :chat-model "test"))
        partial final failure)
    (with-temp-buffer
      (ellm-mode)
      (ellm--insert-turn "user")
      (insert "hi\n")
      (cl-letf (((symbol-function 'llm-chat-streaming)
                 (lambda (_provider _prompt on-partial on-final on-error
                                    &optional _multi-output)
                   (setq partial on-partial
                         final on-final
                         failure on-error)
                   nil)))
        (ellm-send)
        (ellm-cancel t)
        (let ((cancelled-buffer (buffer-string)))
          (funcall partial '(:text "late partial"))
          (funcall final '(:text "late final"))
          (funcall failure 'llm-request-error "late error")
          (should (equal (buffer-string) cancelled-buffer))))
      (should-not ellm--active-request)
      (should (equal (ellm-turn-role (car (last (ellm--parse-turns))))
                     "user")))))

(ert-deftest ellm-test-llm-request-timeout-restarts-after-response ()
  "An active llm.el stream should restart ellm's inactivity timeout."
  (let ((ellm-provider (make-llm-claude :key "test" :chat-model "test"))
        (ellm-request-timeout 60)
        (llm-request-plz-timeout 123)
        observed-plz-timeout initial-timer)
    (with-temp-buffer
      (ellm-mode)
      (ellm--insert-turn "user")
      (insert "hi\n")
      (cl-letf (((symbol-function 'llm-chat-streaming)
                 (lambda (_provider _prompt partial _final _error
                                    &optional _multi-output)
                   (setq observed-plz-timeout llm-request-plz-timeout
                         initial-timer
                         (ellm-request-idle-timer ellm--active-request))
                   (funcall partial '(:text "streaming"))
                   nil)))
        (ellm-send)
        (should (timerp initial-timer))
        (should (timerp (ellm-request-idle-timer ellm--active-request)))
        (should-not (eq initial-timer
                        (ellm-request-idle-timer ellm--active-request)))
        (should (= observed-plz-timeout 123))
        (ellm-cancel t)))))

(ert-deftest ellm-test-llm-tool-activity-heartbeat-outlives-request-idle-timeout ()
  "An executing llm.el tool keeps the provider-idle watchdog alive."
  (let ((ellm-request-timeout 0.02)
        (events nil)
        completed)
    (with-temp-buffer
      (ellm-mode)
      (let* ((tool (llm-make-tool
                    :name "test"
                    :description "test"
                    :args nil :async t
                    :function
                    (lambda (callback)
                      (run-at-time 0.08 nil
                                   (lambda () (funcall callback "done"))))))
             (prompt (make-llm-chat-prompt :tools (list tool)))
             (driver (ellm-llm--make-driver
                      :buffer (current-buffer) :prompt prompt
                      :emit (lambda (event) (push event events)))))
        (ellm-llm--instrument-tool-activity driver)
        (funcall (llm-tool-function tool)
                 (lambda (result) (setq completed result)))
        (should (ellm-test--wait-for (lambda () completed) 0.2))
        (should (equal completed "done"))
        (should (>= (length events) 2))
        (should-not (ellm-llm-driver-tool-activity-timers driver))))))

(ert-deftest ellm-test-llm-tool-runtime-does-not-trigger-request-idle-timeout ()
  "A long llm.el tool run is governed by its tool timeout, not the request idle timeout."
  (let ((ellm-provider (make-llm-claude :key "test" :chat-model "test"))
        (ellm-request-timeout 0.02)
        (ellm-llm-generate-title nil)
        (ellm-tools-list ellm-tools-list)
        (ellm-tools-refs ellm-tools-refs)
        outcome (calls 0))
    (ellm-deftool test/e2e-idle (:async t :timeout nil) ()
      "Complete after the request idle timeout."
      (run-at-time 0.08 nil (lambda () (funcall callback "tool result"))))
    (with-temp-buffer
      (ellm-mode)
      (setq-local ellm-request-finished-hook
                  (list (lambda (_request value) (setq outcome value))))
      (insert "---\ntools: [e2e_idle]\n---\n\n>-| user\nrun it\n")
      (cl-letf (((symbol-function 'llm-chat-streaming)
                 (lambda (_provider prompt _partial final _error
                                    &optional _multi-output)
                   (if (= (cl-incf calls) 1)
                       (let ((tool (car (llm-chat-prompt-tools prompt))))
                         (funcall
                          (llm-tool-function tool)
                          (lambda (result)
                            (funcall final
                                     `(:tool-uses ((:name "e2e_idle" :args nil))
                                       :tool-results ((e2e_idle . ,result)))))))
                     (funcall final '(:text "finished")))
                   nil)))
        (ellm-send)
        (should (ellm-test--wait-for
                 (lambda () (not ellm--active-request)) 0.3)))
      (should (= calls 2))
      (should (eq (plist-get outcome :state) 'completed))
      (should (string-match-p "finished" (buffer-string))))))

(ert-deftest ellm-test-llm-request-retries-transient-error-internally ()
  "A transient llm.el failure should retry without caller bookkeeping."
  (let ((ellm-provider (make-llm-claude :key "test" :chat-model "test"))
