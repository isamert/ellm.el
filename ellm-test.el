(ert-deftest ellm-test-reasoning-state-round-trip ()
  "Opaque reasoning state should use validated private cache files."
  (let* ((root (make-temp-file "ellm-reasoning-state-" t))
         (ellm-cache-directory root)
         (state '(:version 1 :provider "test"
                  :item (:type "reasoning" :encrypted_content "secret"
                         :summary [(:type "summary_text" :text "Visible")]))))
    (unwind-protect
        (with-temp-buffer
          (ellm-mode)
          (let* ((id (ellm-reasoning-state-write state))
                 (path (ellm--reasoning-state-path id t)))
            (should (string-match-p ellm--reasoning-state-id-regexp id))
            (should (equal (ellm-reasoning-state-read id) state))
            (should (= (file-modes path) #o600))
            (should (= (file-modes (file-name-directory path)) #o700))
            (with-temp-file path
              (insert "{}"))
            (should-not (ellm-reasoning-state-read id))))
      (delete-directory root t))))

(ert-deftest ellm-test-reasoning-state-localizes-when-session-persists ()
  "A cached sidecar should move into a session when persistence starts."
  (let* ((root (make-temp-file "ellm-reasoning-localize-" t))
         (ellm-cache-directory (expand-file-name "cache/" root))
         (session (expand-file-name "session/" root))
         (state '(:version 1 :provider "test" :item (:opaque "secret"))))
    (unwind-protect
        (with-temp-buffer
          (ellm-mode)
          (let ((id (ellm-reasoning-state-write state)))
            (insert (ellm--get-turn
                     "reasoning" :continuation t :reasoning-state id)
                    "\nsummary\n")
