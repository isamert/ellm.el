(ert-deftest ellm-test-tools-websearch-parses-duckduckgo-html ()
  "DuckDuckGo HTML parser should extract title, URL and snippet."
  (let* ((html (concat
                "<html><body>"
                "<div class=\"result results_links\">"
                "<a class=\"result__a\" href=\"//duckduckgo.com/l/?uddg=https%3A%2F%2Fexample.com%2Fa%3Fx%3D1&amp;rut=abc\">"
                "Example &amp; Title</a>"
                "<a class=\"result__snippet\">Snippet &lt;one&gt;</a>"
                "</div>"
                "<div class=\"result results_links\">"
                "<a class=\"result__a\" href=\"https://example.org/\">Second</a>"
                "</div>"
                "</body></html>"))
         (results (ellm-tools--parse-duckduckgo-html html 1))
         (formatted (ellm-tools--format-websearch-results "example" results)))
    (should (= (length results) 1))
    (should (equal (plist-get (car results) :title) "Example & Title"))
    (should (equal (plist-get (car results) :url) "https://example.com/a?x=1"))
    (should (equal (plist-get (car results) :snippet) "Snippet <one>"))
    (should (string-match-p "<websearch" formatted))
    (should (string-match-p "Example & Title" formatted))))

(ert-deftest ellm-test-tools-search-buffer-zero-length-regexp-progresses ()
