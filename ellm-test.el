  (let ((provider (make-llm-claude :key "test" :chat-model "test")))
    (with-temp-buffer
      (insert ">-| user\nRun pwd.\n"
              ">-| assistant\n"
              ">>-| tool-call | Shell :id call_1\n"
              ">>>-| tool-param | command\n"
