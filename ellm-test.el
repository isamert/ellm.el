                                 :updatedAt "2026-07-17T12:00:00Z")))
          (should (equal (buffer-name) "*ellm: Backend title*"))
          (should (equal (ellm--frontmatter-value '(title)) "Backend title"))
          (should (equal (ellm--frontmatter-value '(acp updated-at))
                         "2026-07-17T12:00:00Z")))
      (when (jsonrpc-running-p connection)
        (jsonrpc-shutdown connection)))))

(ert-deftest ellm-test-acp-completion-session-ignores-session-info-metadata ()
