(defun ellm-test--render-core-snapshot
    (buffer _backend-request start end result &optional reasoning-state-id)
  "Render RESULT through the core snapshot path between START and END."
  (with-current-buffer buffer
    (let* ((streams (make-hash-table :test #'equal))
           (request (ellm--make-request :buffer buffer :streams streams)))
      (puthash 'test
               (ellm--make-stream-region :start start :end end)
               streams)
      (ellm--preserve-user-position
        (ellm--request-render-snapshot
         request
         `(:type stream :mode snapshot :id test
           :channels ((reasoning . ,(plist-get result :reasoning))
                      (assistant . ,(plist-get result :text)))
           :reasoning-state ,reasoning-state-id))))))

(ert-deftest ellm-test-llm-streaming-preserves-point ()
  "llm.el streaming insertion should not move user point."
  (with-temp-buffer
    (insert "intro\n")
    (ellm-mode)
      (let ((start (copy-marker (point-max) nil))
            (end (copy-marker (point-max) t)))
        (goto-char (point-min))
        (setq buffer-read-only t)
        (ellm-test--render-core-snapshot
         (current-buffer) nil start end '(:text "hello"))
        (should (= (point) (point-min)))
         (should buffer-read-only)
         (should (string-match-p "hello" (buffer-string))))))

(ert-deftest ellm-test-llm-streaming-follows-output-end ()
  "llm.el streaming should follow the live end until point moves away."
  (with-temp-buffer
    (insert "intro\n")
    (ellm-mode)
    (let ((start (copy-marker (point-max) nil))
          (end (copy-marker (point-max) t)))
      (ellm-test--render-core-snapshot
       (current-buffer) nil start end '(:text "hello"))
      (should (= (point) (point-max)))
      ;; End-of-line before the renderer's trailing newline is also the
      ;; natural output end in Emacs.
      (backward-char)
      (ellm-test--render-core-snapshot
       (current-buffer) nil start end '(:text "hello world"))
      (should (= (point) (point-max)))
      (backward-char 2)
      (let ((review-position (point)))
        (ellm-test--render-core-snapshot
         (current-buffer) nil start end '(:text "hello world!"))
        (should (= (point) review-position)))
      (goto-char (point-max))
      (ellm-test--render-core-snapshot
       (current-buffer) nil start end '(:text "hello world!!"))
      (should (= (point) (point-max))))))

(ert-deftest ellm-test-streaming-follow-is-per-window ()
  "Only windows already showing the live end should follow output."
  (let ((buffer (generate-new-buffer " *ellm-follow-test*")))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (switch-to-buffer buffer)
          (dotimes (line 40)
            (insert (format "line %d\n" line)))
          (ellm-mode)
          (let* ((tail-window (selected-window))
                 (review-window (split-window-below))
                 (review-point (point-min))
                 (tail-start (save-excursion
                               (goto-char (point-min))
                               (forward-line 34)
                               (point))))
            (set-window-start tail-window tail-start t)
            (set-window-point tail-window (point-max))
            (set-window-start review-window review-point t)
            (set-window-point review-window review-point)
            (with-current-buffer buffer
              (goto-char (point-max))
              (ellm--preserve-user-position
                (goto-char (point-max))
                (dotimes (line 30)
                  (insert (format "new line %d\n" line))))
              (should (= (point) (point-max)))
              (should (= (window-point tail-window) (point-max)))
              (should (> (window-start tail-window) tail-start))
              (should (= (window-point review-window) review-point))
              (should (= (window-start review-window) review-point)))))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

(ert-deftest ellm-test-llm-streaming-escapes-turn-delimiters ()
  "Generated llm.el text should not become parsed conversation turns."
  (with-temp-buffer
    (ellm-mode)
    (let ((start (copy-marker (point-max) nil))
          (end (copy-marker (point-max) t)))
      (ellm-test--render-core-snapshot
       (current-buffer) nil start end
       '(:text "hello\n>-| user\n\\literal"))
      (let ((contents (buffer-string))
            (turns (ellm--parse-turns)))
        (should (string-match-p (regexp-quote "\n\\>-| user") contents))
        (should (string-match-p (regexp-quote "\n\\\\literal") contents))
        (should (equal (mapcar #'ellm-turn-role turns) '("assistant")))
        (let ((prompt (make-llm-chat-prompt)))
          (ellm-llm--apply-turns-to-prompt nil turns prompt)
          (should (equal
                   (llm-chat-prompt-interaction-content
                    (car (llm-chat-prompt-interactions prompt)))
                   "hello\n>-| user\n\\literal")))))))

(defun ellm-test--make-fake-acp-agent ()
  "Create a temporary Python ACP agent and return its file path."
  (let ((file (make-temp-file "ellm-fake-acp-" nil ".py")))
    (with-temp-file file
      (insert "import json, sys\n"
              "session_id = 'sess_test'\n"
              "for line in sys.stdin:\n"
              "    msg = json.loads(line)\n"
              "    mid = msg.get('id')\n"
              "    method = msg.get('method')\n"
              "    if method == 'initialize':\n"
              "        out = {'jsonrpc':'2.0','id':mid,'result':{'protocolVersion':1,'agentCapabilities':{}}}\n"
              "    elif method == 'session/new':\n"
              "        out = {'jsonrpc':'2.0','id':mid,'result':{'sessionId':session_id}}\n"
               "    elif method == 'session/prompt':\n"
              "        text = msg['params']['prompt'][0]['text']\n"
              "        print(json.dumps({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':session_id,'update':{'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':'hello from acp: ' + text}}}}), flush=True)\n"
              "        out = {'jsonrpc':'2.0','id':mid,'result':{'stopReason':'end_turn'}}\n"
              "    elif method == 'session/cancel':\n"
              "        continue\n"
              "    else:\n"
              "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32601,'message':'unknown'}}\n"
              "    print(json.dumps(out), flush=True)\n"))
    file))

(defun ellm-test--make-python-agent (&rest body)
  "Create a temporary Python ACP agent with BODY strings and return its path."
  (let ((file (make-temp-file "ellm-fake-acp-" nil ".py")))
    (with-temp-file file
      (apply #'insert body))
    file))

(defun ellm-test--make-acp-model-agent ()
  "Create a fake ACP agent that exposes dynamic model config options."
  (ellm-test--make-python-agent
   "import json, sys\n"
   "session_id = 'sess_models'\n"
   "def config():\n"
   "    return [{'id':'model','category':'model','type':'select','currentValue':'small','options':[{'value':'small','name':'Small'},{'value':'large','name':'Large'}]}]\n"
   "for line in sys.stdin:\n"
   "    msg = json.loads(line)\n"
   "    mid = msg.get('id')\n"
   "    method = msg.get('method')\n"
   "    if method == 'initialize':\n"
   "        out = {'jsonrpc':'2.0','id':mid,'result':{'protocolVersion':1,'agentCapabilities':{}}}\n"
   "    elif method == 'session/new':\n"
   "        out = {'jsonrpc':'2.0','id':mid,'result':{'sessionId':session_id,'configOptions':config()}}\n"
   "    elif method == 'session/set_config_option':\n"
   "        out = {'jsonrpc':'2.0','id':mid,'result':{'configOptions':config()}}\n"
   "    elif method == 'session/prompt':\n"
   "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32000,'message':'prompt should not be called'}}\n"
   "    else:\n"
   "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32601,'message':'unknown'}}\n"
   "    print(json.dumps(out), flush=True)\n"))

(defun ellm-test--wait-for-request ()
  "Wait briefly for the current buffer's active ellm request to finish."
  (let ((deadline (+ (float-time) 5)))
    (while (and ellm--active-request
                (< (float-time) deadline))
      (accept-process-output nil 0.05))))

(cl-defstruct ellm-test-sync-provider)

(cl-defstruct ellm-test-sync-driver)

(cl-defmethod ellm-backend-create
  ((_provider ellm-test-sync-provider) _frontmatter _buffer)
  "Create a synchronously completing test driver."
  (make-ellm-test-sync-driver))

(cl-defmethod ellm-backend-start ((_driver ellm-test-sync-driver) emit)
  "Emit a complete synchronous test response."
  (funcall emit
           '(:type stream :mode append :channel assistant :text "done\n"))
  (funcall emit '(:type complete))
  :sync-transport)

(cl-defstruct ellm-test-system-provider)

(cl-defstruct ellm-test-system-driver frontmatter)

(defvar ellm-test--system-frontmatter nil)

(cl-defmethod ellm-provider-config-effect
  ((_provider ellm-test-system-provider) path _buffer)
  "Declare test system prompt support."
  (and (equal path '(system)) 'next-send))

(cl-defmethod ellm-backend-create
  ((_provider ellm-test-system-provider) frontmatter _buffer)
  "Capture FRONTMATTER passed to the test backend."
  (setq ellm-test--system-frontmatter frontmatter)
  (make-ellm-test-system-driver :frontmatter frontmatter))

(cl-defmethod ellm-backend-start ((driver ellm-test-system-driver) emit)
  "Complete the captured system prompt request synchronously."
  (funcall emit '(:type complete))
  driver)

(cl-defstruct ellm-test-pending-provider)

(cl-defstruct ellm-test-pending-request emit cancelled)

(cl-defmethod ellm-backend-create
  ((_provider ellm-test-pending-provider) _frontmatter _buffer)
  "Create a pending test driver."
  (make-ellm-test-pending-request))

(cl-defmethod ellm-backend-start ((request ellm-test-pending-request) emit)
  "Leave a test request active until cancellation."
  (setf (ellm-test-pending-request-emit request) emit)
  :pending-transport)

(cl-defmethod ellm-backend-cancel ((request ellm-test-pending-request))
  "Cancel a pending test request."
  (setf (ellm-test-pending-request-cancelled request) t))

(cl-defstruct ellm-test-retry-provider always-fail)

(cl-defstruct ellm-test-retry-driver (starts 0) always-fail)

(cl-defmethod ellm-backend-create
  ((provider ellm-test-retry-provider) _frontmatter _buffer)
  "Create a scripted retry driver."
  (make-ellm-test-retry-driver
   :always-fail (ellm-test-retry-provider-always-fail provider)))

(cl-defmethod ellm-backend-start ((driver ellm-test-retry-driver) emit)
  "Fail DRIVER's first attempt, then complete unless configured otherwise."
  (let ((attempt (cl-incf (ellm-test-retry-driver-starts driver))))
    (if (or (ellm-test-retry-driver-always-fail driver) (= attempt 1))
        (funcall emit
                 '(:type failure :message "temporary" :retryable t))
      (funcall emit
               '(:type stream :mode append :channel assistant
                 :text "retried\n"))
      (funcall emit '(:type complete))))
  :retry-transport)

(cl-defmethod ellm-backend-cancel ((_driver ellm-test-retry-driver))
  "Cancel a scripted retry driver."
  nil)

(ert-deftest ellm-test-update-session-title-renames-buffer ()
  "The default title handler should gracefully handle missing metadata."
  (let ((ellm-buffer-name-function #'ellm-default-buffer-name)
        (ellm-current-project-function (lambda () "/tmp/example-project/")))
    (with-temp-buffer
      (ellm-update-session-title "Session title")
      (should (equal (buffer-name) "*ellm (example-project): Session title*"))
      (let ((ellm-current-project-function (lambda () nil)))
        (ellm-update-session-title "Standalone"))
      (should (equal (buffer-name) "*ellm: Standalone*"))
      (ellm-update-session-title nil)
      (should (equal (buffer-name) "*ellm: Standalone*"))
      (let ((ellm-buffer-name-function
             (lambda (title) (format "*custom: %s*" title))))
        (ellm-update-session-title "Custom title"))
      (should (equal (buffer-name) "*custom: Custom title*"))
      (let ((ellm-buffer-name-function nil))
        (ellm-update-session-title "Ignored title"))
      (should (equal (buffer-name) "*custom: Custom title*")))))

(ert-deftest ellm-test-disabled-session-titling-skips-llm-title-request ()
  "Disabled session titling must not start an llm.el title request."
  (let ((ellm-llm-generate-title t))
    (with-temp-buffer
      (ellm-mode)
      (setq-local ellm--session-titling-p nil)
      (let ((driver (ellm-llm--make-driver
                     :buffer (current-buffer) :title-prompt "Question")))
        (ellm-llm--start-title-generation driver)
        (should-not (ellm-llm-driver-title-started driver))))))

(ert-deftest ellm-test-persistence-new-and-temp-buffers ()
  "New conversations should persist while temporary ones remain ephemeral."
  (let ((root (make-temp-file "ellm-persistence-" t))
        (ellm-persistence-enabled t)
        (ellm-persistence-location 'global)
        main temp)
    (unwind-protect
        (let ((ellm-persistence-directory root))
          (setq main (ellm-new-buffer))
          (with-current-buffer main
            (should buffer-file-name)
            (should (file-exists-p buffer-file-name))
            (should (equal (file-name-nondirectory buffer-file-name)
                           "main.ellm"))
            (should (equal (ellm--frontmatter-value '(ellm role)) "main"))
            (should (ellm--frontmatter-value '(ellm session-id))))
          (setq temp (ellm-new-temp-buffer))
          (with-current-buffer temp
            (should ellm--persistence-ephemeral-p)
            (should-not buffer-file-name)
            (should-not ellm--session-directory)))
      (dolist (buffer (list temp main))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest ellm-test-dwim-appends-region-to-project-buffer ()
  "`ellm-dwim' should reuse the project conversation and append context."
  (let* ((root (file-name-as-directory (make-temp-file "ellm-dwim-" t)))
         (source (expand-file-name "src/example.el" root))
         (ellm-current-project-function (lambda () root))
         (ellm-provider-alist `((test . ,(make-ellm-test-sync-provider))))
         target)
    (make-directory (file-name-directory source) t)
    (with-temp-file source
      (insert "(message \"hello\")\n(message \"bye\")\n"))
    (unwind-protect
        (let ((default-directory root))
          (setq target (ellm-new-buffer))
          (with-current-buffer (find-file-noselect source)
            (goto-char (point-min))
            (set-mark (point-at-eol))
            (activate-mark)
            (ellm-dwim)
            (should (eq (current-buffer) target)))
          (with-current-buffer target
            (should (string-match-p
                     (regexp-quote "``` emacs-lisp src/example.el:1:1\n(message \"hello\")\n```")
                     (buffer-string)))))
      (dolist (buffer (list target (get-file-buffer source)))
        (when (buffer-live-p buffer)
          (set-buffer-modified-p nil)
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest ellm-test-dwim-prefix-creates-new-project-buffer ()
  "A prefix argument to `ellm-dwim' should force a fresh conversation."
  (let* ((root (file-name-as-directory (make-temp-file "ellm-dwim-new-" t)))
