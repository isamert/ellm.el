          "import json, sys\n"
          "for line in sys.stdin:\n"
          "    msg = json.loads(line)\n"
          "    mid = msg.get('id')\n"
          "    method = msg.get('method')\n"
          "    if method == 'initialize':\n"
          "        out = {'jsonrpc':'2.0','id':mid,'result':{'protocolVersion':1,'agentCapabilities':{'loadSession':True}}}\n"
          "    elif method == 'session/load':\n"
          "        sid = msg['params']['sessionId']\n"
          "        updates = [\n"
          "            {'sessionUpdate':'user_message_chunk','content':{'type':'text','text':'REPLAYED OLD QUESTION'}},\n"
          "            {'sessionUpdate':'agent_thought_chunk','content':{'type':'text','text':'REPLAYED OLD THOUGHT'}},\n"
          "            {'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':'REPLAYED OLD ANSWER'}},\n"
          "            {'sessionUpdate':'tool_call','toolCallId':'old_call','title':'REPLAYED TOOL'},\n"
          "            {'sessionUpdate':'tool_call_update','toolCallId':'old_call','status':'completed','rawOutput':{'output':'REPLAYED TOOL OUTPUT'}},\n"
          "            {'sessionUpdate':'plan','entries':[{'status':'completed','priority':'high','content':'REPLAYED PLAN'}]},\n"
          "            {'sessionUpdate':'session_info_update','title':'Restored title'}]\n"
          "        for update in updates:\n"
          "            print(json.dumps({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':sid,'update':update}}), flush=True)\n"
          "        out = {'jsonrpc':'2.0','id':mid,'result':{}}\n"
          "    elif method == 'session/prompt':\n"
          "        text = msg['params']['prompt'][0]['text']\n"
          "        print(json.dumps({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':'saved','update':{'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':'LIVE ' + text}}}}), flush=True)\n"
          "        out = {'jsonrpc':'2.0','id':mid,'result':{'stopReason':'end_turn'}}\n"
          "    else:\n"
          "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32601,'message':'unknown'}}\n"
          "    print(json.dumps(out), flush=True)\n")))
    (unwind-protect
        (let ((ellm-provider
               (ellm-make-acp-provider
                :command "python3" :args (list agent-file))))
          (with-temp-buffer
            (insert "---\nacp:\n  session-id: saved\n---\n\n")
            (ellm-mode)
            (ellm--insert-turn "user")
            (insert "old question\n")
            (ellm--insert-turn "assistant")
            (insert "old answer\n")
            (ellm--insert-turn "user")
            (insert "new prompt\n")
            (ellm-send)
            (ellm-test--wait-for-request)
            (let ((contents (buffer-string)))
              (should (string-match-p "old question" contents))
              (should (string-match-p "old answer" contents))
              (should (string-match-p "LIVE new prompt" contents))
              (should
               (equal (ellm--frontmatter-value '(title))
                      "Restored title"))
              (should-not (string-match-p "REPLAYED" contents))
              (should-not
               (ellm-acp--connection-history-replay-suppressed
                ellm-acp--connection)))
            (when ellm-acp--connection
              (delete-process
               (ellm-acp--connection-process ellm-acp--connection)))))
      (delete-file agent-file))))

