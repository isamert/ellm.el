  (with-temp-buffer
    (insert ">-| assistant\n"
            ">>-| assistant\n"
            "# Heading\n"
            "Body\n"
            "## Child\n"
            "Child body.\n")
    (ellm-mode)
    (goto-char (point-min))
    (search-forward "# Heading")
    (beginning-of-line)
    (should (eq (key-binding (kbd "TAB")) #'ellm-outline-cycle))
    (should (eq (key-binding (kbd "<tab>")) #'ellm-outline-cycle))
    (let ((inhibit-message t)
          (last-nonmenu-event 'tab))
      (call-interactively (key-binding (kbd "<tab>"))))
    (should (ellm-test--invisible-at-text "Body"))
    (goto-char (point-max))
    (should-not (key-binding (kbd "<tab>")))))

(ert-deftest ellm-test-markdown-heading-fold-stops-at-enclosing-tag ()
