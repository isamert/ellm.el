(ert-deftest ellm-test-acp-applies-changed-frontmatter-model-before-prompt ()
  "ACP sends changed frontmatter model before prompting an existing session."
  (let ((agent-file (make-temp-file "ellm-fake-acp-model-set-" nil ".py")))
    (unwind-protect
        (progn
          (with-temp-file agent-file
            (insert "import json, sys\n"
                    "session_id = 'sess_model'\n"
                    "model_set = False\n"
                    "prompt_count = 0\n"
                    "for line in sys.stdin:\n"
                    "    msg = json.loads(line)\n"
                    "    mid = msg.get('id')\n"
                    "    method = msg.get('method')\n"
                    "    if method == 'initialize':\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'protocolVersion':1,'agentCapabilities':{}}}\n"
                    "    elif method == 'session/new':\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'sessionId':session_id,'configOptions':[{'id':'model','category':'model','type':'select','currentValue':'old-model','options':[{'value':'new-model','name':'New Model'}]}]}}\n"
                    "    elif method == 'session/set_config_option':\n"
                    "        model_set = (msg['params']['configId'] == 'model' and msg['params']['value'] == 'new-model')\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'configOptions':[{'id':'model','category':'model','type':'select','currentValue':msg['params']['value'],'options':[{'value':'new-model','name':'New Model'}]}]}}\n"
                    "    elif method == 'session/prompt':\n"
                    "        prompt_count += 1\n"
                    "        text = 'first prompt' if prompt_count == 1 else ('model applied' if model_set else 'model missing')\n"
                    "        print(json.dumps({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':session_id,'update':{'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':text}}}}), flush=True)\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'stopReason':'end_turn'}}\n"
                    "    else:\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32601,'message':'unknown'}}\n"
                    "    print(json.dumps(out), flush=True)\n"))
          (let ((ellm-provider (ellm-make-acp-provider
                                :command "python3"
                                :args (list agent-file))))
            (with-temp-buffer
              (insert "---\nmodel: old-model\n---\n\n")
              (ellm-mode)
              (ellm--insert-turn "user")
              (insert "hi\n")
              (ellm-send)
              (ellm-test--wait-for-request)
              (should (string-match-p "first prompt" (buffer-string)))
              (ellm--set-frontmatter-value 'model "new-model")
              (goto-char (point-max))
              (insert "again\n")
              (ellm-send)
              (ellm-test--wait-for-request)
              (when ellm-acp--connection
                (delete-process (ellm-acp--connection-process ellm-acp--connection)))
              (should (string-match-p "model applied" (buffer-string)))
              (should (equal (ellm--frontmatter-value 'model) "new-model")))))
      (delete-file agent-file))))

