  (let* ((provider (ellm-make-codex-provider))
         (prompt (make-llm-chat-prompt))
         (item '(:type "reasoning" :id "r1" :encrypted_content "secret")))
    (llm-provider-utils-append-to-prompt
     prompt "Answer" nil (list :ellm-codex-reasoning-items (vector item)))
    (let ((input (append (ellm-codex--input prompt) nil)))
      (should (equal (car input) item))
      (should (equal (plist-get (cadr input) :role) "assistant"))
      (should (equal
               (plist-get (aref (plist-get (cadr input) :content) 0) :text)
               "Answer")))))

(ert-deftest ellm-test-codex-sse-preserves-reasoning-and-call-id ()
  "Codex SSE output items should preserve opaque state and function call ids."
  (let* ((provider (ellm-make-codex-provider))
         received
         (media (cdr (llm-provider-streaming-media-handler
                      provider (lambda (value) (push value received))
                      #'ignore)))
         (events (oref media events)))
    (funcall
     (cdr (assq 'response.output_item.done events))
     (plz-event-source-event
      :data (json-serialize
             '(:item (:type "reasoning" :id "r1"
                      :encrypted_content "secret" :summary [])))))
    (funcall
     (cdr (assq 'response.output_item.done events))
     (plz-event-source-event
      :data (json-serialize
             '(:item (:type "function_call" :id "fc_1" :call_id "call_1"
                      :name "read_file" :arguments "{\"path\":\"x\"}")))))
    (let* ((reasoning (plist-get (cadr received) :multi-turn))
           (tool-use (car (plist-get (car received) :tool-uses))))
      (should (equal (plist-get
                      (aref
                       (plist-get reasoning :ellm-codex-reasoning-items) 0)
                      :encrypted_content)
                     "secret"))
      (should (equal (llm-provider-utils-tool-use-id tool-use) "call_1"))
      (should (equal (llm-provider-utils-tool-use-args tool-use)
                     '((path . "x")))))))

(ert-deftest ellm-test-codex-sse-accumulates-reasoning-items-atomically ()
  "Multiple reasoning items should not concatenate their scalar fields."
  (let* ((provider (ellm-make-codex-provider))
         accumulated
         (media
          (cdr
           (llm-provider-streaming-media-handler
            provider
            (lambda (value)
              (setq accumulated
                    (llm-provider-utils-streaming-accumulate
                     accumulated value)))
            #'ignore)))
         (handler (cdr (assq 'response.output_item.done
                             (oref media events)))))
    (dolist (item
             '((:type "reasoning" :id "r1" :encrypted_content "one")
               (:type "reasoning" :id "r2" :encrypted_content "two")))
      (funcall
       handler
       (plz-event-source-event
        :data (json-serialize (list :item item)))))
    (let* ((multi-turn (plist-get accumulated :multi-turn))
           (items (plist-get multi-turn :ellm-codex-reasoning-items))
           (state (ellm-provider-reasoning-state provider accumulated))
           (prompt (make-llm-chat-prompt)))
      (should (equal (mapcar (lambda (item) (plist-get item :type))
                             (append items nil))
                     '("reasoning" "reasoning")))
      (should (equal (mapcar (lambda (item) (plist-get item :id))
                             (append items nil))
                     '("r1" "r2")))
      (ellm-provider-restore-reasoning provider prompt nil state)
      (should (equal (append (ellm-codex--input prompt) nil)
                     (append items nil))))))

(ert-deftest ellm-test-codex-sse-service-failure-is-retryable ()
  "Codex SSE service failures must enter the core retry path."
  (let ((provider (ellm-make-codex-provider))
        error-type)
    (cl-letf (((symbol-function 'ellm-codex--stream-request)
               (lambda (_url &rest args)
                 (let* ((media (cdr (plist-get args :media-type)))
                        (handler (cdr (assq 'response.failed (oref media events)))))
                   (funcall handler
                            (plz-event-source-event
                             :data (json-serialize
                                    '(:response
                                      (:error
                                       (:message "An error occurred while processing your request."))))))))))
      (llm-chat-streaming
       provider (make-llm-chat-prompt :context "test") nil #'ignore
       (lambda (type _message) (setq error-type type)))
      (should (eq error-type 'llm-request-error)))))

(ert-deftest ellm-test-codex-sse-requires-completion ()
  "Codex SSE should mark completion and report incomplete responses."
  (let* ((provider (ellm-make-codex-provider))
         received errors
         (media (cdr (llm-provider-streaming-media-handler
                      provider (lambda (value) (push value received))
                      (lambda (message) (push message errors)))))
         (events (oref media events)))
    (funcall
     (cdr (assq 'response.completed events))
     (plz-event-source-event
      :data (json-serialize
             '(:response
               (:usage
                (:input_tokens 2 :output_tokens 3
                 :input_tokens_details
                 (:cached_tokens 1 :cache_write_tokens 4)))))))
    (should (eq (plist-get (car received) :ellm-codex-completed) t))
    (should (= (plist-get (car received) :output-tokens) 3))
    (should (= (plist-get (car received) :cached-tokens) 1))
    (should (= (plist-get (car received) :cache-write-tokens) 4))
    (funcall
     (cdr (assq 'response.incomplete events))
     (plz-event-source-event
      :data (json-serialize
             '(:response (:incomplete_details (:reason "max_output"))))))
    (should (string-match-p "max_output" (car errors)))))

(ert-deftest ellm-test-codex-stream-accepts-missing-content-type ()
  "Codex streaming should not require a Content-Type response header."
  (let ((buffer (generate-new-buffer " *ellm-codex-stream-test*"))
        process received completed)
    (unwind-protect
        (progn
          (setq process
                (make-pipe-process
                 :name "ellm-codex-stream-test" :buffer buffer
                 :noquery t))
          (cl-letf (((symbol-function 'plz)
                     (lambda (_method _url &rest args)
                       (let ((filter (plist-get args :filter)))
                         (funcall
                          filter process
                          (concat
                           "HTTP/2 200\r\nserver: test\r\n\r\n"
                           "event: response.output_text.delta\r\n"
                           "data: {\"delta\":\"Hello\"}\r\n\r\n"
                           "event: response.completed\r\n"
                           "data: {\"response\":{\"id\":\"r1\"}}\r\n\r\n")))
                       (funcall (plist-get args :then) "")
                       process)))
            (ellm-codex--stream-request
             "https://example.invalid" :data '(:stream t)
             :media-type
             (llm-provider-streaming-media-handler
              (ellm-make-codex-provider)
              (lambda (value) (push value received)) #'ignore)
             :on-success (lambda (_data) (setq completed t))
             :on-error #'ignore))
          (should completed)
          (should (equal (plist-get (cadr received) :text) "Hello"))
          (should (eq (plist-get (car received) :ellm-codex-completed) t)))
      (when (process-live-p process)
        (delete-process process))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

(ert-deftest ellm-test-send-does-not-resurrect-completed-request ()
  "`ellm-send' should not keep a request in-flight after sync completion."
  (let ((ellm-provider (make-ellm-test-sync-provider)))
    (with-temp-buffer
      (ellm-mode)
      (ellm--insert-turn "user")
      (insert "hi\n")
      (ellm-send)
