     (equal (ellm-buffer-state-todos ellm-buffer-state)
            '((:id "1" :content "Inspect" :status "completed" :priority "medium")
              (:id "2" :content "Implement" :status "pending" :priority "medium")
              (:id "3" :content "Verify" :status "in_progress" :priority "medium"))))
