(ert-deftest ellm-test-structural-regions-disable-markdown-fontification ()
  "Frontmatter and turn headers should not be treated as Markdown prose."
  (with-temp-buffer
    (insert "---\n"
            "system: |\n"
            "  **literal bold**\n"
            "  ```elisp\n"
            "  (defun literal-code () nil)\n"
            "  ```\n"
            "---\n"
            ">-| assistant | **literal title**\n"
            "body\n")
    (ellm-mode)
    (font-lock-ensure)
    (should-not (ellm-test--face-includes-p
                 (ellm-test--face-at-text "**literal bold**") 'ellm-bold))
    (should-not (ellm-test--face-includes-p
                 (ellm-test--face-at-text "```elisp")
                 'ellm-code-block-delimiter))
    (should-not (ellm-test--face-includes-p
                 (ellm-test--face-at-text "defun literal-code")
                 'font-lock-keyword-face))
    (should-not (ellm-test--face-includes-p
                 (ellm-test--face-at-text "**literal title**") 'ellm-bold))
    (should (ellm-test--face-includes-p
             (ellm-test--face-at-text "**literal title**")
             'ellm-turn-heading-1))
    (should-not ellm--fence-positions)
    ;; Invalidating/restoring the BOB delimiter reclassifies all pre-turn
    ;; content, so stale faces and fence membership must change with it.
    (goto-char (point-min))
    (should (looking-at "---"))
    (replace-match "--x")
    (font-lock-ensure)
    (should (ellm-test--face-includes-p
             (ellm-test--face-at-text "**literal bold**") 'ellm-bold))
    (should (= (length ellm--fence-positions) 2))
    (should (ellm-test--face-includes-p
             (ellm-test--face-at-text "defun literal-code")
             'font-lock-keyword-face))
    (goto-char (point-min))
    (should (looking-at "--x"))
    (replace-match "---")
    (font-lock-ensure)
    (should-not (ellm-test--face-includes-p
                 (ellm-test--face-at-text "**literal bold**") 'ellm-bold))
    (should-not (ellm-test--face-includes-p
                 (ellm-test--face-at-text "defun literal-code")
                 'font-lock-keyword-face))
    (should-not ellm--fence-positions)))

