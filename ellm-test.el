(ert-deftest ellm-test-acp-close-and-delete-session ()
  "ACP close/delete commands should act on the current attached session."
  (let ((agent-file
         (ellm-test--make-python-agent
          "import json, sys\n"
          "for line in sys.stdin:\n"
          "    msg = json.loads(line)\n"
          "    mid = msg.get('id')\n"
          "    method = msg.get('method')\n"
          "    if method == 'initialize':\n"
          "        out = {'jsonrpc':'2.0','id':mid,'result':{'protocolVersion':1,'agentCapabilities':{'sessionCapabilities':{'close':{},'delete':{}}}}}\n"
          "    elif method in ('session/close', 'session/delete'):\n"
          "        out = {'jsonrpc':'2.0','id':mid,'result':{}}\n"
          "    else:\n"
          "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32601,'message':'unknown'}}\n"
          "    print(json.dumps(out), flush=True)\n")))
    (unwind-protect
        (let ((ellm-provider (ellm-make-acp-provider
                              :command "python3"
                              :args (list agent-file))))
          (with-temp-buffer
            (insert "---\nacp:\n  session-id: saved\n---\n\n")
            (ellm-mode)
            (ellm-acp--ensure-connection ellm-provider (current-buffer))
            (ellm-close-session)
            (when ellm-acp--connection
              (delete-process (ellm-acp--connection-process ellm-acp--connection)))
            (should-not (ellm--frontmatter-value '(acp session-id))))
          (with-temp-buffer
            (insert "---\nacp:\n  session-id: saved\n---\n\n")
            (ellm-mode)
            (ellm-delete-session)
            (when ellm-acp--connection
              (delete-process (ellm-acp--connection-process ellm-acp--connection)))
            (should-not (ellm--frontmatter-value '(acp session-id)))))
      (delete-file agent-file))))

(ert-deftest ellm-test-acp-update-rendering-metadata ()
