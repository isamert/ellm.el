(ert-deftest ellm-test-file-edit-runs-asynchronous-checkers ()
  "File edit checkers may complete asynchronously."
  (let ((file (make-temp-file "ellm-test-" nil ".txt" "old\n"))
        (ellm-tools-file-edit-checkers
         (list (lambda (_file _buffer callback)
                 (run-at-time 0.01 nil callback "synthetic diagnostic")))))
    (unwind-protect
        (let (result)
          (ellm-tools/edit-tool
           (lambda (value) (setq result value)) file "old" "new")
          (should-not result)
          (should (ellm-test--wait-for (lambda () result)))
          (should (string-match-p "synthetic diagnostic" result)))
      (delete-file file))))

(ert-deftest ellm-test-file-edit-timeout-cancels-checker-and-cleans-buffer ()
  "Timing out a file checker cancels it and releases its temporary buffer."
  (let ((file (make-temp-file "ellm-test-" nil ".txt" "old\n"))
        (ellm-tools-default-timeout 0.01)
        (ellm-tools-file-edit-checkers nil)
        checker-buffer)
    (setq ellm-tools-file-edit-checkers
          (list (lambda (_file buffer _callback)
                  (setq checker-buffer buffer)
                  (run-at-time 10 nil #'ignore))))
    (unwind-protect
        (let (result)
          (ellm-tools/edit-tool
           (lambda (value) (setq result value)) file "old" "new")
          (should (ellm-test--wait-for (lambda () result)))
          (should (string-match-p "timed out" result))
          (should-not (buffer-live-p checker-buffer)))
      (delete-file file))))

(ert-deftest ellm-test-tools-async-timeout-cancels-handle ()
  "Async tool timeout should return an error result and cancel its handle."
  (let (result
        cancelled)
    (let ((ellm-tools-list ellm-tools-list)
          (ellm-tools-refs ellm-tools-refs))
      (ellm-deftool test/timeout (:async t :timeout 0.05)
        ()
        "Test timeout tool."
        (lambda () (setq cancelled t))))
    (ellm-tools/timeout-tool (lambda (r) (setq result r)))
    (should (ellm-test--wait-for (lambda () result)))
    (should cancelled)
    (should (string-match-p "timed out" result))))

(ert-deftest ellm-test-tools-read-file-lines-end-line-inclusive ()
  "The file line reader should include END-LINE."
  (let ((file (make-temp-file "ellm-lines-")))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "a\nb\nc\n"))
          (should (equal (ellm-test--read-file-lines file 1 1)
                         "<file_lines start_line=1 end_line=1>\na\n</file_lines>"))
          (should (equal (ellm-test--read-file-lines file 2 3)
                         "<file_lines start_line=2 end_line=3>\nb\nc\n</file_lines>")))
      (delete-file file))))

(ert-deftest ellm-test-tools-read-file-lines-uses-disk-over-visiting-buffer ()
  "File reads should ignore stale contents of a visiting buffer."
  (let* ((file (make-temp-file "ellm-lines-"))
         (buffer nil))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "buffer\n"))
          (setq buffer (find-file-noselect file))
          (with-temp-file file
            (insert "disk\n"))
          (should (equal (ellm-test--read-file-lines file 1 1)
                         "<file_lines start_line=1 end_line=1>\ndisk\n</file_lines>"))
          (with-current-buffer buffer
            (should (equal (buffer-string) "buffer\n"))))
      (when (buffer-live-p buffer)
        (kill-buffer buffer))
      (delete-file file))))

(ert-deftest ellm-test-tools-read-file-lines-is-asynchronous ()
  "The file line reader should return before delivering its result."
  (let ((file (make-temp-file "ellm-lines-"))
        result)
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "text\n"))
          (let ((cancel
                 (ellm-tools/read-tool
                  (lambda (value) (setq result value))
                  file 1 1)))
            (should (functionp cancel))
            (should-not result)
            (should (ellm-test--wait-for (lambda () result)))))
      (delete-file file))))

(ert-deftest ellm-test-tools-read-file-lines-reports-binary-metadata ()
  "The file line reader should report metadata instead of binary contents."
  (let ((file (make-temp-file "ellm-binary-")))
    (unwind-protect
        (progn
          (let ((coding-system-for-write 'no-conversion))
            (with-temp-file file
              (set-buffer-multibyte nil)
              (insert (unibyte-string 0 1 2 3 255))))
          (let ((result (ellm-test--read-file-lines file 1 10)))
            (should (string-match-p
                     (format "<file_info path=%S" file) result))
            (should (string-match-p "content_type=" result))
            (should (string-match-p
                     "Non-text file; contents were not read\\." result))
            (should-not (string-match-p (string 0) result))))
      (delete-file file))))

(ert-deftest ellm-test-tools-elisp-info-describes-functions-and-variables ()
  "Elisp info should return standard help for every requested symbol."
  (let ((result (ellm-tools--elisp-info '("forward-line" "kill-ring"))))
    (should (string-match-p
             (regexp-quote "<elisp_info symbol=\"forward-line\">")
             result))
    (should (string-match-p
             (regexp-quote "(forward-line &optional N)")
             result))
    (should (string-match-p
             (regexp-quote "<elisp_info symbol=\"kill-ring\">")
             result))
    (should (string-match-p "kill-ring is a variable" result))))

(ert-deftest ellm-test-tools-elisp-info-reports-unknown-symbols ()
  "Elisp info should make missing requested symbols explicit."
  (should
   (equal
    (ellm-tools--elisp-info '("ellm-test-no-such-elisp-symbol"))
    "No function or variable named \"ellm-test-no-such-elisp-symbol\" is defined.")))

(ert-deftest ellm-test-tools-elisp-search-flex-matches-names ()
  "Elisp search should use flex completion for symbol names."
  (let ((result (ellm-tools--elisp-search "frwdln" nil 20)))
    (should (string-match-p
             "forward-line \\[function\\]"
             result))
    (should (string-match-p "search_documentation=false" result))))

(ert-deftest ellm-test-tools-elisp-search-optionally-matches-documentation ()
  "Elisp search should optionally search function and variable docs."
  (let ((symbol (intern "ellm-test-documentation-search-target")))
    (unwind-protect
        (progn
          (fset symbol
                (lambda ()
                  "Frobnicate unusual moonbeams for this test."
                  nil))
          (should-not
           (string-match-p
            (regexp-quote (symbol-name symbol))
            (ellm-tools--elisp-search "frobnicate moonbeams" nil 20)))
          (should
           (string-match-p
            (regexp-quote (symbol-name symbol))
            (ellm-tools--elisp-search "frobnicate moonbeams" t 20))))
      (fmakunbound symbol)
      (unintern symbol nil))))

(ert-deftest ellm-test-tools-elisp-search-skips-unneeded-documentation-scan ()
  "Elisp search should not scan docs when name results fill the limit."
  (let ((calls 0))
    (cl-letf (((symbol-function 'ellm-tools--elisp-documentation)
               (lambda (_symbol)
                 (setq calls (1+ calls))
                 "Summary.")))
      (let ((result (ellm-tools--elisp-search "frwdln" t 1)))
        (should (string-match-p "truncated=true" result))
        ;; Only the displayed symbol's summary needs documentation.
        (should (= calls 1))))))

(ert-deftest ellm-test-tools-elisp-tools-use-current-session ()
  "Elisp tools should see definitions made in the current Emacs."
  (let ((symbol (intern "ellm-test-current-session-function")))
    (unwind-protect
        (progn
          (fset symbol
                (lambda ()
                  "A function defined only in the current session."
                  nil))
          (should
           (string-match-p
            "A function defined only in the current session"
            (ellm-tools/elisp-info-tool (vector (symbol-name symbol))))))
      (fmakunbound symbol)
      (unintern symbol nil))))

(ert-deftest ellm-test-tools-elisp-eval-current-session ()
  "Current Elisp evaluation should use and mutate the live Emacs."
  (let ((symbol (intern "ellm-test-current-eval-value")))
    (unwind-protect
        (progn
          (set symbol 40)
          (let ((result
                 (ellm-test--elisp-eval
                  (format "(setq %s (+ %s 2))" symbol symbol)
                  "current")))
            (should (string-match-p
                     (regexp-quote "<value>\n42\n</value>")
                     result))
            (should (= (symbol-value symbol) 42))))
      (makunbound symbol)
      (unintern symbol nil))))

(ert-deftest ellm-test-tools-elisp-eval-temp-isolated-and-feature-aware ()
  "Temporary evaluation should be isolated and require requested features."
  (let ((symbol (intern "ellm-test-parent-only-function")))
    (unwind-protect
        (progn
          (fset symbol (lambda () t))
          (let ((result
                 (ellm-test--elisp-eval
                  (format "(list (fboundp '%s) (featurep 'cl-lib))"
                          symbol)
                  nil ["cl-lib"])))
            (should (string-match-p
                     (regexp-quote "<value>\n(nil t)\n</value>")
                     result))))
      (fmakunbound symbol)
      (unintern symbol nil))))

(ert-deftest ellm-test-tools-elisp-eval-temp-retains-truncated-output ()
  "Temporary Elisp results retain omitted content in the owning conversation."
  (with-temp-buffer
    (ellm-mode)
    (let ((ellm-tools-elisp-eval-result-character-limit 10)
          result)
      (ellm-tools/elisp-eval-tool
       (lambda (value) (setq result value))
       "(make-string 100 ?x)" "temp" nil)
      (should (ellm-test--wait-for (lambda () result)))
      (should (string-match-p "output-id=\\\"tool-output-1-elisp-value\\\"" result))
      (should (equal (ellm--frontmatter-value '(tool-outputs))
                     '("tool-output-1-elisp-value")))
      (should (string-match-p (make-string 100 ?x)
                              (with-current-buffer
                                  (ellm-tool-output-buffer "tool-output-1-elisp-value")
                                (buffer-string)))))))

(ert-deftest ellm-test-tools-elisp-eval-captures-output-and-errors ()
  "Elisp evaluation should report printed output and structured errors."
  (let ((success
         (ellm-test--elisp-eval
          "(princ \"hello\")\n(+ 20 22)" "temp"))
        (failure
         (ellm-test--elisp-eval
          "(princ \"before\")\n(error \"broken\")" "temp"))
        (abrupt
         (ellm-test--elisp-eval "(kill-emacs 0)" "temp")))
    (should (string-match-p
             (regexp-quote "<value>\n42\n</value>") success))
    (should (string-match-p
             (regexp-quote "<output>\nhello\n</output>") success))
    (should (string-match-p "status=\"error\"" failure))
    (should (string-match-p "broken" failure))
    (should (string-match-p
             (regexp-quote "<output>\nbefore\n</output>") failure))
    (should (string-match-p "type=child-exit" abrupt))))

(ert-deftest ellm-test-tools-elisp-eval-named-session-persists ()
  "Named child sessions should preserve state between evaluations."
  (with-temp-buffer
    (ellm-tools--initialize-elisp-sessions)
    (unwind-protect
        (let (first second)
          (ellm-tools/elisp-eval-tool
           (lambda (value) (setq first value))
           "(progn (sleep-for 0.05) (setq ellm-child-value 40))"
           "worker" nil)
          (ellm-tools/elisp-eval-tool
           (lambda (value) (setq second value))
           "(+ ellm-child-value 2)"
           "worker" nil)
          (should
           (ellm-test--wait-for (lambda () (and first second)) 10))
          (should (string-match-p
                   (regexp-quote "<value>\n42\n</value>")
                   second)))
      (ellm-tools--kill-elisp-sessions))))

(ert-deftest ellm-test-tools-elisp-eval-named-session-dies-with-owner ()
  "Killing an owner buffer should kill its named Elisp children."
  (let ((buffer (generate-new-buffer " *ellm-elisp-owner*"))
        process)
    (unwind-protect
        (progn
          (with-current-buffer buffer
            (ellm-tools--initialize-elisp-sessions)
            (ellm-test--elisp-eval "t" "worker")
            (setq process
                  (ellm-tools--elisp-session-process
                   (gethash "worker" ellm-tools--elisp-sessions))))
          (should (process-live-p process))
          (kill-buffer buffer)
          (should-not (process-live-p process)))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

(ert-deftest ellm-test-tools-elisp-eval-timeout-kills-named-session ()
  "Timing out should discard a named child that may still be blocked."
  (with-temp-buffer
    (ellm-tools--initialize-elisp-sessions)
    (let ((ellm-tools-default-timeout 0.05)
          result
          process)
      (ellm-tools/elisp-eval-tool
       (lambda (value) (setq result value))
       "(sleep-for 10)" "worker" nil)
      (setq process
            (ellm-tools--elisp-session-process
             (gethash "worker" ellm-tools--elisp-sessions)))
      (should (ellm-test--wait-for (lambda () result) 2))
      (should (string-match-p "timed out" result))
      (should-not (gethash "worker" ellm-tools--elisp-sessions))
      (should-not (process-live-p process)))))

(ert-deftest ellm-test-tools-file-edit-creates-new-file ()
  "An empty OLD-STRING should create a new file and its parents."
  (let* ((directory (make-temp-file "ellm-create-" t))
         (file (expand-file-name "nested/new.txt" directory)))
    (unwind-protect
        (progn
          (should (equal
                   (ellm-test--file-edit file "" "created\n" nil)
                   (format "Successfully created file %s" file)))
          (should (equal
                   (with-temp-buffer
                     (insert-file-contents file)
                     (buffer-string))
                   "created\n")))
      (delete-directory directory t))))

(ert-deftest ellm-test-tools-file-edit-create-refuses-overwrite ()
  "An empty OLD-STRING should never overwrite an existing file."
  (let ((file (make-temp-file "ellm-create-")))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "original\n"))
          (should (string-match-p
                   "Refusing to create .* because it already exists"
                   (ellm-test--file-edit file "" "replacement\n" nil)))
          (should (equal
                   (with-temp-buffer
                     (insert-file-contents file)
                     (buffer-string))
                   "original\n")))
      (delete-file file))))

(ert-deftest ellm-test-tools-git-status-is-read-only-and-bounded ()
  "The Git tool should expose only structured read-only inspection."
  (skip-unless (executable-find ellm-tools-git-program))
  (let ((dir (make-temp-file "ellm-git-" t))
        result)
    (unwind-protect
        (let ((default-directory (file-name-as-directory dir)))
          (process-file ellm-tools-git-program nil nil nil "init" "-q")
          (with-temp-file (expand-file-name "untracked" dir)
            (insert "content\n"))
          (ellm-tools/git-tool (lambda (value) (setq result value))
                               "status" nil nil nil nil nil 10)
          (should (ellm-test--wait-for (lambda () result)))
          (should (string-match-p "<git operation=\\\"status\\\"" result))
          (should (string-match-p "?? untracked" result))
          (should-error
           (ellm-tools--git-command "status" nil nil '("untracked") nil nil 10)))
      (delete-directory dir t))))

(ert-deftest ellm-test-tools-bash-falls-back-outside-git ()
  "The Bash tool should use Bash and `default-directory' outside Git."
  (let ((dir (make-temp-file "ellm-bash-" t))
        (ellm-current-project-function (lambda () nil))
        result)
    (unwind-protect
        (let ((default-directory (file-name-as-directory dir)))
          (ellm-tools/bash-tool
           (lambda (r) (setq result r))
           "[[ -n $BASH_VERSION ]] && pwd")
          (should (ellm-test--wait-for (lambda () result)))
          (should (string-prefix-p "Exit code: 0\n" result))
          (should (string-match-p (regexp-quote (directory-file-name dir))
                                  result)))
      (delete-directory dir))))

(ert-deftest ellm-test-tools-bash-accepts-timeout-parameter ()
  "The Bash tool should run commands with an explicit timeout."
  (let (result)
    (ellm-tools/bash-tool
     (lambda (value) (setq result value))
     "printf timeout-ok" 1)
    (should (ellm-test--wait-for (lambda () result)))
    (should (equal result "Exit code: 0\ntimeout-ok"))))

(ert-deftest ellm-test-tools-bash-timeout-cancels-command ()
  "The Bash tool should cancel commands that exceed their timeout."
  (let (result)
    (ellm-tools/bash-tool
     (lambda (value) (setq result value))
     "sleep 1" 0.05)
    (should (ellm-test--wait-for (lambda () result)))
    (should (string-match-p "timed out after 0.05 seconds" result))))

(ert-deftest ellm-test-tools-bash-rejects-excessive-timeout ()
  "The Bash tool should reject a timeout beyond the shared maximum."
  (let (result)
    (ellm-tools/bash-tool
     (lambda (value) (setq result value))
     "true" (1+ ellm-tools-maximum-timeout))
    (should (ellm-test--wait-for (lambda () result)))
    (should (string-match-p
             (format "more than %d seconds" ellm-tools-maximum-timeout)
             result))))

(ert-deftest ellm-test-tools-bash-truncates-output-in-the-middle ()
  "The Bash tool should bound output while retaining its beginning and end."
  (let ((ellm-tools-bash-output-character-limit 10)
        result)
    (ellm-tools/bash-tool
     (lambda (value) (setq result value))
     "printf 1234567890abcdef")
    (should (ellm-test--wait-for (lambda () result)))
    (should (equal result
                   (concat "Exit code: 0\n12345\n"
                           "[... output truncated: 6 characters omitted; showing beginning and end ...]\n"
                           "bcdef")))))

(ert-deftest ellm-test-tools-bash-does-not-truncate-short-output ()
  "The Bash tool should return short output unchanged."
  (let ((ellm-tools-bash-output-character-limit 10)
        result)
    (ellm-tools/bash-tool (lambda (value) (setq result value)) "printf 1234567890")
    (should (ellm-test--wait-for (lambda () result)))
    (should (equal result "Exit code: 0\n1234567890"))))

(ert-deftest ellm-test-tools-bash-uses-project-root ()
  "The Bash tool should run from the project root by default."
  (let* ((root (file-name-as-directory
                (make-temp-file "ellm-bash-project-" t)))
         (nested (expand-file-name "src/" root))
         result)
    (unwind-protect
        (progn
          (make-directory (expand-file-name ".git/" root))
          (make-directory nested)
          (with-temp-buffer
            (setq default-directory nested)
            (ellm-mode)
            (ellm-tools/bash-tool
             (lambda (value) (setq result value)) "pwd")
            (should (ellm-test--wait-for (lambda () result)))
            (should (equal result
                           (format "Exit code: 0\n%s\n"
                                   (directory-file-name root))))))
      (delete-directory root t))))

(ert-deftest ellm-test-tools-use-applied-provider-cwd ()
  "Tools should preserve a backend's cwd override even inside a project."
  (let* ((root (file-name-as-directory
                (make-temp-file "ellm-tool-provider-cwd-" t)))
         (nested (expand-file-name "src/" root))
         (provider-cwd (expand-file-name "workspace/" root))
         result)
    (unwind-protect
        (progn
          (make-directory (expand-file-name ".git/" root))
          (make-directory nested)
          (make-directory provider-cwd)
          (with-temp-buffer
            (setq default-directory nested)
            (ellm-mode)
            (ellm--apply-working-directory nil provider-cwd)
            (ellm-tools/bash-tool
             (lambda (value) (setq result value)) "pwd")
            (should (ellm-test--wait-for (lambda () result)))
            (should (equal result
                           (format "Exit code: 0\n%s\n"
                                   (directory-file-name provider-cwd))))))
      (delete-directory root t))))

(ert-deftest ellm-test-tools-frontmatter-cwd-wins-over-project-root ()
  "Directory-based tools should prefer frontmatter `cwd:' over project root."
  (let* ((root (file-name-as-directory
                (make-temp-file "ellm-tools-cwd-" t)))
         (cwd (expand-file-name "sub/" root)))
    (unwind-protect
        (let ((default-directory root))
          (make-directory (expand-file-name ".git" root))
          (make-directory cwd)
          (with-temp-file (expand-file-name "target.txt" root)
            (insert "root\n"))
          (with-temp-file (expand-file-name "target.txt" cwd)
            (insert "cwd\n"))
          (with-temp-buffer
            (let ((default-directory root))
              (insert "---\ncwd: sub\n---\n\n")
              (ellm-mode)
              (ellm--apply-working-directory (ellm--parse-frontmatter))
              (should (equal ellm--frontmatter-cwd-directory cwd))
              (should (equal (ellm-test--read-file-lines
                              "target.txt" 1 1)
                             "<file_lines start_line=1 end_line=1>\ncwd\n</file_lines>")))))
      (delete-directory root t))))

(ert-deftest ellm-test-tools-glob-supports-configurable-command ()
  "The glob tool should support replacing fd with a templated command."
  (let ((dir (file-name-as-directory (make-temp-file "ellm-glob-" t)))
        result)
    (unwind-protect
        (let ((default-directory dir)
              (ellm-current-project-function (lambda () dir))
              (ellm-tools-glob-program "find")
              (ellm-tools-glob-options '("%d" "-name" "%p" "-type" "f")))
          (make-directory (expand-file-name "src" dir))
          (with-temp-file (expand-file-name "src/a.el" dir)
            (insert "elisp\n"))
          (with-temp-file (expand-file-name "note.txt" dir)
            (insert "text\n"))
          (ellm-tools/glob-tool (lambda (r) (setq result r)) "*.el" "." 10)
          (should (ellm-test--wait-for (lambda () result)))
          (should (string-match-p "<glob" result))
          (should (string-match-p (regexp-quote "./src/a.el") result))
          (should-not (string-match-p "note.txt" result)))
      (delete-directory dir t))))

(ert-deftest ellm-test-tools-grep-uses-vimgrep-output ()
  "The grep tool should use ripgrep vimgrep-style output by default."
  (let ((dir (file-name-as-directory (make-temp-file "ellm-grep-" t)))
        result)
    (unwind-protect
        (let ((default-directory dir)
              (ellm-current-project-function (lambda () dir)))
          (with-temp-file (expand-file-name "a.txt" dir)
            (insert "needle here\n"))
          (with-temp-file (expand-file-name "b.txt" dir)
            (insert "nothing\n"))
          (dolist (cache '("node_modules" ".cache" ".venv" "venv" ".direnv"
                           ".next" ".terraform" "__pycache__"))
            (make-directory (expand-file-name cache dir))
            (with-temp-file (expand-file-name "ignored.txt" cache)
              (insert "needle ignored\n")))
          (ellm-tools/grep-tool (lambda (r) (setq result r)) "needle" "." 10 nil)
          (should (ellm-test--wait-for (lambda () result)))
          (should (string-match-p "<grep" result))
          (should (string-match-p (regexp-quote "a.txt:1:1:needle here") result))
          (should-not (string-match-p "b.txt" result))
          (should-not (string-match-p "ignored.txt" result)))
      (delete-directory dir t))))

(ert-deftest ellm-test-tools-grep-supports-path-glob ()
  "The grep tool should optionally restrict matches by path glob."
  (let ((dir (file-name-as-directory (make-temp-file "ellm-grep-glob-" t)))
        result)
    (unwind-protect
        (let ((default-directory dir)
              (ellm-current-project-function (lambda () dir)))
          (with-temp-file (expand-file-name "match.el" dir)
            (insert "needle\n"))
          (with-temp-file (expand-file-name "match.txt" dir)
            (insert "needle\n"))
          (ellm-tools/grep-tool
           (lambda (r) (setq result r)) "needle" "." 10 "*.el")
          (should (ellm-test--wait-for (lambda () result)))
          (should (string-match-p "match.el" result))
          (should-not (string-match-p "match.txt" result)))
      (delete-directory dir t))))

(ert-deftest ellm-test-tools-grep-glob-option-is-configurable ()
  "Alternative grep implementations should be able to format glob options."
  (let ((ellm-tools-grep-program "grep")
        (ellm-tools-grep-options '("-R" "-n"))
        (ellm-tools-grep-glob-options '("--include=%s")))
    (should (equal (ellm-tools--grep-command "needle" "." "*.el")
                   '("grep" "-R" "-n" "--include=*.el" "--" "needle" ".")))))

(ert-deftest ellm-test-tools-grep-caps-long-matching-lines ()
  "The default grep options should preview rather than return very long lines."
  (let ((dir (file-name-as-directory (make-temp-file "ellm-grep-long-" t)))
        result)
    (unwind-protect
        (let ((default-directory dir)
              (ellm-current-project-function (lambda () dir)))
          (with-temp-file (expand-file-name "long.txt" dir)
            (insert "needle " (make-string 3000 ?x) "\n"))
          (ellm-tools/grep-tool (lambda (r) (setq result r)) "needle" "." 10 nil)
          (should (ellm-test--wait-for (lambda () result)))
          (should (string-match-p (regexp-quote "needle") result))
          (should (string-match-p (regexp-quote "[... 0 more matches]") result))
          (should (< (length result) 2500)))
      (delete-directory dir t))))

(ert-deftest ellm-test-tools-todowrite-stores-buffer-local-list ()
  "The todowrite tool should normalize and store a buffer-local todo list."
  (with-temp-buffer
    (ellm-mode)
    (let ((result (ellm-tools/todowrite-tool
                   (vector
                    '((content . "Inspect")
                      (status . "completed")
                      (priority . "high"))
                    '((content . "Implement")
                      (status . "in_progress"))))))
      (should (equal (ellm-buffer-state-todos ellm-buffer-state)
                     '((:content "Inspect" :status "completed" :priority "high")
                       (:content "Implement" :status "in_progress" :priority "medium"))))
      (should (string-match-p "total=2" result))
      (should (string-match-p "completed=1" result))
      (should (string-match-p "in_progress=1" result))
      (should (string-match-p "\\[1/2\\] Implement"
                              (ellm--header-line-status))))))

(ert-deftest ellm-test-update-todos-merges-cursor-items-by-id ()
  "Todo merges should update existing ids in place and append new ids."
  (with-temp-buffer
    (ellm-mode)
    (ellm-update-todos
     '((:id "1" :content "Inspect" :status "in_progress")
       (:id "2" :content "Implement" :status "pending")))
