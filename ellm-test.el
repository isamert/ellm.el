         (ellm-provider-alist
          `((first . (:provider ,provider :models ("small" "large")))
            (second . (:provider ,provider :models ("other")))))
         (answers '("second" "other"))
         buffer)
    (unwind-protect
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_prompt _collection &rest _)
                     (pop answers))))
          (setq buffer (ellm-new-buffer t))
          (with-current-buffer buffer
            (let ((frontmatter (ellm--parse-frontmatter)))
              (should (equal (alist-get 'provider frontmatter) "second"))
              (should (equal (alist-get 'model frontmatter) "other")))))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

(ert-deftest ellm-test-new-buffer-prefix-starts-session-for-dynamic-models ()
  "Provider sessions should start before prompting for dynamic models."
  (let* ((provider (make-ellm-test-sync-provider))
         (ellm-provider-alist `((dynamic . ,provider)))
         (started nil)
         ready-callback
         (answers '("dynamic" "live-model"))
         buffer)
    (unwind-protect
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_prompt _collection &rest _)
                     (pop answers)))
                  ((symbol-function 'ellm-provider-model-completion-session-start-p)
                   (lambda (_provider _buffer) (not started)))
                   ((symbol-function 'ellm-provider-prepare-new-buffer)
                    (lambda (_provider _frontmatter target on-ready _on-error)
                      (setq started t)
                      (with-current-buffer target
                        (ellm--set-frontmatter-value
                         '(acp session-id) "session-1"))
                      (setq ready-callback on-ready)))
                  ((symbol-function 'ellm-provider-buffer-model-candidates)
                   (lambda (_provider _buffer)
                     (and started '("live-model")))))
          (setq buffer (ellm-new-buffer t))
          (should started)
          (should (equal answers '("live-model")))
          (funcall ready-callback)
          (should (ellm-test--wait-for (lambda () (null answers))))
          (with-current-buffer buffer
            (let ((frontmatter (ellm--parse-frontmatter)))
              (should (equal (alist-get 'model frontmatter) "live-model"))
              (should (equal (ellm--alist-get-nested
                               frontmatter '(acp session-id))
                              "session-1"))))
          (accept-process-output nil 0.05))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

(ert-deftest ellm-test-new-buffer-prefix-configures-acp-after-model ()
  "ACP model selection should refresh, prompt, apply, and persist config."
  (let* ((provider (ellm-make-acp-provider :command "fake"))
         (ellm-provider-alist `((acp . ,provider)))
         (connection (ellm-acp-connection
                      :name "test"
                      :process (start-process "ellm-acp-new-buffer" nil "sleep" "10")))
         (answers '("acp" "large" "high"))
         set-values
         buffer)
    (unwind-protect
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_prompt _collection &rest _)
                     (pop answers)))
                   ((symbol-function 'ellm-provider-prepare-new-buffer)
                    (lambda (_provider _frontmatter target on-ready _on-error)
                      (with-current-buffer target
                        (setq ellm-acp--connection connection)
                        (setf (ellm-acp--connection-buffer connection) target)
                       (ellm-acp--update-config-options
                        connection
                         '((:id "model" :category "model" :type "select"
                            :currentValue "large"
                            :options ((:value "small") (:value "large")))))
                        (funcall on-ready))))
                   ((symbol-function 'ellm-acp--set-config-option)
                    (lambda (conn config-id value on-ready _on-error
                                  &optional _option after-success)
                      (push (cons config-id value) set-values)
                     (when (equal config-id "model")
                       (ellm-acp--update-config-options
                        conn
                        `((:id "model" :category "model" :type "select"
                           :currentValue ,value :options ((:value "large")))
                          (:id "effort" :category "thought_level"
                           :type "select" :currentValue "medium"
                           :options ((:value "medium") (:value "high"))))))
                      (when after-success
                        (funcall after-success nil))
                      (funcall on-ready))))
          (setq buffer (ellm-new-buffer t))
          (should (ellm-test--wait-for
                   (lambda () (= (length set-values) 2))))
          (with-current-buffer buffer
            (let ((frontmatter (ellm--parse-frontmatter)))
              (should (equal (alist-get 'model frontmatter) "large"))
              (should (equal (ellm--alist-get-nested
                              frontmatter '(acp config effort))
                             "high"))))
          (should (equal (nreverse set-values)
                          '(("model" . "large") ("effort" . "high"))))
          (accept-process-output nil 0.05))
      (when (jsonrpc-running-p connection)
        (jsonrpc-shutdown connection))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

(ert-deftest ellm-test-acp-config-prompt-shows-default-and-current-values ()
  "Config value prompts should show persisted defaults and live values."
  (with-temp-buffer
    (insert "---\nacp:\n  config:\n    effort: high\n---\n\n")
    (ellm-mode)
    (let ((option '(:id "effort" :name "Effort" :type "select"
                    :currentValue "medium"
                    :options ((:value "medium") (:value "high"))))
          prompt default success)
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (p _collection _predicate _require-match
                            _initial _history d &rest _)
                    (setq prompt p default d)
                    "medium"))
                 ((symbol-function 'ellm-acp--set-config-option)
                   (lambda (_connection _config-id _value on-ready
                            _on-error &rest _)
                     (setq success on-ready))))
        (ellm-acp--prompt-config-option 'connection option))
      (should (equal prompt
                     "Effort (default: high, current: medium): "))
      (should (equal default "high"))
      (should (equal (ellm--frontmatter-value '(acp config effort)) "high"))
      (funcall success)
      (should (equal (ellm--frontmatter-value '(acp config effort)) "medium")))))

(ert-deftest ellm-test-save-persists-a-session-with-live-subagents ()
  "`ellm-save' should explicitly save a complete live session tree."
  (let* ((root (make-temp-file "ellm-save-" t))
         (provider (make-ellm-test-sync-provider))
         (ellm-provider-alist `((test . (:provider ,provider :models ("m")))))
         (ellm-persistence-enabled nil)
         parent first-child second-child output)
    (unwind-protect
        (progn
          (setq parent (ellm-new-buffer))
          (with-current-buffer parent
            (ellm-tool-output-store "test" "retained output")
            (setq output (car (ellm--tool-output-ids)))
            (ellm-tools--launch-subagent "First child." nil "first" nil)
            (setq first-child
                  (get-buffer (plist-get (car ellm-subagent-history)
                                         :buffer-name)))
            (cl-letf (((symbol-function 'read-directory-name)
                       (lambda (&rest _) root)))
              (ellm-save t))
            ;; A later subagent is unsaved until the next explicit snapshot.
            (ellm-tools--launch-subagent "Second child." nil "second" nil)
            (setq second-child
                  (get-buffer (plist-get (car ellm-subagent-history)
                                         :buffer-name)))
            (ellm-save)
            (should (file-exists-p buffer-file-name))
            (should (file-in-directory-p buffer-file-name root))
            (should (file-exists-p (ellm--tool-output-path output))))
          (dolist (child (list first-child second-child))
            (with-current-buffer child
              (should (file-exists-p buffer-file-name))
              (should (file-in-directory-p
                       buffer-file-name
                       (expand-file-name "subagents/"
                                         (file-name-directory
                                          (buffer-file-name parent)))))))
          (should-not ellm-persistence-enabled))
      (dolist (buffer (list second-child first-child parent))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest ellm-test-save-records-and-restores-working-directory ()
  "Explicit persistence should retain a conversation workspace, not its storage path."
  (let* ((root (make-temp-file "ellm-save-root-" t))
         (workspace (make-temp-file "ellm-save-workspace-" t))
         (provider (make-llm-fake :chat-action-func (lambda () "done")))
         (ellm-provider-alist `((test . ,provider)))
         (ellm-persistence-enabled nil)
         buffer file reopened)
    (unwind-protect
        (progn
          (let ((default-directory (file-name-as-directory workspace)))
            (setq buffer (ellm-new-buffer))
            (with-current-buffer buffer
              (cl-letf (((symbol-function 'read-directory-name)
                         (lambda (&rest _) root)))
                (ellm-save t))
              (setq file buffer-file-name)
              (should (equal (ellm--frontmatter-value 'cwd)
                             (file-name-as-directory workspace)))
              (should (equal default-directory
                             (file-name-as-directory workspace)))))
          (kill-buffer buffer)
          (setq buffer nil
                reopened (find-file-noselect file))
          (with-current-buffer reopened
            (goto-char (point-max))
            (insert "Use the saved workspace.\n")
            (ellm-send)
            (should (equal default-directory
                           (file-name-as-directory workspace)))))
      (dolist (buffer (list reopened buffer))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory root t)
      (delete-directory workspace t))))

