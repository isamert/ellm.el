(ert-deftest ellm-test-tools-webfetch-validates-url-schemes ()
  "Webfetch should accept only absolute HTTP and HTTPS URLs."
  (should-not (ellm-tools--validate-webfetch-url "https://example.com/a"))
  (should-not (ellm-tools--validate-webfetch-url "http://localhost:8080/"))
  (should-error (ellm-tools--validate-webfetch-url "file:///etc/passwd"))
  (should-error (ellm-tools--validate-webfetch-url "/relative")))

(ert-deftest ellm-test-tools-webfetch-renders-html-and-links ()
  "Webfetch HTML rendering should extract title and expand links."
  (skip-unless (fboundp 'libxml-parse-html-region))
  (let ((result
         (ellm-tools--webfetch-render-html
          (concat "<html><head><title>Example &amp; Page</title></head>"
                  "<body><h1>Hello</h1><a href=\"/docs?q=x\">Docs</a>"
                  "<script>ignored()</script></body></html>")
          "https://example.com/base/page")))
    (should (equal (plist-get result :title) "Example & Page"))
    (should (string-match-p "Hello" (plist-get result :content)))
    (should (string-match-p
             (regexp-quote "[Docs](https://example.com/docs?q=x)")
             (plist-get result :content)))
    (should-not (string-match-p "ignored" (plist-get result :content)))
    (should-not (string-match-p "Example & Page"
                                (plist-get result :content)))))

(ert-deftest ellm-test-tools-webfetch-prefers-readable-html-content ()
  "Webfetch should omit page chrome when an article is substantial."
  (skip-unless (fboundp 'libxml-parse-html-region))
  (let* ((article (mapconcat (lambda (_index) "article")
                             (number-sequence 1 120) " "))
         (chrome (mapconcat (lambda (_index) "Chrome")
                            (number-sequence 1 120) " "))
         (result
          (ellm-tools--webfetch-render-html
           (format (concat "<html><body><header>%s</header><nav>%s</nav>"
                           "<article><h1>Useful article</h1><p>%s "
                           "<a href=\"/docs\">Documentation</a></p></article>"
                           "<footer>%s</footer></body></html>")
                   chrome chrome article chrome)
           "https://example.com/base/page"))
         (content (plist-get result :content)))
    (should (plist-get result :readable))
    (should (string-match-p "Useful article" content))
    (should (string-match-p
             (regexp-quote "[Documentation](https://example.com/docs)")
             content))
    (should-not (string-match-p "Chrome" content))))

(ert-deftest ellm-test-tools-webfetch-falls-back-for-short-html-content ()
  "Webfetch should retain the full page when readability is not meaningful."
  (skip-unless (fboundp 'libxml-parse-html-region))
  (let* ((result
          (ellm-tools--webfetch-render-html
           (concat "<html><body><header>Site navigation</header>"
                   "<article>Brief announcement.</article>"
                   "<footer>Contact us</footer></body></html>")
           "https://example.com/"))
         (content (plist-get result :content)))
    (should-not (plist-get result :readable))
    (should (string-match-p "Site navigation" content))
    (should (string-match-p "Brief announcement" content))
    (should (string-match-p "Contact us" content))))

(ert-deftest ellm-test-tool-output-store-and-tools ()
  "Retained output is named in frontmatter and accessible only by its id."
  (with-temp-buffer
    (ellm-mode)
    (let ((id (ellm-tool-output-store "bash" "one\ntwo\nthree")))
      (should (ellm--frontmatter-value '(ellm session-id)))
      (should (equal id "tool-output-1-bash"))
      (should (equal (ellm--frontmatter-value '(tool-outputs))
                     '("tool-output-1-bash")))
      (should (equal (with-current-buffer (ellm-tool-output-buffer id)
                       (buffer-string))
                     "one\ntwo\nthree"))
      (should (string-match-p "2: two"
                              (ellm-tools/search-output-tool id "two" nil nil))))))

(ert-deftest ellm-test-switch-to-tool-output-buffer ()
  "Tool-output switching should offer outputs from the current conversation."
  (with-temp-buffer
    (ellm-mode)
    (let ((first (ellm-tool-output-store "bash" "first"))
          (second (ellm-tool-output-store "web" "second"))
          offered switched)
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (_prompt collection &rest _)
                   (setq offered collection)
                   second))
                ((symbol-function 'switch-to-buffer)
                 (lambda (buffer-or-name &rest _)
                   (setq switched (get-buffer buffer-or-name)))))
        (ellm-switch-to-tool-output-buffer))
      (should (equal offered (list first second)))
      (should (eq switched (ellm-tool-output-buffer second))))))

(ert-deftest ellm-test-tool-output-buffers-are-conversation-local ()
  "Identical output ids in live conversations must not share buffers."
  (let ((first (generate-new-buffer " *ellm output first*"))
        (second (generate-new-buffer " *ellm output second*")))
    (unwind-protect
        (progn
          (with-current-buffer first
            (ellm-mode)
            (should (equal (ellm-tool-output-store "bash" "first")
                           "tool-output-1-bash")))
          (with-current-buffer second
            (ellm-mode)
            (should (equal (ellm-tool-output-store "bash" "second")
                           "tool-output-1-bash")))
          (should-not (eq (with-current-buffer first
                            (ellm-tool-output-buffer "tool-output-1-bash"))
                          (with-current-buffer second
                            (ellm-tool-output-buffer "tool-output-1-bash"))))
          (should (equal (with-current-buffer first
                           (with-current-buffer
                               (ellm-tool-output-buffer "tool-output-1-bash")
                             (buffer-string)))
                         "first"))
          (should (equal (with-current-buffer second
                           (with-current-buffer
                               (ellm-tool-output-buffer "tool-output-1-bash")
                             (buffer-string)))
                         "second")))
      (when (buffer-live-p first) (kill-buffer first))
      (when (buffer-live-p second) (kill-buffer second)))))

(ert-deftest ellm-test-tools-webfetch-result-transport-is-single-line ()
