(ert-deftest ellm-test-acp-permission-uses-core-request-and-hooks ()
  "ACP permission requests defer their reply until core input resolves."
  (let (events reply)
    (with-temp-buffer
      (ellm-mode)
      (let* ((connection (ellm-acp-connection :name "test" :buffer (current-buffer)))
             (backend-request (ellm-acp--make-request :connection connection))
             (request (ellm--make-request :buffer (current-buffer)
                                          :backend backend-request)))
        (setf (ellm-acp--connection-current-request connection) backend-request)
        (ellm--set-active-request request)
        (unwind-protect
            (cl-letf (((symbol-function 'jsonrpc-running-p) (lambda (_) t))
                      ((symbol-function 'jsonrpc-connection-send)
                       (lambda (_connection &rest args) (setq reply args))))
              (add-hook 'ellm-before-permission-hook
                        (lambda (hook-request _permission)
                          (push (cons 'before hook-request) events)) nil t)
              (add-hook 'ellm-after-permission-hook
                        (lambda (hook-request _permission decision)
                          (push (list 'after hook-request decision) events)) nil t)
              (ellm-acp--handle-deferred-user-prompt
               connection
               '(:id 7 :method "session/request_permission"
                 :params (:toolCall (:title "Shell")
                          :options ((:name "Allow" :optionId "allow")))))
              (should ellm--active-user-prompt)
              (should-not reply)
              (ellm--resolve-user-prompt ellm--active-user-prompt
                                          '(:status selected :value "allow"))
              (should (equal reply '(:id 7 :result (:outcome (:outcome "selected" :optionId "allow")))))
              (should (eq (cdr (assq 'before events)) request))
              (should (equal (nth 2 (car events)) "allow")))
          (ellm--set-active-request nil))))))

(ert-deftest ellm-test-native-notifications-require-a-desktop-service ()
  "Native notifications are not attempted without a desktop service."
  (let ((ellm--native-notifications-available 'unknown)
        (notification '(:title "Title" :body "Body" :urgency normal))
        notified)
    (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
              ((symbol-function 'dbus-list-known-names) (lambda (&rest _) nil))
              ((symbol-function 'notifications-notify)
               (lambda (&rest _) (setq notified t))))
      (should-not (ellm-notify-native notification))
      (should-not notified)))
  (let ((ellm--native-notifications-available 'unknown)
        (probes 0))
    (cl-letf (((symbol-function 'require)
               (lambda (&rest _) (cl-incf probes) t))
              ((symbol-function 'dbus-list-known-names) (lambda (&rest _) nil)))
      (ellm--native-notifications-available-p)
      (ellm--native-notifications-available-p)
      (should (= probes 1))))
  (let ((notification '(:title "Title" :body "Body" :urgency normal))
        params)
    (cl-letf (((symbol-function 'ellm--native-notifications-available-p)
               (lambda () t))
              ((symbol-function 'notifications-notify)
               (lambda (&rest args) (setq params args))))
      (should (ellm-notify-native notification))
      (should (equal params '(:app-name "ellm" :title "Title" :body "Body"
                              :urgency normal))))))

