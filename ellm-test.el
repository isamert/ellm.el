(ert-deftest ellm-test-set-config-acp-applies-live-option ()
  "ACP config options should apply live before being persisted."
  (let* ((provider (ellm-make-acp-provider :command "fake" :model "model-1"))
         (ellm-provider-alist `((acp . ,provider)))
         (process (start-process "ellm-config-acp" nil "sleep" "10"))
         (connection (ellm-acp-connection
                      :name "test" :process process :buffer nil))
          applied
          applied-ready)
    (unwind-protect
        (with-temp-buffer
          (insert "---\nprovider: acp\nmodel: model-1\n---\n\n")
          (ellm-mode)
          (setq ellm-acp--connection connection)
          (setf (ellm-acp--connection-buffer connection) (current-buffer)
                (ellm-acp--connection-session-id connection) "sess-config"
                (ellm-acp--connection-config-options connection)
                '((:id "model" :category "model" :type "select"
                   :currentValue "model-1" :options ((:value "model-1")))
                  (:id "effort" :name "Effort" :type "select"
                   :currentValue "low"
                   :options ((:value "low") (:value "high")))))
          (cl-letf (((symbol-function 'completing-read)
                     (lambda (prompt collection &rest _)
                       (if (string-prefix-p "Setting" prompt)
                           (car (seq-find
                                 (lambda (entry)
                                   (string-prefix-p "acp.config.effort"
                                                    (car entry)))
                                 collection))
                         "high")))
                     ((symbol-function 'ellm-acp--set-config-option)
                      (lambda (_connection config-id value on-ready _on-error
                                &rest _)
                        (setq applied (cons config-id value))
                        (setq applied-ready on-ready))))
            (ellm-set-config))
          (should (equal applied '("effort" . "high")))
          (should (equal ellm--config-in-flight '(acp config effort)))
          (should-not (ellm--frontmatter-value '(acp config effort)))
          (should-error (ellm-send) :type 'user-error)
          (funcall applied-ready)
          (should-not ellm--config-in-flight)
          (should (equal (ellm--frontmatter-value '(acp config effort))
                         "high"))
          (let ((paths (mapcar
                        (lambda (setting) (plist-get setting :path))
                        (ellm--config-settings provider (current-buffer)))))
            (should-not (member '(acp config model) paths))))
      (when (process-live-p process)
        (delete-process process)))))

