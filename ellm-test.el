                    "    mid = msg.get('id')\n"
                    "    method = msg.get('method')\n"
                    "    if method == 'initialize':\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'protocolVersion':1,'agentCapabilities':{}}}\n"
                    "    elif method == 'session/new':\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'sessionId':session_id,'configOptions':options()}}\n"
                    "    elif method == 'session/set_config_option':\n"
                    "        params = msg['params']\n"
                    "        if params['configId'] == 'effort' and params['value'] == 'high':\n"
                    "            effort_set = True\n"
                    "        if params['configId'] == 'auto' and params.get('type') == 'boolean' and params['value'] is False:\n"
                    "            auto_set = True\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'configOptions':options('high' if effort_set else 'low', not auto_set)}}\n"
                    "    elif method == 'session/prompt':\n"
                    "        text = 'config applied' if effort_set and auto_set else 'config missing'\n"
                    "        print(json.dumps({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':session_id,'update':{'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':text}}}}), flush=True)\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'stopReason':'end_turn'}}\n"
                    "    else:\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32601,'message':'unknown'}}\n"
                    "    print(json.dumps(out), flush=True)\n"))
          (let ((ellm-provider (ellm-make-acp-provider
                                :command "python3"
                                :args (list agent-file))))
            (with-temp-buffer
              (insert "---\nacp:\n  config:\n    effort: high\n    auto: false\n---\n\n")
              (ellm-mode)
              (ellm--insert-turn "user")
