(defun ellm-test--pretty-separator-roles ()
  "Return roles for current pretty-separator overlays."
  (cl-loop for ov in (overlays-in (point-min) (point-max))
           when (overlay-get ov 'ellm-pretty-separator)
           collect (overlay-get ov 'ellm-pretty-separator-role)))

(defun ellm-test--invisible-at-text (text)
  "Return invisibility at the beginning of TEXT in the current buffer."
  (save-excursion
    (goto-char (point-min))
    (search-forward text)
    (invisible-p (match-beginning 0))))

(defun ellm-test--invisible-at-nth-text (text n)
  "Return invisibility at the beginning of the Nth occurrence of TEXT."
  (save-excursion
    (goto-char (point-min))
    (dotimes (_ n)
      (search-forward text))
    (invisible-p (match-beginning 0))))

(defun ellm-test--face-at-text (text)
  "Return the `face' text property at the beginning of TEXT."
  (save-excursion
    (goto-char (point-min))
    (search-forward text)
    (get-text-property (match-beginning 0) 'face)))

(defun ellm-test--face-at-newline-after-text (text)
  "Return the `face' text property on the newline after TEXT."
  (save-excursion
    (goto-char (point-min))
    (search-forward text)
    (get-text-property (line-end-position) 'face)))

(defun ellm-test--face-includes-p (face target)
  "Return non-nil if FACE contains TARGET."
  (cond
   ((eq face target) t)
   ((listp face)
    (cl-some (lambda (item)
               (ellm-test--face-includes-p item target))
              face))))

(defun ellm-test--face-attr-equal-p (face attr value)
  "Return non-nil if FACE contains ATTR equal to VALUE."
  (cond
   ((and (listp face) (keywordp (car face)))
    (and (plist-member face attr)
         (equal (plist-get face attr) value)))
   ((listp face)
    (cl-some (lambda (item)
               (ellm-test--face-attr-equal-p item attr value))
             face))
   ((and (symbolp face) (facep face))
    (equal (face-attribute face attr nil 'default) value))))

(defun ellm-test--pretty-separator-overlay-at-text (text)
  "Return the pretty-separator overlay at the beginning of TEXT."
  (save-excursion
    (goto-char (point-min))
    (search-forward text)
    (cl-find-if (lambda (ov) (overlay-get ov 'ellm-pretty-separator))
                (overlays-at (match-beginning 0)))))

(defun ellm-test--rule-overlays ()
  "Return rule overlays in the current buffer."
  (cl-loop for ov in (overlays-in (point-min) (point-max))
           when (overlay-get ov 'ellm-rule)
           collect ov))

(defun ellm-test--rule-overlay-before-text (text)
  "Return the rule overlay before the line containing TEXT, if any."
  (save-excursion
    (goto-char (point-min))
    (search-forward text)
    (let ((bol (line-beginning-position)))
      (cl-find-if (lambda (ov) (overlay-get ov 'ellm-rule))
                  (overlays-at bol)))))

(defun ellm-test--wait-for (predicate &optional timeout)
  "Wait until PREDICATE returns non-nil or TIMEOUT seconds pass."
  (let ((deadline (+ (float-time) (or timeout 2))))
    (while (and (not (funcall predicate))
                (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (funcall predicate)))

(defun ellm-test--read-file-lines (file start-line end-line)
  "Read FILE from START-LINE through END-LINE and wait for its result."
  (let (result)
    (ellm-tools/read-tool
     (lambda (value) (setq result value))
     file start-line end-line)
    (should (ellm-test--wait-for (lambda () result)))
    result))

