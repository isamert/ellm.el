(defun ellm-test--jwt (claims)
  "Return an unsigned test JWT containing CLAIMS."
  (let ((payload
         (replace-regexp-in-string
          "=+\\'" ""
          (replace-regexp-in-string
           "/" "_"
           (replace-regexp-in-string
            "+" "-"
            (base64-encode-string (json-serialize claims) t))))))
    (concat "header." payload ".signature")))

(ert-deftest ellm-test-codex-oauth-parses-jwt-and-browser-callback ()
  "Codex OAuth helpers should parse account claims and callback queries."
  (let ((token (ellm-test--jwt '(:chatgpt_account_id "acct_1"))))
    (should (equal (plist-get (ellm-codex--jwt-claims token)
                              :chatgpt_account_id)
                   "acct_1"))
    (should (equal (ellm-codex--account-id token nil) "acct_1")))
  (let ((params
         (ellm-codex--callback-params
          "GET /auth/callback?code=abc&state=xyz HTTP/1.1")))
    (should (equal (cadr (assoc "code" params)) "abc"))
    (should (equal (cadr (assoc "state" params)) "xyz"))))

(ert-deftest ellm-test-codex-provider-does-not-print-tokens ()
  "A configured Codex provider should not reveal OAuth tokens when printed."
  (let* ((directory (make-temp-file "ellm-codex-auth-" t))
         (file (expand-file-name "auth.json" directory))
         (provider (ellm-make-codex-provider :auth-file file))
         (id-token (ellm-test--jwt '(:chatgpt_account_id "acct_1"))))
    (unwind-protect
        (progn
          (ellm-codex--install-auth
           provider
           (list :access_token "access-secret"
                 :refresh_token "refresh-secret"
                 :id_token id-token))
          (let ((printed (prin1-to-string provider)))
            (should-not (string-match-p "access-secret" printed))
            (should-not (string-match-p "refresh-secret" printed))
            (should-not (string-match-p (regexp-quote id-token) printed))))
      (delete-directory directory t))))

(ert-deftest ellm-test-codex-replays-encrypted-reasoning-item ()
  "Codex should replay a valid reasoning item instead of its visible summary."
  (let* ((provider (ellm-make-codex-provider))
         (prompt (make-llm-chat-prompt))
         (item '(:type "reasoning" :id "r1"
                 :encrypted_content "secret" :summary []))
         (state (list :version 1 :provider "codex" :item item)))
    (ellm-provider-restore-reasoning provider prompt "Visible summary" state)
    (should (equal (append (ellm-codex--input prompt) nil) (list item)))
    (let ((fallback (make-llm-chat-prompt)))
      (ellm-provider-restore-reasoning
       provider fallback "Visible summary" nil)
      (should (equal
               (llm-chat-prompt-interaction-content
                (car (llm-chat-prompt-interactions fallback)))
               "Visible summary")))))

(ert-deftest ellm-test-codex-replays-reasoning-before-associated-text ()
