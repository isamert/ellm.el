    (should (ellm-test-pending-request-cancelled driver))
    (should (eq (ellm-request-state request) 'cancelled))))



(ert-deftest ellm-test-acp-request-timeout-is-terminal ()
  "ACP request deadlines should fail without resending over stdio."
  (let ((connection (ellm-acp-connection :name "test"))
        (ellm-request-timeout 0.01)
        (calls 0)
        failure)
    (cl-letf (((symbol-function 'jsonrpc-async-request)
               (lambda (_connection _method _params &rest args)
                 (cl-incf calls)
                 (funcall (plist-get args :timeout-fn)))))
      (ellm-acp--request
       connection :session/list nil
       :success-fn (lambda (_value) (ert-fail "Unexpected ACP success"))
       :error-fn (lambda (error-object) (setq failure error-object))))
    (should (= calls 1))
    (should (= (plist-get failure :code) -32001))
