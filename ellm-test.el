(ert-deftest ellm-test-codex-request-uses-stateless-responses-shape ()
  "Codex requests should carry typed full history and top-level instructions."
  (let* ((provider (ellm-make-codex-provider :chat-model "gpt-test"))
         (prompt
          (make-llm-chat-prompt
           :interactions
           (list
            (make-llm-chat-prompt-interaction
             :role 'system :content "Be concise.")
            (make-llm-chat-prompt-interaction
             :role 'user :content "Question")
            (make-llm-chat-prompt-interaction
             :role 'assistant :content "Answer"))
           :reasoning 'maximum
           :max-tokens 123))
         (request (llm-provider-chat-request provider prompt t))
         (input (append (plist-get request :input) nil)))
    (should (equal (plist-get request :model) "gpt-test"))
    (should (equal (plist-get request :instructions) "Be concise."))
    (should (eq (plist-get request :store) :false))
    (should (eq (plist-get request :stream) t))
    (should (equal (plist-get request :include)
                   ["reasoning.encrypted_content"]))
    (should (equal (plist-get (plist-get request :reasoning) :effort)
                   "xhigh"))
    (should-not (plist-member request :max_output_tokens))
    (should-not (ellm-provider-config-effect
                 provider '(max-tokens) nil))
    (should (equal (mapcar (lambda (item) (plist-get item :role)) input)
                   '("user" "assistant")))
    (should (equal
             (plist-get (aref (plist-get (car input) :content) 0) :type)
             "input_text"))
    (should (equal
             (plist-get (aref (plist-get (cadr input) :content) 0) :type)
             "output_text"))))

(ert-deftest ellm-test-codex-persists-and-reuses-prompt-cache-key ()
  "Codex should persist one cache key and inject it into every request."
  (let ((provider
         (ellm-make-codex-provider
          :default-chat-non-standard-params
          '((prompt_cache_key . "shared-provider-key")
            (service_tier . "priority"))))
        configured-providers
        (generated 0))
    (with-temp-buffer
      (ellm-mode)
      (cl-letf
          (((symbol-function 'ellm-codex--new-prompt-cache-key)
            (lambda ()
              (cl-incf generated)
              "ellm-conversation-key"))
           ((symbol-function 'ellm-llm--backend-create)
            (lambda (configured _frontmatter _buffer)
              (push configured configured-providers)
              'request)))
        (ellm-backend-create provider nil (current-buffer))
        (ellm-backend-create
         provider (ellm--parse-frontmatter) (current-buffer)))
      (should (= generated 1))
      (should (equal
               (ellm--frontmatter-value '(codex prompt-cache-key))
               "ellm-conversation-key"))
      (should (= (length configured-providers) 2))
      (dolist (configured configured-providers)
        (let* ((prompt (make-llm-chat-prompt))
               (request (llm-provider-chat-request configured prompt t)))
          (should
           (equal (plist-get request :prompt_cache_key)
                  "ellm-conversation-key"))
          (should (equal (plist-get request :service_tier) "priority"))))
      (should
       (equal
        (cdr
         (assq
          'prompt_cache_key
          (llm-standard-chat-provider-default-chat-non-standard-params
           provider)))
        "shared-provider-key")))))

(ert-deftest ellm-test-codex-frontmatter-can-disable-prompt-caching ()
  "Codex cache false should use explicit mode without a cache key."
  (let ((provider
         (ellm-make-codex-provider
          :chat-model "gpt-5.6-sol"
          :default-chat-non-standard-params
          '((prompt_cache_key . "shared-provider-key")
            (prompt_cache_options . ((mode . "implicit")))
            (service_tier . "priority"))))
        configured)
    (with-temp-buffer
      (insert "---\ncodex:\n  cache: false\n---\n\n")
      (ellm-mode)
      (cl-letf
          (((symbol-function 'ellm-codex--new-prompt-cache-key)
            (lambda ()
              (ert-fail "Disabled caching must not generate a cache key")))
           ((symbol-function 'ellm-llm--backend-create)
            (lambda (provider _frontmatter _buffer)
              (setq configured provider)
              'request)))
