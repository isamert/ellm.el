            (should (string-match-p "hello" contents))
            (should-not (string-match-p "\[pending/low\] old" contents))
            (should (string-match-p "new" contents))
            (should (equal (ellm-buffer-state-context-usage ellm-buffer-state) 10))
            (should (equal (ellm-buffer-state-context-size ellm-buffer-state) 100))
            (should (equal (ellm-buffer-state-cost-amount ellm-buffer-state) 0.2))
            (should (equal (ellm-buffer-state-cost-currency ellm-buffer-state) "USD"))
            (should (string-match-p "10/100 (10.0%%)" (ellm--header-line-status)))
            (should-not (string-match-p "ACP Usage" contents))
            (should (string-match-p ":kind execute" contents))
            (should (string-match-p "Locations:" contents))
            (should (string-match-p ":status completed" contents))
            (should-not (string-match-p "stale" contents))
            (should (= 1 (cl-count-if
                          (lambda (turn)
                            (and (equal (ellm-turn-role turn) "tool-result")
                                 (equal (alist-get "id" (ellm-turn-attrs turn)
                                                   nil nil #'equal)
                                        "call_1")))
                          turns)))
            (should-not (string-match-p "Raw output" contents))
            (should (string-match-p "Old:" contents))))
      (when (jsonrpc-running-p connection)
        (jsonrpc-shutdown connection)))))

(ert-deftest ellm-test-acp-session-info-update-renames-buffer ()
  "ACP session titles should use the backend-neutral title handler."
  (let ((ellm-buffer-name-function #'ellm-default-buffer-name)
        (ellm-current-project-function (lambda () nil))
        (connection (ellm-acp-connection
                     :name "test"
                     :process (start-process "ellm-acp-test-sleep" nil "sleep" "10")
                     :buffer (current-buffer))))
    (unwind-protect
        (with-temp-buffer
