                    "    return [\n"
                    "        {'id':'effort','category':'thought_level','type':'select','currentValue':effort,'options':[{'value':'low','name':'Low'},{'value':'high','name':'High'}]},\n"
                    "        {'id':'auto','type':'boolean','currentValue':auto},\n"
                    "    ]\n"
                    "for line in sys.stdin:\n"
