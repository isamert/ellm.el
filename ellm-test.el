(ert-deftest ellm-test-comment-prefers-a-visible-project-buffer ()
  (let ((visible (generate-new-buffer " *ellm visible comment target*"))
        (other (generate-new-buffer " *ellm other comment target*")))
    (unwind-protect
        (with-temp-buffer
          (setq default-directory temporary-file-directory)
          (emacs-lisp-mode)
          (insert "(+ 1 2)")
          (with-current-buffer visible (ellm-mode))
          (with-current-buffer other (ellm-mode))
          (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Explain this"))
                    ((symbol-function 'ellm--project-buffers)
                     (lambda (&rest _) (list other visible)))
                    ((symbol-function 'get-buffer-window)
                     (lambda (buffer &rest _) (and (eq buffer visible) t)))
                    ((symbol-function 'read-buffer)
                     (lambda (&rest _) (error "Should not prompt"))))
            (ellm-comment))
          (with-current-buffer visible
            (should (equal (buffer-string)
                           "``` emacs-lisp\n(+ 1 2)\n```\nExplain this\n")))
          (with-current-buffer other
            (should (equal (buffer-string) ""))))
      (dolist (buffer (list visible other))
        (when (buffer-live-p buffer)
          (kill-buffer buffer))))))

(ert-deftest ellm-test-compose-selects-project-buffer-outside-ellm ()
  (let ((target (generate-new-buffer " *ellm compose target*"))
        selected)
    (unwind-protect
        (with-temp-buffer
          (setq default-directory temporary-file-directory)
          (emacs-lisp-mode)
          (with-current-buffer target (ellm-mode))
          (cl-letf (((symbol-function 'ellm--project-buffers)
                     (lambda (&rest _) (list target)))
                    ((symbol-function 'ellm--select-ellm-buffer)
                     (lambda (&rest _)
                       (setq selected t)
                       target)))
            (save-window-excursion
              (ellm-compose)
              (should (eq (current-buffer) target))
              (should selected)
              (should (equal (ellm-turn-role (car (last (ellm--parse-turns))))
                             "user")))))
      (when (buffer-live-p target)
        (kill-buffer target)))))

