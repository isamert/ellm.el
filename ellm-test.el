                     :currentValue "model-1" :options ((:value "model-1")))
                    (:id "auto" :type "boolean" :currentValue t))))
    (unwind-protect
        (with-temp-buffer
          (insert "---\nprovider: fake\nacp:\n  config:\n    auto: \"false\"\n---\n\n")
          (ellm-mode)
          (setq ellm-acp--connection connection)
          (setf (ellm-acp--connection-buffer connection) (current-buffer)
