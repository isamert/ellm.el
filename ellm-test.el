                     "profiled")))))

(ert-deftest ellm-test-list-profiles-reports-effective-catalog ()
  "Profile discovery should report local overlays and the active profile."
  (let ((ellm-profiles
         '((explore . ((description . "Global exploration")
                        (model . "small")))
           (reviewer . ((description . "Review changes")
                         (tools . ("@files")))))))
    (with-temp-buffer
      (insert "---\nprofile: explore\nprofiles:\n  explore:\n    description: Local exploration\n---\n")
      (ellm-mode)
      (let ((result (ellm-tools/profiles-tool)))
        (should (string-match-p "active=\\\"explore\\\"" result))
        (should (string-match-p "name=\\\"explore\\\" description=\\\"Local exploration\\\" model=\\\"small\\\"" result))
        (should (string-match-p "name=\\\"reviewer\\\" description=\\\"Review changes\\\" tools=(\"@files\")" result))))))

(ert-deftest ellm-test-send-subagent-reprompts-subagent ()
  "`send' should append a required prompt and send it to a known subagent."
  (let* ((provider (make-ellm-test-sync-provider))
         (ellm-provider-alist
          `((parent . (:provider ,provider :models ("m"))))))
    (with-temp-buffer
      (insert "---\nprovider: parent\nmodel: m\n---\n\n")
      (ellm-mode)
      (unwind-protect
          (progn
            (ellm-tools/launch-subagent-tool
             "Initial prompt." nil "worker" nil)
            (let* ((entry (car ellm-subagent-history))
                   (buffer-name (plist-get entry :buffer-name))
                   (buffer (get-buffer buffer-name)))
              (with-current-buffer buffer
                (should (= 1 (cl-count-if
                              (lambda (turn)
                                (equal (ellm-turn-role turn) "assistant"))
                              (ellm--parse-turns)))))
              (should (string-match-p
                       "prompt must be a non-empty string"
                       (ellm-tools/send-subagent-tool (plist-get entry :id) "")))
              (let ((result (ellm-tools/send-subagent-tool
                             (plist-get entry :id) "Continue work.")))
                (should (string-match-p "Sent" result)))
              (with-current-buffer buffer
                (let ((turns (ellm--parse-turns)))
                  (should (= 2 (cl-count-if
                                (lambda (turn)
                                  (equal (ellm-turn-role turn) "assistant"))
                                turns)))
                  (should (string-match-p "Continue work" (buffer-string)))
                  (should (equal (ellm-turn-role (car (last turns)))
                                 "user"))))))
        (dolist (entry ellm-subagent-history)
          (when-let* ((buffer (get-buffer (plist-get entry :buffer-name))))
            (kill-buffer buffer)))))))

(ert-deftest ellm-test-send-subagent-rejects-unrelated-buffer ()
