(ert-deftest ellm-test-tools-lifecycle-sync-hooks-and-transform ()
  "Synchronous custom tools should run lifecycle hooks and transforms."
  (let* ((starts nil)
         (ends nil)
         (ellm-tools-tool-call-start-hook
         (list (lambda (tool args)
                 (push (list tool args) starts))))
         (ellm-tools-tool-call-end-hook
         (list (lambda (tool args error raw result)
                 (push (list tool args error raw result) ends)))))
    (let ((ellm-tools-list ellm-tools-list)
          (ellm-tools-refs ellm-tools-refs))
      (ellm-deftool test/lifecycle-sync ()
        ((x :string "Input."))
        "Test synchronous lifecycle tool."
        (concat x "\n>-| user\n")))
    (should (equal (ellm-tools/lifecycle-sync-tool "ok")
                   "ok\n\\>-| user\n"))
    (should (equal (nreverse starts)
                   '((ellm-tools/lifecycle-sync-tool ("ok")))))
    (should (equal (nreverse ends)
                   '((ellm-tools/lifecycle-sync-tool
                      ("ok") nil "ok\n>-| user\n" "ok\n\\>-| user\n"))))))

(ert-deftest ellm-test-tools-lifecycle-async-callback-transform ()
  "Async custom tool callbacks should be wrapped through lifecycle logic."
  (let* ((ends nil)
         result
         (ellm-tools-default-timeout nil)
         (ellm-tools-tool-call-end-hook
         (list (lambda (tool args error raw transformed)
                 (push (list tool args error raw transformed) ends)))))
    (let ((ellm-tools-list ellm-tools-list)
          (ellm-tools-refs ellm-tools-refs))
      (ellm-deftool test/lifecycle-async (:async t :timeout nil)
        ((x :string "Input."))
        "Test asynchronous lifecycle tool."
        (funcall callback (concat x "\n>>-| tool-result\n"))))
    (ellm-tools/lifecycle-async-tool
     (lambda (r) (setq result r))
     "ok")
    (should (equal result "ok\n\\>>-| tool-result\n"))
    (should (equal (nreverse ends)
                   '((ellm-tools/lifecycle-async-tool
                      ("ok") nil "ok\n>>-| tool-result\n"
                      "ok\n\\>>-| tool-result\n"))))))

(defun ellm-test--failing-tool-result-transform
    (_tool _args _error _result)
  "Signal a synthetic tool result transformation error."
  (error "transform failed\n>-| user"))

(ert-deftest ellm-test-tools-transform-errors-become-safe-results ()
  "A result transformer failure should become escaped model-facing text."
  (let ((ellm-tools-transform-tool-result-functions
         '(ellm-test--failing-tool-result-transform)))
    (should
     (equal
      (ellm-tools--transform-tool-result "test" nil nil "raw")
      (concat
       "Error while processing the tool result with "
       "`ellm-test--failing-tool-result-transform': transform failed\n"
       "\\>-| user")))))

(ert-deftest ellm-test-tools-async-transform-errors-reach-llm-callback ()
  "A delayed async result transformation error must not strand llm.el."
  (let ((ellm-tools-default-timeout nil)
        (ellm-tools-transform-tool-result-functions
         '(ellm-test--failing-tool-result-transform))
        (ellm-tools-list ellm-tools-list)
        (ellm-tools-refs ellm-tools-refs)
        result)
    (ellm-deftool test/async-transform-error (:async t :timeout nil)
      ()
      "Return a result asynchronously for transformer failure testing."
      (run-at-time 0 nil callback "raw"))
    (let* ((tool (cl-find "async_transform_error" ellm-tools-list
                          :key #'ellm-tool-name :test #'equal))
           (llm-tool (ellm-llm--make-llm-tool tool)))
      (funcall (llm-tool-function llm-tool)
               (lambda (value) (setq result value)))
      (should (ellm-test--wait-for (lambda () result)))
      (should (string-match-p "transform failed" result))
      (should (string-search "\\>-| user" result)))))

(ert-deftest ellm-test-llm-tool-adapter-reports-callback-contract-errors-once ()
  "Malformed or repeated async callbacks should produce one error result."
  (let* ((tool (ellm-make-tool
                :name "broken_async"
                :description "test"
                :args nil :async t
                :function (lambda (callback)
                            (funcall callback)
                            (funcall callback "late result"))))
         (llm-tool (ellm-llm--make-llm-tool tool))
         results)
    (funcall (llm-tool-function llm-tool)
             (lambda (value) (push value results)))
    (should (= (length results) 1))
    (should (equal (car results)
                   "Tool `broken_async' failed: callback returned 0 values; expected one"))))

(ert-deftest ellm-test-file-edit-reports-elisp-paren-errors ()
  "File edits report Emacs Lisp delimiter errors without noisy success checks."
  (let ((valid-file (make-temp-file "ellm-test-" nil ".el" "(message \"old\")\n"))
        (invalid-file (make-temp-file "ellm-test-" nil ".el" "(message \"old\")\n")))
    (unwind-protect
        (let (valid-result invalid-result)
          (ellm-tools/edit-tool
           (lambda (result) (setq valid-result result))
           valid-file "old" "new")
          (should (equal valid-result
                         (format "Successfully edited file %s" valid-file)))
          (ellm-tools/edit-tool
           (lambda (result) (setq invalid-result result))
           invalid-file "(message \"old\")" "(message \"old\"")
          (should (string-match-p "Post-edit checks reported:" invalid-result))
          (should (string-match-p "Emacs Lisp has an unmatched delimiter"
                                  invalid-result)))
      (delete-file valid-file)
      (delete-file invalid-file))))

(ert-deftest ellm-test-file-edit-elisp-parens-use-elisp-syntax ()
  "Elisp delimiter checks ignore parentheses in strings and comments."
  (let ((file (make-temp-file "ellm-test-" nil ".el"
                              ";; ( unmatched in a comment\n(message \"(\")\n")))
    (unwind-protect
        (let ((result (ellm-test--file-edit file "message" "prin1")))
          (should (equal result (format "Successfully edited file %s" file))))
      (delete-file file))))

(ert-deftest ellm-test-buffer-edit-elisp-check-preserves-major-mode ()
  "Elisp checks must not change a buffer-edit target's major mode."
  (let ((buffer (generate-new-buffer " *ellm test elisp edit*")))
    (unwind-protect
        (with-current-buffer buffer
          (setq-local buffer-file-name "/tmp/ellm-test-buffer-edit.el")
          (insert "(message \"old\")\n")
          (fundamental-mode)
          (should (equal (ellm-test--buffer-edit (buffer-name) "old" "new")
                         (format "Successfully edited buffer %s" (buffer-name))))
          (should (eq major-mode 'fundamental-mode)))
      (kill-buffer buffer))))

(ert-deftest ellm-test-buffer-edit-without-file-skips-file-checkers ()
  "Default file checkers skip an edited buffer with no associated file."
  (let ((buffer (generate-new-buffer " *ellm test unvisited edit*")))
    (unwind-protect
        (with-current-buffer buffer
          (insert "(message \"old\")\n")
          (should (equal (ellm-test--buffer-edit (buffer-name) "old" "new")
                         (format "Successfully edited buffer %s" (buffer-name)))))
      (kill-buffer buffer))))

(ert-deftest ellm-test-file-edit-runs-checkers-after-writing-file ()
  "File checkers receive the edited buffer after its contents reach disk."
  (let ((file (make-temp-file "ellm-test-" nil ".txt" "old\n"))
        (ellm-tools-file-edit-checkers
         (list (lambda (file-path buffer callback)
                 (let ((disk-contents (with-temp-buffer
                                        (insert-file-contents file-path)
                                        (buffer-string))))
                   (funcall callback
                            (unless (and (equal (buffer-string) "new\n")
                                         (equal disk-contents "new\n"))
                              "checker ran before file was written")))))))
    (unwind-protect
        (should (equal (ellm-test--file-edit file "old" "new")
                       (format "Successfully edited file %s" file)))
      (delete-file file))))

(ert-deftest ellm-test-file-edit-reports-json-errors ()
  "File edits report JSON parsing errors without noisy successful checks."
  (let ((valid-file (make-temp-file "ellm-test-" nil ".json" "{\"value\": 1}\n"))
        (invalid-file (make-temp-file "ellm-test-" nil ".json" "{\"value\": 1}\n")))
    (unwind-protect
        (let (valid-result invalid-result)
          (setq valid-result
                (ellm-test--file-edit valid-file "1" "2"))
          (should (equal valid-result
                         (format "Successfully edited file %s" valid-file)))
          (setq invalid-result
                (ellm-test--file-edit invalid-file "1}" "1,}"))
          (should (string-match-p "Post-edit checks reported:" invalid-result))
          (should (string-match-p "JSON is invalid" invalid-result)))
      (delete-file valid-file)
      (delete-file invalid-file))))

(ert-deftest ellm-test-file-edit-shell-checker-is-opt-in-and-asynchronous ()
  "The optional shell checker returns process diagnostics after an edit."
