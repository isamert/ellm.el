                                 :rawOutput (:stale t))))
          (ellm-acp--handle-session-update
           connection '(:update (:sessionUpdate "tool_call_update"
                                 :toolCallId "call_1" :title "Run" :kind "execute"
                                 :status "completed"
                                 :locations [(:path "/tmp/a" :line 2)]
                                 :rawOutput (:ok t)
                                 :content ((:type "diff" :path "/tmp/a"
                                            :oldText "old" :newText "new")))))
          (let ((contents (buffer-string))
