(ert-deftest ellm-test-tools-webfetch-formats-truncation ()
  "Webfetch formatter should expose metadata and truncation."
  (let ((formatted
         (ellm-tools--format-webfetch-result
          '(:ok t :url "https://example.com"
            :final-url "https://example.com/final" :status 200
            :content-type "text/plain" :truncated t :output-truncated t :content "body"))))
    (should (string-match-p "status=200" formatted))
    (should (string-match-p "readable=false" formatted))
    (should (string-match-p "truncated=true" formatted))
