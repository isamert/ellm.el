(ert-deftest ellm-test-tools-file-edit-preserves-unsaved-visiting-buffer ()
  "File editing should change disk without modifying an unsaved buffer."
  (let* ((file (make-temp-file "ellm-edit-"))
         (buf nil))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "old\n"))
          (setq buf (find-file-noselect file))
          (with-current-buffer buf
            (goto-char (point-min))
            (insert "unsaved\n"))
          (with-temp-file file
            (insert "disk-old\n"))
          (should (equal (ellm-test--file-edit file "disk-old" "new" nil)
                         (format "Successfully edited file %s" file)))
          (with-current-buffer buf
            (should (buffer-modified-p))
            (should-not (verify-visited-file-modtime buf))
            (should (equal (buffer-string) "unsaved\nold\n")))
          (with-temp-buffer
            (insert-file-contents file)
            (should (equal (buffer-string) "new\n"))))
      (when (buffer-live-p buf)
        (kill-buffer buf))
      (delete-file file))))

(ert-deftest ellm-test-tools-file-edit-uses-disk-and-refreshes-clean-buffer ()
  "File editing should use disk contents and refresh a clean visiting buffer."
  (let* ((file (make-temp-file "ellm-edit-"))
         (buf nil))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "buffer-old\n"))
          (setq buf (find-file-noselect file))
          (with-temp-file file
            (insert "disk-old\n"))
          (should (equal (ellm-test--file-edit file "disk-old" "new" nil)
                         (format "Successfully edited file %s" file)))
          (with-current-buffer buf
            (should-not (buffer-modified-p))
            (should (equal (buffer-string) "new\n")))
          (with-temp-buffer
            (insert-file-contents file)
            (should (equal (buffer-string) "new\n"))))
      (when (buffer-live-p buf)
        (kill-buffer buf))
      (delete-file file))))

(ert-deftest ellm-test-raw-turn-bodies-disable-markdown-fontification ()
  "Tool/reasoning bodies should not receive Markdown prose faces."
  (let ((ellm-fold-tool-calls nil)
        (ellm-fold-reasoning-blocks nil))
    (with-temp-buffer
      (insert ">-| assistant\n"
              "# Assistant heading\n"
              ">>-| tool-result | Shell :id call_1\n"
              "# Raw tool heading\n"
              "**raw bold** `raw code`\n"
              "```elisp tool\n"
              "(defun raw-tool () nil)\n"
              "```\n"
              ">>-| reasoning\n"
              "# Raw reasoning heading\n"
              "```elisp reasoning\n"
              "(defun raw-reasoning () nil)\n"
              "```\n"
              ">-| user\n"
              "# User heading\n")
      (ellm-mode)
      (font-lock-ensure)
      (should (ellm-test--face-includes-p
               (ellm-test--face-at-text "# Assistant heading")
               'ellm-heading-1))
      (should (ellm-test--face-includes-p
               (ellm-test--face-at-text "# User heading")
               'ellm-heading-1))
      (should-not (ellm-test--face-includes-p
                   (ellm-test--face-at-text "# Raw tool heading")
                   'ellm-heading-1))
      (should-not (ellm-test--face-includes-p
                   (ellm-test--face-at-text "# Raw reasoning heading")
                   'ellm-heading-1))
      (should-not (ellm-test--face-includes-p
                   (ellm-test--face-at-text "**raw bold**")
                   'ellm-bold))
      (should-not (ellm-test--face-includes-p
                    (ellm-test--face-at-text "`raw code`")
                    'ellm-inline-code))
      (dolist (text '("```elisp tool" "```elisp reasoning"))
        (should-not (ellm-test--face-includes-p
                     (ellm-test--face-at-text text)
                     'ellm-code-block-delimiter)))
      (dolist (text '("defun raw-tool" "defun raw-reasoning"))
        (should-not (ellm-test--face-includes-p
                     (ellm-test--face-at-text text)
                     'font-lock-keyword-face)))
      (should-not ellm--fence-positions))))

(ert-deftest ellm-test-markdown-tables-are-fontified-in-prose-only ()
  "Conventional pipe tables should be fontified only in Markdown prose."
