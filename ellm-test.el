        (with-temp-buffer
          (rename-buffer "ellm-log-source" t)
          (let ((driver (ellm-llm--make-driver :buffer (current-buffer))))
            (setq log-buffer (ellm-llm--driver-log-buffer driver))
            (let ((ellm-llm--transport-log-buffer log-buffer))
              (ellm-llm--request-plz-advice
               (lambda (_url &rest args)
                 (setq passed-args args)
                 (funcall (plist-get args :on-success) '(:ok t)))
               "https://example.test/chat?key=secret"
               :headers '(("Authorization" . "Bearer secret")
                          ("X-Test" . "visible"))
               :data '(:message "hello")
               :on-success #'ignore
               :on-error #'ignore)))
          (should (functionp (plist-get passed-args :on-success)))
          (with-current-buffer log-buffer
            (let ((log (buffer-string)))
              (should (string-match-p "ellm-log-source" (buffer-name)))
              (should (string-match-p "<redacted>" log))
              (should (string-match-p "X-Test" log))
              (should (string-match-p ":ok" log))
              (should-not (string-match-p "Bearer secret" log))
              (should-not (string-match-p "key=secret" log)))))
      (when (buffer-live-p log-buffer)
        (kill-buffer log-buffer)))))

(ert-deftest ellm-test-llm-restores-claude-tool-result-as-user-message ()
