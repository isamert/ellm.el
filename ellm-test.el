          "        print(json.dumps({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':'saved','update':{'sessionUpdate':'agent_message_chunk','messageId':'a1','content':{'type':'text','text':'old answer'}}}}), flush=True)\n"
