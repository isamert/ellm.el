(ert-deftest ellm-test-acp-terminal-tool-observation-uses-call-title ()
  "ACP terminal updates retain the invocation title when updates omit it."
  (let (events)
    (with-temp-buffer
      (ellm-mode)
      (let* ((connection (ellm-acp-connection :name "test" :buffer (current-buffer)))
             (request (ellm-acp--make-request
                       :connection connection :cancelled nil
                       :emit (lambda (event) (push event events))))
             (call '(:toolCallId "call_1" :title "Shell" :rawInput (:command "pwd"))))
        (setf (ellm-acp--connection-current-request connection) request)
        (ellm-acp--insert-tool-call call connection)
        (ellm-acp--handle-session-update
         connection
         '(:update (:sessionUpdate "tool_call_update" :toolCallId "call_1"
                    :status "in_progress")))
        (should-not (plist-get (car events) :observations))
        (ellm-acp--handle-session-update
         connection
         '(:update (:sessionUpdate "tool_call_update" :toolCallId "call_1"
                    :status "completed" :rawOutput "ok")))
        (let* ((event (car events))
               (observation (car (plist-get event :observations))))
          (should (eq (plist-get observation :type) 'tool-finished))
          (should (eq (plist-get observation :outcome) 'completed))
          (should (equal (plist-get observation :name) "Shell")))
        (ellm-acp--handle-session-update
         connection
         '(:update (:sessionUpdate "tool_call_update" :toolCallId "call_1"
                    :status "failed" :rawOutput "bad")))
        (should (eq (plist-get (car (plist-get (car events) :observations))
                               :outcome)
                    'failed))))))

