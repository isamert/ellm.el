(ert-deftest ellm-test-folded-turn-unfold-leaves-no-ellipsis-overlay ()
  "Opening folded turns should not leave a trailing outline ellipsis overlay."
  (dolist (load-time '(nil t))
    (with-temp-buffer
      (if load-time
          (progn
            (insert ">-| assistant\n"
                    ">>-| reasoning :message-id msg\n"
                    "The user wants text.\n"
                    ">-| user\n")
            (ellm-mode))
        (ellm-mode)
        (ellm--insert-turn "assistant")
        (ellm--insert-turn "reasoning" :continuation t :message-id "msg")
        (insert "The user wants text.\n")
        (ellm--insert-turn "user"))
      (goto-char (point-min))
      (search-forward "reasoning")
      (beginning-of-line)
      (let ((fold-overlays
             (cl-remove-if-not
              (lambda (ov) (eq (overlay-get ov 'invisible) 'outline))
              (overlays-in (point-min) (point-max)))))
        (should fold-overlays))
      (let ((inhibit-message t))
        (outline-cycle))
      (should-not (cl-some (lambda (ov)
                             (eq (overlay-get ov 'invisible) 'outline))
                            (overlays-in (point-min) (point-max))))
      (let ((inhibit-message t))
        (outline-cycle))
      (let ((fold-overlays
             (cl-remove-if-not
              (lambda (ov) (eq (overlay-get ov 'invisible) 'outline))
              (overlays-in (point-min) (point-max)))))
        (should fold-overlays)))))

(ert-deftest ellm-test-continuation-assistant-shown-during-heading-cycle ()
  "TAB on a parent heading should reveal blank assistant continuations."
  (with-temp-buffer
    (let ((ellm-fold-tool-calls nil))
      (insert ">-| assistant\n"
              "Initial answer.\n"
              ">>-| tool-call | Shell\n"
              "pwd\n"
              ">>-| assistant\n"
              "The result is here.\n")
      (ellm-mode))
    (goto-char (point-min))
    (should (eq (key-binding (kbd "TAB")) 'ellm-outline-cycle))
    (re-search-forward "^>>-| tool-call")
    (beginning-of-line)
    (let ((tool-level (ellm--outline-level-at-point)))
      (re-search-forward "^>>-| assistant")
      (beginning-of-line)
      (should (= (ellm--outline-level-at-point) tool-level)))
    (goto-char (point-min))
    (let ((inhibit-message t))
      (ellm-outline-cycle)
      (ellm-outline-cycle))
    (should (ellm-test--invisible-at-text "pwd"))
    (should-not (ellm-test--invisible-at-text "The result is here."))))

(ert-deftest ellm-test-tab-cycles-markdown-headings ()
