      (should (string-match-p "done" (buffer-string)))
      (should (equal (ellm-turn-role (car (last (ellm--parse-turns))))
                      "user")))))

(ert-deftest ellm-test-send-stamps-user-and-completed-assistant-turns ()
  "A request should timestamp submission and completion exactly once."
  (let* ((started-at (seconds-to-time 1000000000))
         (finished-at (time-add started-at (seconds-to-time 222)))
         (times (list started-at finished-at))
         (ellm-provider (make-ellm-test-sync-provider)))
    (with-temp-buffer
      (ellm-mode)
      (ellm--insert-turn "user" :ts "stale")
      (insert "hi\n")
      (cl-letf (((symbol-function 'ellm--now)
                 (lambda () (pop times))))
        (ellm-send))
      (pcase-let ((`(,user ,assistant ,next-user) (ellm--parse-turns)))
        (should (equal (ellm-turn-role user) "user"))
        (should (equal (alist-get "ts" (ellm-turn-attrs user)
                                  nil nil #'equal)
                       (ellm--timestamp started-at)))
        (should (= 1 (cl-count "ts" (ellm-turn-attrs user)
                               :key #'car :test #'equal)))
        (should (equal (ellm-turn-role assistant) "assistant"))
        (should (= (ellm-turn-depth assistant) 1))
        (should (equal (alist-get "ts" (ellm-turn-attrs assistant)
                                  nil nil #'equal)
                       (ellm--timestamp finished-at)))
        (should (equal (alist-get "took" (ellm-turn-attrs assistant)
                                  nil nil #'equal)
                       "3m42s"))
        (should (equal (ellm-turn-role next-user) "user"))
        (should-not (alist-get "ts" (ellm-turn-attrs next-user)
                               nil nil #'equal)))
      (should-not times))))

(ert-deftest ellm-test-send-makes-buffer-read-only-while-request-active ()
