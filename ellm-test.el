(ert-deftest ellm-test-kagi-stream-filter-parses-fragmented-sse ()
  "Kagi's stream filter should skip headers and join fragmented SSE records."
  (let ((request (ellm-kagi--make-request))
        events)
    (cl-letf (((symbol-function 'ellm-kagi--insert-process-output) #'ignore)
              ((symbol-function 'ellm-kagi--handle-event)
               (lambda (_request event) (push event events))))
      (ellm-kagi--stream-filter
       request nil
       (string-as-unibyte
        (concat "HTTP/1.1 200 OK\r\n"
                "content-type: text/event-stream; charset=utf-8\r\n\r\n"
                "id: 1\ndata: {\"text\":\"Hel")))
      (should-not events)
      (ellm-kagi--stream-filter
       request nil
       (string-as-unibyte "lo\",\"is_final\":false}\n\n"))
      (should (equal (plist-get (car events) :text) "Hello"))
      (should (eq (plist-get (car events) :is_final) :json-false)))))

(ert-deftest ellm-test-kagi-request-json-routes-parse-errors ()
  "Malformed successful responses should reach the Kagi error callback."
  (let ((provider (ellm-make-kagi-provider
                   :session-token "secret"
                   :model "model-1"))
        success failure)
    (cl-letf (((symbol-function 'plz)
               (lambda (_method _url &rest args)
                 (should (eq (plist-get args :as) 'string))
                 (funcall (plist-get args :then) "not JSON")
                 'mock-process)))
      (ellm-kagi--request-json
       provider 'post "/api/test" '(:ok t)
       (lambda (value) (setq success value))
       (lambda (error) (setq failure error))))
    (should-not success)
    (should (plz-error-p failure))
    (should (string-match-p "invalid JSON response"
                            (plz-error-message failure)))))

(ert-deftest ellm-test-kagi-json-surfaces-transient-errors-to-core ()
  "Kagi JSON transport should surface transient errors without retrying."
  (let ((provider (ellm-make-kagi-provider
                   :session-token "secret" :model "model-1"))
        (calls 0)
        failure)
    (cl-letf (((symbol-function 'plz)
               (lambda (_method _url &rest args)
                 (cl-incf calls)
                 (funcall
                  (plist-get args :else)
                  (make-plz-error
                   :curl-error '(28 . "request timed out")))
                 'process)))
      (ellm-kagi--request-json
       provider 'post "/api/test" nil
       (lambda (_value) (ert-fail "Unexpected Kagi success"))
       (lambda (error) (setq failure error))))
    (should (= calls 1))
    (should (ellm-kagi--transient-error-p failure))))

(ert-deftest ellm-test-kagi-stream-errors-are-terminal ()
