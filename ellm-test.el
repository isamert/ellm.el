(ert-deftest ellm-test-acp-backend-combined-messages-smoke ()
  "The ACP backend should handle multiple messages in one stdio chunk."
  (let ((agent-file (make-temp-file "ellm-fake-acp-combined-" nil ".py")))
    (unwind-protect
        (progn
          (with-temp-file agent-file
            (insert "import json, sys\n"
                    "session_id = 'sess_test'\n"
                    "for line in sys.stdin:\n"
                    "    msg = json.loads(line)\n"
                    "    mid = msg.get('id')\n"
                    "    method = msg.get('method')\n"
                    "    if method == 'initialize':\n"
                    "        print(json.dumps({'jsonrpc':'2.0','id':mid,'result':{'protocolVersion':1,'agentCapabilities':{}}}), flush=True)\n"
                    "    elif method == 'session/new':\n"
                    "        print(json.dumps({'jsonrpc':'2.0','id':mid,'result':{'sessionId':session_id}}), flush=True)\n"
                    "    elif method == 'session/prompt':\n"
                    "        update = {'jsonrpc':'2.0','method':'session/update','params':{'sessionId':session_id,'update':{'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':'combined'}}}}\n"
                    "        response = {'jsonrpc':'2.0','id':mid,'result':{'stopReason':'end_turn'}}\n"
                    "        sys.stdout.write(json.dumps(update) + '\\n' + json.dumps(response) + '\\n')\n"
                    "        sys.stdout.flush()\n"))
          (let ((ellm-provider (ellm-make-acp-provider
                                :command "python3"
                                :args (list agent-file))))
            (with-temp-buffer
              (ellm-mode)
               (ellm--insert-turn "user")
               (insert "hi\n")
               (ellm-send)
               (ellm-test--wait-for-request)
               (when ellm-acp--connection
                 (delete-process (ellm-acp--connection-process ellm-acp--connection)))
              (should (string-match-p "combined" (buffer-string))))))
      (delete-file agent-file))))

(ert-deftest ellm-test-acp-streaming-preserves-or-follows-point ()
  "ACP streaming should preserve review point and follow the live end."
  (let ((connection (ellm-acp-connection
                     :name "test"
                     :process (start-process "ellm-acp-test-sleep" nil "sleep" "10")
                     :buffer (current-buffer))))
    (unwind-protect
        (with-temp-buffer
          (insert "intro\n")
          (ellm-mode)
          (setf (ellm-acp--connection-buffer connection) (current-buffer))
          (goto-char (point-min))
          (setq buffer-read-only t)
          (ellm-acp--handle-session-update
           connection '(:update (:sessionUpdate "agent_message_chunk"
                                 :content (:type "text" :text "hello"))))
           (should (= (point) (point-min)))
           (should buffer-read-only)
           (should (string-match-p "hello" (buffer-string)))
           (goto-char (point-max))
           (ellm-acp--handle-session-update
            connection '(:update (:sessionUpdate "agent_message_chunk"
                                  :content (:type "text" :text " world"))))
           (should (= (point) (point-max)))
           (should (string-match-p "hello world" (buffer-string))))
       (when (jsonrpc-running-p connection)
         (jsonrpc-shutdown connection)))))

(ert-deftest ellm-test-acp-streaming-content-does-not-parse-buffer ()
  "ACP content chunks should not parse all turns to inspect the final turn."
  (let ((connection (ellm-acp-connection
                     :name "test"
                     :process (start-process "ellm-acp-test-sleep" nil "sleep" "10")
                     :buffer (current-buffer))))
    (unwind-protect
        (with-temp-buffer
          (ellm-mode)
          (setf (ellm-acp--connection-buffer connection) (current-buffer))
          (cl-letf (((symbol-function 'ellm--parse-turns)
                     (lambda () (error "unexpected parse"))))
            (ellm-acp--handle-session-update
             connection '(:update (:sessionUpdate "agent_message_chunk"
                                   :messageId "a1"
                                   :content (:type "text" :text "one"))))
            (ellm-acp--handle-session-update
             connection '(:update (:sessionUpdate "agent_message_chunk"
                                   :messageId "a1"
                                   :content (:type "text" :text " more"))))
            (ellm-acp--handle-session-update
             connection '(:update (:sessionUpdate "agent_message_chunk"
                                   :messageId "a2"
                                   :content (:type "text" :text "two"))))
            ;; Session loading may leave an empty turn without in-memory
            ;; message state; recover it without reparsing the conversation.
            (ellm--insert-turn "assistant" :continuation t :message-id "a3")
            (setf (ellm-acp--connection-last-message-key connection) nil)
            (ellm-acp--handle-session-update
             connection '(:update (:sessionUpdate "agent_message_chunk"
                                   :messageId "a3"
                                   :content (:type "text" :text "recovered")))))
          (let ((turns (ellm--parse-turns)))
            (should (equal (mapcar #'ellm-turn-role turns)
                           '("assistant" "assistant" "assistant")))
            (should (equal (mapcar #'ellm-turn-content turns)
                           '("one more" "two" "recovered")))))
      (when (jsonrpc-running-p connection)
        (jsonrpc-shutdown connection)))))

(ert-deftest ellm-test-acp-wire-log-is-per-connection ()
  "ACP wire logs should be separated per ellm buffer/connection."
  (let ((agent-file (ellm-test--make-fake-acp-agent))
        (ellm-acp-log-messages t)
        buffers log-buffers)
    (unwind-protect
        (dotimes (_ 2)
          (let ((ellm-provider (ellm-make-acp-provider
                                :command "python3"
                                :args (list agent-file)))
                (buf (generate-new-buffer " *ellm-acp-test*")))
            (push buf buffers)
            (with-current-buffer buf
              (ellm-mode)
              (ellm--insert-turn "user")
              (insert "hi\n")
              (ellm-send)
              (ellm-test--wait-for-request)
              (push (ellm-acp--connection-log-buffer ellm-acp--connection)
                    log-buffers)
              (delete-process (ellm-acp--connection-process ellm-acp--connection)))))
      (dolist (buf buffers)
        (when (buffer-live-p buf)
          (kill-buffer buf)))
      (delete-file agent-file))
    (should (= 2 (length (delete-dups log-buffers))))
    (dolist (log-buffer log-buffers)
      (unwind-protect
          (with-current-buffer log-buffer
            (should (string-match-p "-->" (buffer-string)))
            (should (string-match-p "<--" (buffer-string))))
        (when (buffer-live-p log-buffer)
          (kill-buffer log-buffer))))))

(ert-deftest ellm-test-acp-backend-reuses-frontmatter-session-id ()
  "The ACP backend should continue a saved frontmatter session id."
  (let ((agent-file (make-temp-file "ellm-fake-acp-reuse-" nil ".py")))
    (unwind-protect
        (progn
          (with-temp-file agent-file
            (insert "import json, sys\n"
                    "for line in sys.stdin:\n"
                    "    msg = json.loads(line)\n"
                    "    mid = msg.get('id')\n"
                    "    method = msg.get('method')\n"
                    "    if method == 'initialize':\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'protocolVersion':1,'agentCapabilities':{'sessionCapabilities':{'resume':{}}}}}\n"
                    "    elif method == 'session/new':\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'error':{'code':-32000,'message':'session/new should not be called'}}\n"
                    "    elif method == 'session/resume':\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{}}\n"
                    "    elif method == 'session/prompt':\n"
                    "        sid = msg['params']['sessionId']\n"
                    "        print(json.dumps({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':sid,'update':{'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':'continued: ' + sid}}}}), flush=True)\n"
                    "        out = {'jsonrpc':'2.0','id':mid,'result':{'stopReason':'end_turn'}}\n"
                    "    print(json.dumps(out), flush=True)\n"))
          (let ((ellm-provider (ellm-make-acp-provider
                                :command "python3"
                                :args (list agent-file))))
            (with-temp-buffer
              (insert "---\nacp:\n  session-id: saved_sess\n---\n\n")
              (ellm-mode)
              (ellm--insert-turn "user")
              (insert "hi\n")
              (ellm-send)
              (ellm-test--wait-for-request)
              (when ellm-acp--connection
                (delete-process (ellm-acp--connection-process ellm-acp--connection)))
              (let ((contents (buffer-string)))
                (should (string-match-p "continued: saved_sess" contents))
                (should-not (string-match-p "session/new should not be called" contents))))))
      (delete-file agent-file))))

