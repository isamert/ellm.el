  (let ((connection (ellm-acp-connection
                     :name "test"
                     :process (start-process "ellm-acp-test-sleep" nil "sleep" "10")
                     :buffer (current-buffer)))
        mapped)
    (unwind-protect
        (progn
          (ellm-acp-extension-state-put connection 'one "key" 1)
          (ellm-acp-extension-state-put connection 'two "key" 2)
          (should (= (ellm-acp-extension-state-get connection 'one "key") 1))
          (should (= (ellm-acp-extension-state-get connection 'two "key") 2))
          (ellm-acp-extension-state-map
           connection 'one
           (lambda (key value) (push (cons key value) mapped)))
          (should (equal mapped '(("key" . 1))))
          (ellm-acp-extension-state-remove connection 'one "key")
          (should-not (ellm-acp-extension-state-get connection 'one "key"))
          (ellm-acp-extension-state-clear connection)
          (should-not (ellm-acp-extension-state-get connection 'two "key")))
      (when (jsonrpc-running-p connection)
        (jsonrpc-shutdown connection)))))

