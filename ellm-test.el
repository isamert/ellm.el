    (should (ellm-test--invisible-at-text "test test"))
    (should-not (ellm-test--invisible-at-text "</anothertag>"))
    (goto-char (point-min))
    (search-forward "</anothertag>")
    (should-not (invisible-p (1- (line-beginning-position))))
    (should-not (ellm-test--invisible-at-text "child body"))))

(ert-deftest ellm-test-continuation-assistant-can-cycle-itself ()
