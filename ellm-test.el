(ert-deftest ellm-test-persistence-restores-subagent-history ()
  "Reopening a persisted main file should restore and lazily open subagents."
  (let* ((root (make-temp-file "ellm-persistence-subagent-" t))
         (provider (make-ellm-test-sync-provider))
         (ellm-provider-alist `((test . (:provider ,provider :models ("m")))))
         (ellm-persistence-enabled t)
         (ellm-persistence-location 'global)
         (ellm-persistence-directory root)
         parent child reopened reopened-child parent-file child-file)
    (unwind-protect
        (progn
          (setq parent (ellm-new-buffer))
          (with-current-buffer parent
            (ellm-tools--launch-subagent "Persist child." nil "worker" nil)
            (setq parent-file buffer-file-name
                  child (get-buffer
                         (plist-get (car ellm-subagent-history) :buffer-name))
                  child-file (plist-get (car ellm-subagent-history) :file)))
          (should (file-exists-p child-file))
          (should (file-in-directory-p
                   child-file (expand-file-name "subagents/"
                                                (file-name-directory parent-file))))
          (with-current-buffer child
            (should (equal (ellm--frontmatter-value 'profile) "agent"))
            (should-not (alist-get 'system (ellm--parse-frontmatter))))
          (kill-buffer child)
          (setq child nil)
          (kill-buffer parent)
          (setq parent nil
                reopened (find-file-noselect parent-file))
          (with-current-buffer reopened
            (should (= (length ellm-subagent-history) 1))
            (should (equal (plist-get (car ellm-subagent-history) :id)
                           "subagent_1"))
            (should (equal (plist-get (car ellm-subagent-history) :file)
                           child-file))
            (setq reopened-child
                  (plist-get (ellm-tools--subagent-target "subagent_1")
                             :buffer)))
          (should (buffer-live-p reopened-child)))
      (dolist (buffer (list reopened-child reopened child parent))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest ellm-test-persistence-opening-session-does-not-checkpoint ()
  "Opening an existing persisted session should not rewrite it."
  (let* ((directory (make-temp-file "ellm-persisted-open-" t))
         (file (expand-file-name "main.ellm" directory))
         buffer (checkpoints 0))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "---\nellm:\n  session-id: session-1\n  role: main\n---\n"))
          (cl-letf (((symbol-function 'ellm--persistence-checkpoint)
                     (lambda (&rest _) (cl-incf checkpoints))))
            (setq buffer (find-file-noselect file)))
          (with-current-buffer buffer
            (should (equal ellm--session-directory
                           (file-name-as-directory directory))))
          (should (= checkpoints 0)))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer
          (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (delete-directory directory t))))

(cl-defstruct ellm-test-tool-provider)

(defvar ellm-test--tool-uses nil
  "Tool uses captured by `ellm-test-tool-provider'.")

(cl-defmethod llm-provider-populate-tool-uses
  ((_provider ellm-test-tool-provider) _prompt tool-uses)
  "Capture TOOL-USES for prompt reconstruction tests."
  (setq ellm-test--tool-uses tool-uses))

(cl-defmethod llm-provider-append-to-prompt
  ((_provider ellm-test-tool-provider) prompt result
   &optional tool-results multi-turn)
  "Use standard prompt reconstruction for the test provider."
  (llm-provider-utils-append-to-prompt
   prompt result tool-results multi-turn))

(ert-deftest ellm-test-llm-replays-canonical-typed-tool-history ()
  "Reconstructed tool history should retain canonical text and JSON types."
  (let* ((ellm-test--tool-uses nil)
         (tool
          (llm-make-tool
           :name "typed"
           :description "Typed test tool."
           :args
           (list (list :name "text" :type 'string)
                 (list :name "count" :type 'integer)
                 (list :name "enabled" :type 'boolean)
                 (list :name "items" :type 'array)
                 (list :name "options" :type 'object)
                 (list :name "empty" :type 'object))
           :function #'ignore))
         (prompt (make-llm-chat-prompt :tools (list tool))))
    (with-temp-buffer
      (insert
       ">>-| tool-call | typed :id call_typed\n"
       ">>>-| tool-param | text\n  padded text  \n"
       ">>>-| tool-param | count\n3\n"
       ">>>-| tool-param | enabled\nfalse\n"
       ">>>-| tool-param | items\n[1,\"two\"]\n"
       ">>>-| tool-param | options\n{\"value\":4}\n"
       ">>>-| tool-param | empty\nnull\n")
      (ellm-llm--apply-turns-to-prompt
       (make-ellm-test-tool-provider) (ellm--parse-turns) prompt)
      (should
       (equal
        (llm-provider-utils-tool-use-args (car ellm-test--tool-uses))
        '((text . "padded text")
          (count . 3)
          (enabled . :false)
          (items . [1 "two"])
          (options (value . 4))
          (empty)))))))


