(defun ellm-test--apply-frontmatter-model-completion (text candidate)
  "Return TEXT after applying CANDIDATE at the `|' marker."
  (let ((ellm-provider-alist
         '((fake . (:models ("openai/gpt-5.4" "openai/gpt-5.5"))))))
    (with-temp-buffer
      (insert text)
      (goto-char (point-min))
      (search-forward "|")
      (delete-char -1)
      (ellm-mode)
      (let ((capf (ellm--frontmatter-capf)))
        (should capf)
        (should (member candidate (nth 2 capf)))
        (delete-region (nth 0 capf) (nth 1 capf))
        (goto-char (nth 0 capf))
        (insert candidate)
        (buffer-string)))))

