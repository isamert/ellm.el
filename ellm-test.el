(ert-deftest ellm-test-comment-adds-to-active-next-prompt-draft ()
  (let ((target (generate-new-buffer " *ellm draft target*")))
    (unwind-protect
        (with-temp-buffer
          (let ((source (current-buffer)))
            (setq default-directory temporary-file-directory)
            (emacs-lisp-mode)
            (insert "(+ 1 2)")
            (with-current-buffer target
              (ellm-mode)
              (ellm--insert-turn "user")
              (insert "Initial prompt\n")
              (ellm--insert-turn "assistant")
              (insert "Reply\n")
              (ellm--set-active-request
               (ellm--make-request :buffer target :state 'streaming)))
            (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Explain this"))
                      ((symbol-function 'ellm--select-or-create-project-buffer)
                       (lambda (&rest _) target)))
              (ellm-comment))
            (should (eq (current-buffer) source))
            (with-current-buffer target
              (should (equal (ellm--composer-text)
                             "``` emacs-lisp\n(+ 1 2)\n```\nExplain this\n")))))
      (when (buffer-live-p target)
        (with-current-buffer target
          (when-let* ((composer ellm--composer-buffer)
                      ((buffer-live-p composer)))
            (kill-buffer composer)))
        (kill-buffer target)))))

(ert-deftest ellm-test-next-prompt-draft-commits-at-request-end ()
  (with-temp-buffer
    (ellm-mode)
    (ellm--insert-turn "user")
    (insert "Initial prompt\n")
    (ellm--insert-turn "assistant")
    (insert "Reply\n")
    (let ((request (ellm--make-request :buffer (current-buffer) :state 'streaming)))
      (ellm--set-active-request request)
      (ellm--append-to-next-prompt (current-buffer) "Follow-up\n")
      (ellm--request-terminal-transition request 'completed)
      (should (null ellm--composer-buffer))
      (should (equal (ellm-turn-role (car (last (ellm--parse-turns)))) "user"))
      (should (string-suffix-p "Follow-up\n" (buffer-string))))))

