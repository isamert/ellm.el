          (connection (ellm-acp-connection
                       :name "test" :process nil :buffer (current-buffer))))
      (ellm-acp--handle-session-update
       connection '(:update (:sessionUpdate "tool_call"
                              :toolCallId "call_1"
                              :title "shell")))
      ;; Establish an initially empty result which a later update fills.
      (ellm-acp--handle-session-update
       connection '(:update (:sessionUpdate "tool_call_update"
                              :toolCallId "call_1"
                              :title "shell"
                              :status "in_progress")))
      (ellm-acp--handle-session-update
       connection
       `(:update (:sessionUpdate "tool_call_update"
                  :toolCallId "call_1"
                  :title "shell"
                  :status "in_progress"
                  :rawInput (:command "ASYNC-COMMAND")
                  :content ((:type "content"
                             :content (:type "text"
                                       :text ,(concat
                                               "ASYNC-RESULT-BEGIN\n"
                                               (make-string 10000 ?x)
                                               "\nASYNC-RESULT-END")))))))
      (should (ellm-test--invisible-at-text "ASYNC-COMMAND"))
      (should (ellm-test--invisible-at-text "ASYNC-RESULT-BEGIN"))
      (should (ellm-test--invisible-at-text "ASYNC-RESULT-END"))
      (ellm-acp--handle-session-update
       connection '(:update (:sessionUpdate "tool_call_update"
                              :toolCallId "call_1"
                              :title "shell"
                              :status "in_progress"
                              :content ((:type "content"
                                         :content (:type "text"
                                                   :text "ASYNC-SECOND"))))))
      (should (ellm-test--invisible-at-text "ASYNC-SECOND"))
      (goto-char (point-min))
      (re-search-forward "^>>-| tool-result")
      (beginning-of-line)
      (outline-show-subtree)
      (should-not (ellm-test--invisible-at-text "ASYNC-SECOND"))
      (ellm-acp--handle-session-update
       connection '(:update (:sessionUpdate "tool_call_update"
                              :toolCallId "call_1"
                              :title "shell"
                              :status "completed"
                              :content ((:type "content"
                                         :content (:type "text"
                                                   :text "MANUALLY-OPEN"))))))
      (should-not (ellm-test--invisible-at-text "MANUALLY-OPEN")))))

